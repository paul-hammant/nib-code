        spec.it("same Run foreground and background reuse keep invocation results separate from the latest row") callback {
            flags = [0, 1]
            for fi in 0..2 {
                for si in 0..2 {
                    first_bg = flags[fi]
                    second_bg = flags[si]
                    t = transcript.new()
                    transcript.start_run(t, "reuse a1")
                    transcript.progress(t, agent_tree.new_agent("a1", "first", invocation: 1, run: 1, background: first_bg, `state`: agent_tree.PS_DONE, step: 8))
                    transcript.progress(t, agent_tree.new_agent("a1", "second", invocation: 2, run: 1, background: second_bg, step: 1))
                    if first_bg == 1 { transcript.background_result(t, BK_AGENT, "a1", false, "{}") }
                    e = e_(t, 0)
                    spec.assert_eq(e.invocations.len, 2, "two invocations")
                    spec.assert_eq(e.agents.len, 1, "one row")
                    spec.assert_eq(agent_(e, 0).`state`, agent_tree.PS_WORKING, "working")
                    spec.assert_eq(agent_(e, 0).background, second_bg, "second background")
                    transcript.progress(t, agent_tree.new_agent("a1", "late first", invocation: 1, run: 1, background: first_bg, `state`: agent_tree.PS_FAILED, step: 9))
                    streq(agent_(e, 0).prompt, "second")
                    if second_bg == 1 { transcript.background_result(t, BK_AGENT, "a1", true, "{}") }
                    transcript.progress(t, agent_tree.new_agent("a1", "second", invocation: 2, run: 1, background: second_bg, `state`: agent_tree.PS_DONE, step: 2))
                    streq(row_(e, 0), "  └─ a1 second · completed · step 2")
                    spec.assert_eq(agent_(e, 0).background, 0, "settled")
                }
            }
        }
        spec.it("same Run background results consume a FIFO with sticky per invocation success and failure") callback {
            oks = [0, 1]
            for fi in 0..2 {
                for ri in 0..2 {
                    first_ok = oks[fi]
                    result_first = oks[ri]
                    second_ok = 1 - first_ok
                    t = transcript.new()
                    transcript.start_run(t, "two background calls")
                    if result_first == 1 {
                        transcript.background_result(t, BK_AGENT, "a1", first_ok == 1, "{}")
                        transcript.background_result(t, BK_AGENT, "a1", second_ok == 1, "{}")
                    }
                    transcript.progress(t, agent_tree.new_agent("a1", "first", invocation: 11, run: 1, background: 1, `state`: agent_tree.PS_DONE))
                    transcript.progress(t, agent_tree.new_agent("a1", "second", invocation: 12, run: 1, background: 1, `state`: agent_tree.PS_DONE))
                    if result_first == 0 {
                        transcript.background_result(t, BK_AGENT, "a1", first_ok == 1, "{}")
                        spec.assert_eq(agent_(e_(t, 0), 0).background, 1, "still pending")
                        transcript.background_result(t, BK_AGENT, "a1", second_ok == 1, "{}")
                    }
                    inv0 = e_(t, 0).invocations[0] as *entry.Invocation
                    inv1 = e_(t, 0).invocations[1] as *entry.Invocation
                    spec.assert_eq(inv0.result, first_ok, "first result")
                    spec.assert_eq(inv1.result, second_ok, "second result")
                    transcript.progress(t, agent_tree.new_agent("a1", "late first", invocation: 11, run: 1, background: 1, `state`: agent_tree.PS_DONE, step: 99))
                    transcript.progress(t, agent_tree.new_agent("a1", "second", invocation: 12, run: 1, background: 1, `state`: agent_tree.PS_DONE, step: 3))
                    row = agent_(e_(t, 0), 0)
                    spec.assert_eq(row.invocation, 12, "invocation")
                    spec.assert_eq(row.step, 3, "step")
                    want = agent_tree.PS_DONE
                    if first_ok == 1 { want = agent_tree.PS_FAILED }
                    spec.assert_eq(row.`state`, want, "state")
                    spec.assert_eq(row.background, 0, "settled")
                    spec.assert_eq(t.pending_results.len, 0, "no pending")
                }
            }
        }
        spec.it("two coalesced background invocations in one drain register before ID only results settle") callback {
            t = transcript.new()
            transcript.start_run(t, "background then resume in one Run")
            q = progress.new()
            progress.set_sink(q, t as ptr, |ctx: ptr, json: string| {
                tt = ctx as *transcript.Transcript
                transcript.progress(tt, agent_tree.from_json(json))
            })
            id = progress.add(q, "agent", "first", 1, 1)
            first = progress.current_invocation(q, id)
            u1 = progress.new_value(id, "agent", "first", 1)
            p1 = u1 as *progress.Progress
            p1.invocation = first
            p1.background = 1
            p1.state = "done"
            progress.update(q, u1)
            r = progress.new_value(id, "agent", "second", 1)
            p2 = r as *progress.Progress
            p2.background = 1
            p2.state = "queued"
            progress.restart(q, r)
            second = progress.current_invocation(q, id)
            u2 = progress.new_value(id, "agent", "second", 1)
            p3 = u2 as *progress.Progress
            p3.invocation = second
            p3.background = 1
            p3.state = "failed"
            progress.update(q, u2)
            transcript.background_result(t, BK_AGENT, id, true, "{}")
            progress.drain(q)
            e = e_(t, 0)
            spec.assert_eq(e.invocations.len, 2, "two invocations")
            inv0 = e.invocations[0] as *entry.Invocation
            inv1 = e.invocations[1] as *entry.Invocation
            spec.assert_eq(inv0.result, 1, "first delivered ok")
            spec.assert_eq(inv1.result, -1, "second pending")
            spec.assert_eq(agent_(e, 0).background, 1, "row still background")
            transcript.background_result(t, BK_AGENT, id, false, "{}")
            streq(row_(e, 0), "  └─ a1 second · failed · step 0")
            spec.assert_eq(agent_(e, 0).background, 0, "settled")
        }
        spec.it("automatic Run and its agent have a mixed task label") callback {
            t = transcript.new()
            transcript.start_run(t, "await tools.agent({prompt:'task'})")
            transcript.progress(t, agent_tree.new_agent("a1", "task", kind: BK_AGENT))
            transcript.progress(t, agent_tree.new_agent("r1", "Run", kind: BK_RUN, background: 1))
            streq(e_(t, 0).label, "Run · running")
        }
        spec.it("background Run notifications and superseded bash stay neutral live and restored") callback {
            t = transcript.new()
            transcript.start_run(t, "await tools.bash({command:'check'})")
            transcript.progress(t, agent_tree.new_agent("b1", "check", run: 1, kind: BK_BASH, background: 1))
            transcript.background_run(t, "r3")
            transcript.end_run(t, true, "registered", 10000, none_())
            streq(seg_text_(e_(t, 0), 0), "  ")
            streq(e_(t, 0).label, "Run · r3 running · b1 running")
            transcript.background_result(t, BK_BASH, "b1", true, "{\"superseded_by\":\"b2\"}")
            streq(e_(t, 1).label, "b1 superseded by b2")
            streq(seg_text_(e_(t, 1), 0), "  ")
            spec.assert_true(string.ends_with(row_(e_(t, 0), 0), "superseded by b2") != 0, "row superseded")
            transcript.background_result(t, BK_RUN, "r3", false, "late error")
            spec.assert_eq(transcript.count(t), 2, "no new block")
            streq(e_(t, 0).output, "late error")
            transcript.clear(t)
            h = msgs_()
            push_(h, asst_calls_(call_("call", "check"), ""))
            push_(h, tool_msg_("call", "registered", ",\"bash_replacements\":[{\"id\":\"b1\",\"run\":1,\"state\":\"superseded\",\"superseded_by\":\"b2\"}],\"background_id\":\"r3\""))
            push_(h, bg_msg_("[background run r3 finished]\nlate error", "run", "r3", "false"))
            transcript.add_history(t, h)
            streq(e_(t, 0).label, "Run · r3 failed")
            streq(seg_text_(e_(t, 0), 0), "✗ ")
            spec.assert_true(string.ends_with(row_(e_(t, 0), 0), "superseded by b2") != 0, "restored row superseded")
            spec.assert_eq(transcript.count(t), 1, "one entry")
            streq(e_(t, 0).output, "late error")
        }
        spec.it("elapsed heartbeats do not count as task progress and active tools show commands") callback {
            t = transcript.new()
            transcript.start_run(t, "await tools.bash({})")
            p = agent_tree.new_agent("b1", "zig build test", run: 1, kind: BK_BASH, background: 1, elapsed_ms: 3000)
            transcript.progress(t, p)
            p.elapsed_ms = 9000
            spec.assert_false(transcript.progress_changed(t, p), "heartbeat")
            p.output_bytes = 10
            spec.assert_true(transcript.progress_changed(t, p), "output changed")
            p.background = 0
            transcript.progress(t, p)
            streq(transcript.activity_detail(t, "bash"), "bash zig build test")
        }
        spec.it("Run facts name changed files and retain warning without changing script success") callback {
            t = transcript.new()
            transcript.start_run(t, "ignored source")
            transcript.progress(t, agent_tree.new_agent("a1", "verify", `state`: agent_tree.PS_TIMED_OUT))
            s = tool_summary.empty()
            names = ["read", "write", "edit", "bash"]
            counts = [3, 1, 1, 1]
            for i in 0..4 {
                c = heap.new(tool_summary.Count)
                c.name = names[i]
                c.count = counts[i]
                list.list_add(s.counts, c as ptr)
            }
            f = heap.new(tool_summary.File)
            f.tool = "read"
            f.path = "a.zig"
            f.duration_ms = -1
            list.list_add(s.files, f as ptr)
            ct = none_()
            ct.file_count = 2
            transcript.end_run_with_summary(t, true, "result", 10, ct, s as ptr)
            e = e_(t, 0)
            spec.assert_eq(e.run, entry.RUN_OK, "ok")
            streq(e.label, "Run · a1 timed out · edit 2 files · bash")
            streq(e.files, "read a.zig")
            streq(seg_text_(e, 0), "! ")
            spec.assert_eq(screen.color_value(entry.segments(e)[0].style.fg), 3, "yellow")
        }
        spec.it("expanded Runs retain all result lines and label bounded diffs as previews") callback {
            t = transcript.new()
            result = ""
            diff_text = ""
            for i in 0..240 {
                result = "${result}result ${i}\n"
                diff_text = "${diff_text}+line ${i}\n"
            }
            transcript.start_run(t, "script")
            transcript.end_run(t, true, result, 1, one_change_("a", 240, 0, diff_text))
            e = e_(t, 0)
            streq(e.output, result)
            streq(e.changes.preview, "Diff preview · 60 of 241 lines\n")
            spec.assert_true(string.contains(e.changes.diff, "more lines") == 0, "no more-lines text")
            transcript.toggle_all(t)
            shown = entry.segments(e)
            n = shown.len
            streq(shown[4].text, "Changes\n")
            streq(shown[n - 4].text, "Result\n")
            spec.assert_true(string.ends_with(shown[n - 3].text, "result 239") != 0, "last result line")
            streq(shown[n - 2].text, "\nScript\n")
            streq(shown[n - 1].text, "script")
        }
        spec.it("retry removes only the failed attempt and preserves interjections and prior answers") callback {
            t = transcript.new()
            transcript.add(t, entry.KIND_ASSISTANT, "previous Step")
            transcript.begin_attempt(t)
            transcript.append_delta(t, transcript.DELTA_TEXT, "failed draft")
            transcript.add(t, entry.KIND_USER, "interjection")
            e_(t, 2).queued = 1
            transcript.append_delta(t, transcript.DELTA_TEXT, "failed tail")
            transcript.discard_attempt(t)
            spec.assert_eq(transcript.count(t), 2, "two left")
            streq(e_(t, 0).text, "previous Step")
            streq(e_(t, 1).text, "interjection")
            transcript.begin_attempt(t)
            transcript.append_delta(t, transcript.DELTA_TEXT, "valid answer")
            a, _f = transcript.last_answer(t)
            streq(a, "valid answer")
            transcript.failure(t, "server detail", changes.REASON_MODEL)
            e = e_(t, 3)
            spec.assert_true(entry.collapsible(e), "collapsible")
            streq(e.label, "The model request failed.")
            streq(e.text, "server detail")
        }
        spec.it("auto-background completion updates its Run and preserves timeout state without another block") callback {
            t = transcript.new()
            transcript.start_run(t, "script")
            transcript.background_run(t, "r1")
            transcript.end_run(t, true, "registered", 500, none_())
            transcript.progress(t, agent_tree.new_agent("r1", "Run", run: 1, kind: BK_RUN, background: 1, `state`: agent_tree.PS_TIMED_OUT))
            transcript.background_result(t, BK_RUN, "r1", false, "timeout details")
            spec.assert_eq(transcript.count(t), 1, "one entry")
            e = e_(t, 0)
            streq(e.label, "Run · r1 timed out")
            streq(e.output, "timeout details")
            spec.assert_eq(e.agent_tree.rows.len, 0, "no rows")
            streq(seg_text_(e, 0), "! ")
        }
        spec.it("foreground command facts remain attached after their Run moves to background") callback {
            t = transcript.new()
            transcript.start_run(t, "await tools.bash({})")
            transcript.background_run(t, "r1")
            transcript.end_run(t, true, "registered", 500, none_())
            transcript.progress(t, agent_tree.new_agent("b1", "zig build test", run: 1, kind: BK_BASH, `state`: agent_tree.PS_FAILED, exit_code: 1))
            transcript.background_result(t, BK_RUN, "r1", true, "script returned")
            e = e_(t, 0)
            spec.assert_eq(e.agents.len, 1, "one")
            streq(row_(e, 0), "  └─ b1 bash zig build test · <1s · failed ✗ exit 1")
            spec.assert_true(entry.has_warning(e), "warning")
        }
        spec.it("retry placeholder survives reasoning and replaces draft without losing history anchor") callback {
            t = transcript.new()
            scroll = scroll_(1, 2, 1)
            transcript.begin_attempt(t)
            transcript.append_delta(t, transcript.DELTA_TEXT, "failed draft")
            transcript.add(t, entry.KIND_USER, "queued")
            transcript.append_delta(t, transcript.DELTA_TEXT, "tail")
            transcript.retry_attempt(t, scroll)
            spec.assert_eq(transcript.count(t), 2, "two")
            streq(e_(t, 0).text, "Interrupted · retrying")
            spec.assert_eq(e_(t, 0).retry_placeholder, 1, "placeholder")
            transcript.begin_attempt(t)
            transcript.append_delta(t, transcript.DELTA_REASONING, "hidden")
            transcript.retry_attempt(t, scroll)
            spec.assert_eq(transcript.count(t), 2, "still two")
            scroll.has_top = 1
            scroll.top_entry = 1
            scroll.top_row = 0
            transcript.clear_retry(t, scroll)
            spec.assert_eq(scroll.top_entry, 0, "anchor follows")
            transcript.append_delta(t, transcript.DELTA_TEXT, "answer")
            a, _f = transcript.last_answer(t)
            streq(a, "answer")
            transcript.clear_retry(t, scroll)
        }
        spec.it("display smoothing keeps complete answers and resets at a new attempt") callback {
            t = transcript.new()
            now = 1000 as long
            transcript.smooth_delta(t, "first", now)
            streq(entry.display_text(e_(t, 0)), "first")
            transcript.smooth_delta(t, " burst 中文👩‍💻", now)
            spec.assert_true(transcript.has_backlog(t), "backlog")
            a, _f = transcript.last_answer(t)
            streq(a, "first burst 中文👩‍💻")
            transcript.flush_visible(t)
            spec.assert_false(transcript.has_backlog(t), "flushed")
            a2, _f2 = transcript.last_answer(t)
            streq(a2, entry.display_text(e_(t, 0)))
            transcript.begin_attempt(t)
            transcript.smooth_delta(t, "next", now)
            streq(entry.display_text(e_(t, 1)), "next")
        }
        spec.it("latest details entry is the newest Run, background or failure") callback {
            t = transcript.new()
            spec.assert_eq(transcript.latest_details(t), -1, "none")
            transcript.add(t, entry.KIND_ASSISTANT, "hi")
            transcript.start_run(t, "a")
            transcript.add(t, entry.KIND_ASSISTANT, "done")
            spec.assert_eq(transcript.latest_details(t), 1, "run")
            transcript.failure(t, "boom", changes.REASON_TOOL)
            spec.assert_eq(transcript.latest_details(t), 3, "failure")
            transcript.toggle(t, transcript.latest_details(t))
            spec.assert_true(e_(t, 3).open == 1 && e_(t, 1).open == 0, "only the failure opens")
        }
        spec.it("Simple collapsed Run shows path facts on its title row") callback {
            for ci in 0..2 {
                for si in 0..2 {
                    simple = si == 0
                    surf = screen.surface(60, 4)
                    win = screen.window(surf)
                    t = transcript.new()
                    transcript.start_run(t, "await tools.read({})")
                    s = tool_summary.empty()
                    changed = 0
                    want_simple = ""
                    want_normal = ""
                    if ci == 0 {
                        f = heap.new(tool_summary.File)
                        f.tool = "glob"
                        f.path = "**/*.md"
                        f.duration_ms = -1
                        list.list_add(s.files, f as ptr)
                        c = heap.new(tool_summary.Count)
                        c.name = "glob"
                        c.count = 1
                        list.list_add(s.counts, c as ptr)
                        want_simple = "  Run · glob **/*.md"
                        want_normal = "  Run"
                    } else {
                        f1 = heap.new(tool_summary.File)
                        f1.tool = "read"
                        f1.path = "src/a.zig"
                        f1.duration_ms = -1
                        list.list_add(s.files, f1 as ptr)
                        f2 = heap.new(tool_summary.File)
                        f2.tool = "read"
                        f2.path = "src/b.zig"
                        f2.duration_ms = -1
                        list.list_add(s.files, f2 as ptr)
                        c1 = heap.new(tool_summary.Count)
                        c1.name = "read"
                        c1.count = 2
                        list.list_add(s.counts, c1 as ptr)
                        c2 = heap.new(tool_summary.Count)
                        c2.name = "edit"
                        c2.count = 1
                        list.list_add(s.counts, c2 as ptr)
                        changed = 1
                        want_simple = "  Run · read src/a.zig · read src/b.zig · edit 1 file"
                        want_normal = "  Run · edit 1 file"
                    }
                    ct = none_()
                    if changed == 1 { ct = one_change_("a", 1, 0, "+x\n") }
                    transcript.end_run_with_summary(t, true, "", 10, ct, s as ptr)
                    e = e_(t, 0)
                    if simple { e.simple = 1 }
                    if simple { spec.assert_eq(entry.draw(e, win, true), 1, "one row") }
                    if !simple { entry.draw(e, win, true) }
                    want = want_normal
                    if simple { want = want_simple }
                    streq(screen.row_text(surf, 0), want)
                }
            }
        }
    }
    return spec.run_summary(fw)
}
