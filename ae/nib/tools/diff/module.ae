// tools.diff: line diff with bounded preview (upstream src/tools/diff.zig).
// compare(before, after) -> *Stat. Preview text is "+", "-" or " " prefixed
// changed lines with one line of context, gaps as "…", cut after 200 lines
// with a final "… N more lines".

import std.string
import std.list

exports(MAX_LINES, CONTEXT, MAX_CELLS, Change, Stat, Preview, Op,
        new_preview, preview_append, preview_format, compare)

const MAX_LINES = 200
const CONTEXT = 1
// Larger changed regions are reported as fully replaced instead of aligned line by line.
const MAX_CELLS = 1048576

// Cumulative successful edit/write operations on one file within a Run.
struct Change {
    path: string
    added: int
    removed: int
    created: int   // 1: at least one write created the file
    diff: string
}

struct Preview {
    text: string
    shown: int
    omitted: int
}

struct Stat {
    added: int
    removed: int
    diff: string
    preview: *Preview
}

// kind: 0 same, 1 add, 2 remove
struct Op {
    kind: int
    text: string
}

new_preview() -> *Preview {
    p = heap.new(Preview)
    p.text = ""
    p.shown = 0
    p.omitted = 0
    return p
}

preview_gap_(p: *Preview) {
    if p.shown > 0 && p.shown < MAX_LINES { p.text = "${p.text}…\n" }
}

preview_line_(p: *Preview, prefix: string, text: string) {
    if p.shown == MAX_LINES {
        p.omitted = p.omitted + 1
        return
    }
    p.text = "${p.text}${prefix}${text}\n"
    p.shown = p.shown + 1
}

preview_append(p: *Preview, other: *Preview) {
    if other.shown > 0 { preview_gap_(p) }
    s = other.text
    n = string.length(s)
    pos = 0
    while pos <= n {
        e = string.index_of_from(s, "\n", pos)
        if e < 0 { e = n }
        text = string.substring(s, pos, e)
        if string.length(text) != 0 {
            if string.equals(text, "…") != 0 {
                preview_gap_(p)
            } else {
                preview_line_(p, "", text)
            }
        }
        pos = e + 1
    }
    p.omitted = p.omitted + other.omitted
}

preview_format(p: *Preview) -> string {
    if p.omitted == 0 { return string.copy(p.text) }
    return "${p.text}… ${p.omitted} more lines\n"
}

// Lines of text without trailing newlines; "" has no lines.
lines_(text: string) -> ptr {
    out = list.list_new()
    if string.length(text) == 0 { return out }
    end = string.length(text)
    while end > 0 && string.char_at(text, end - 1) == 10 { end = end - 1 }
    s = string.substring(text, 0, end)
    pos = 0
    while pos <= end {
        e = string.index_of_from(s, "\n", pos)
        if e < 0 { e = end }
        list.list_add(out, string.substring(s, pos, e))
        pos = e + 1
    }
    return out
}

line_(l: ptr, i: int) -> string {
    s, _err = list.get_string(l, i)
    return s
}

add_op_(ops: ptr, kind: int, text: string) {
    o = heap.new(Op)
    o.kind = kind
    o.text = text
    list.list_add(ops, o)
}

// Longest common subsequence over the changed middle: old[a0, a1) vs new[b0, b1).
align_middle_(old: ptr, a0: int, a1: int, nw: ptr, b0: int, b1: int, ops: ptr) {
    n = a1 - a0
    m = b1 - b0
    if n == 0 || m == 0 || (n + 1) * (m + 1) > MAX_CELLS {
        k = a0
        while k < a1 {
            add_op_(ops, 2, line_(old, k))
            k = k + 1
        }
        k = b0
        while k < b1 {
            add_op_(ops, 1, line_(nw, k))
            k = k + 1
        }
        return
    }
    w = m + 1
    table = make([]int, (n + 1) * w)
    i = n + 1
    while i > 0 {
        i = i - 1
        j = m + 1
        while j > 0 {
            j = j - 1
            v = 0
            if i == n || j == m {
                v = 0
            } else if string.equals(line_(old, a0 + i), line_(nw, b0 + j)) != 0 {
                v = table[(i + 1) * w + j + 1] + 1
            } else {
                x = table[(i + 1) * w + j]
                y = table[i * w + j + 1]
                v = x
                if y > x { v = y }
            }
            table[i * w + j] = v
        }
    }
    i = 0
    j = 0
    while i < n || j < m {
        if i < n && j < m && string.equals(line_(old, a0 + i), line_(nw, b0 + j)) != 0 {
            add_op_(ops, 0, line_(old, a0 + i))
            i = i + 1
            j = j + 1
        } else if i < n && (j == m || table[(i + 1) * w + j] >= table[i * w + j + 1]) {
            add_op_(ops, 2, line_(old, a0 + i))
            i = i + 1
        } else {
            add_op_(ops, 1, line_(nw, b0 + j))
            j = j + 1
        }
    }
}

op_kind_(ops: ptr, i: int) -> int { return (list.list_get_raw(ops, i) as *Op).kind }

// A change, or within CONTEXT lines of one.
near_(ops: ptr, i: int) -> int {
    lo = i - CONTEXT
    if lo < 0 { lo = 0 }
    hi = i + CONTEXT + 1
    total = list.list_size(ops)
    if hi > total { hi = total }
    k = lo
    while k < hi {
        if op_kind_(ops, k) != 0 { return 1 }
        k = k + 1
    }
    return 0
}

render_(ops: ptr) -> *Preview {
    out = new_preview()
    last = -1
    total = list.list_size(ops)
    i = 0
    while i < total {
        if near_(ops, i) != 0 {
            if last >= 0 && i > last + 1 { preview_gap_(out) }
            op = list.list_get_raw(ops, i) as *Op
            prefix = " "
            if op.kind == 1 { prefix = "+" }
            if op.kind == 2 { prefix = "-" }
            preview_line_(out, prefix, op.text)
            last = i
        }
        i = i + 1
    }
    return out
}

compare(before: string, after: string) -> *Stat {
    old = lines_(before)
    nw = lines_(after)
    on = list.list_size(old)
    nn = list.list_size(nw)

    prefix = 0
    while prefix < on && prefix < nn && string.equals(line_(old, prefix), line_(nw, prefix)) != 0 { prefix = prefix + 1 }
    suffix = 0
    while suffix < on - prefix && suffix < nn - prefix && string.equals(line_(old, on - 1 - suffix), line_(nw, nn - 1 - suffix)) != 0 { suffix = suffix + 1 }

    ops = list.list_new()
    i = 0
    while i < prefix {
        add_op_(ops, 0, line_(old, i))
        i = i + 1
    }
    align_middle_(old, prefix, on - suffix, nw, prefix, nn - suffix, ops)
    i = on - suffix
    while i < on {
        add_op_(ops, 0, line_(old, i))
        i = i + 1
    }

    st = heap.new(Stat)
    st.added = 0
    st.removed = 0
    total = list.list_size(ops)
    i = 0
    while i < total {
        k = op_kind_(ops, i)
        if k == 1 { st.added = st.added + 1 }
        if k == 2 { st.removed = st.removed + 1 }
        i = i + 1
    }
    st.preview = render_(ops)
    st.diff = preview_format(st.preview)
    return st
}
