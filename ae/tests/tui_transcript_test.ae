        spec.it("mixed ids replace in creation order and settle only when delivered") callback {
            t = transcript.new()
            transcript.start_run(t, "Promise.all([tools.agent({}), tools.bash({}), tools.agent({})])")
            transcript.progress(t, agent_tree.new_agent("a10", "first", run: 1, step: 1))
            transcript.progress(t, agent_tree.new_agent("b2", "echo ready", run: 1, kind: BK_BASH, background: 1, `state`: agent_tree.PS_DONE, elapsed_ms: 192000))
            transcript.progress(t, agent_tree.new_agent("a2", "last", run: 1, background: 1, `state`: agent_tree.PS_FAILED, step: 2))
            transcript.progress(t, agent_tree.new_agent("a10", "updated", run: 1, step: 3))
            spec.assert_eq(e_(t, 0).agents.len, 3, "three")
            streq(agent_(e_(t, 0), 0).id, "a10")
            streq(agent_(e_(t, 0), 1).id, "b2")
            streq(agent_(e_(t, 0), 2).id, "a2")
            streq(row_(e_(t, 0), 0), "  ├─ a10 updated · running · step 3")
            streq(row_(e_(t, 0), 1), "  ├─ b2 bash echo ready · 3m12s · waiting")
            streq(row_(e_(t, 0), 2), "  └─ a2 last · failed · step 2")
            transcript.end_run(t, true, "started", 100, none_())
            transcript.start_run(t, "tools.read({})")
            transcript.progress(t, agent_tree.new_agent("b2", "echo ready", kind: BK_BASH, background: 1, `state`: agent_tree.PS_DONE, elapsed_ms: 192000))
            spec.assert_eq(e_(t, 1).agents.len, 0, "not in the second run")
            transcript.background_result(t, BK_BASH, "b2", true, "{\"exit_code\":0,\"output\":\"ready\"}")
            streq(row_(e_(t, 0), 1), "  ├─ b2 bash echo ready · 3m12s · completed")
            spec.assert_eq(agent_(e_(t, 0), 2).background, 1, "a2 still background")
            transcript.lost_background(t, BK_AGENT, "a2", "[background agent a2 lost: process ended]")
            streq(row_(e_(t, 0), 2), "  └─ a2 last · failed · step 2")
            transcript.progress(t, agent_tree.new_agent("a2", "last", run: 1, background: 1, `state`: agent_tree.PS_DONE, step: 4))
            spec.assert_eq(agent_(e_(t, 0), 2).background, 0, "a2 settled")
            streq(row_(e_(t, 0), 2), "  └─ a2 last · failed · step 4")
            streq(e_(t, 2).label, "b2 bash · completed · exit 0")
            streq(e_(t, 3).label, "a2 agent · lost")
        }
        spec.it("live and restored mixed results have identical folded labels and complete details") callback {
            live = transcript.new()
            restored = transcript.new()
            bash_result = "{\"exit_code\":0,\"output\":\"ready\\nmore output\"}"
            agent_result = "{\"ok\":false,\"text\":\"failed to build\",\"error\":\"compiler error\"}"
            lost = "[background agent a10 lost: process ended]"
            transcript.background_result(live, BK_BASH, "b2", true, bash_result)
            transcript.background_result(live, BK_AGENT, "a2", false, agent_result)
            transcript.lost_background(live, BK_AGENT, "a10", lost)
            h = msgs_()
            push_(h, bg_msg_("[background bash b2 finished]\n${bash_result}", "bash", "b2", ""))
            push_(h, bg_msg_("[background agent a2 finished]\n${agent_result}", "agent", "a2", ""))
            push_(h, bg_msg_(lost, "agent", "a10", ""))
            transcript.add_history(restored, h)
            labels = ["b2 bash · completed · exit 0", "a2 agent · failed", "a10 agent · lost"]
            fulls = [bash_result, agent_result, lost]
            for i in 0..3 {
                a = e_(live, i)
                b = e_(restored, i)
                streq(a.label, labels[i])
                streq(b.label, labels[i])
                mark = "✗ "
                if i == 0 { mark = "✓ " } else if i == 2 { mark = "! " }
                streq(seg_text_(a, 0), mark)
                streq(seg_text_(a, 0), seg_text_(b, 0))
                spec.assert_eq(seg_count_(b), 2, "folded")
            }
            transcript.toggle_all(live)
            transcript.toggle_all(restored)
            for i in 0..3 {
                spec.assert_eq(seg_count_(e_(restored, i)), 4, "open")
                streq(seg_text_(e_(live, i), 3), fulls[i])
                streq(seg_text_(e_(restored, i), 3), fulls[i])
            }
        }
        spec.it("delivered failures retain terminal cancellation and timeout states") callback {
            t = transcript.new()
