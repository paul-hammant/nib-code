// run_replay: `nib replay <session-id> --run <step>:<run> [--script <file>]
// [--json]` and `nib replay <session-id> --all [--json]` (upstream
// src/replay.zig; docs/replay.md). Reads the Session's main log for each
// Run's code and model-visible output, its `<id>.calls.jsonl` sidecar for
// the recorded calls, replays offline (nib.sandbox.replay) and compares.
// Named run_replay: the replay core already has the basename `replay`.
//
// Nothing reaches a provider or a real tool. Errors are upstream's names
// (InvalidReplayArguments, InvalidSessionId, ReplayMetadataNotFound,
// ReplayRunNotFound, InvalidReplayLog, FileNotFound); main words them.

import std.json
import std.list
import std.map
import std.string
import std.strbuilder
import std.fs
import nib.jsonx
import nib.sandbox
import nib.sandbox.replay
import nib.session.output

exports(Options, Run, Recording, Report, parse_options, load_main, load_calls, replay_one, run)

struct Options {
    id: string
    has_key: int
    step: int
    run: int
    all: int
    script: string
    has_script: int
    json: int
}

// A Run of the main log: its key, code, and the output the model saw.
struct Run {
    step: int
    run: int
    code: string
    expected: string
    has_expected: int
    child: int
    remaining_steps: long   // -1 none
}

struct Recording {
    step: int
    run: int
    start_ms_epoch: long
    run_output_bytes: long
    entries: ptr            // list of *replay.Entry
    end: string             // "" none
    incomplete: int
}

struct Report {
    run: string
    verdict: int            // match: 1 true, 0 false, -1 null
    divergence: string
    has_divergence: int
    incomplete: int
    uses_time: int
    uses_random: int
    output: string
    end: string             // "" null
}

// A loader's error, set once; every reader returns a default after it.
struct Load {
    err: string
}

bad_(ld: *Load) {
    if ld.err == "" { ld.err = "InvalidReplayLog" }
}

// ---- options ----

decimal_(s: string) -> long {
    n = string.length(s)
    if n == 0 || n > 18 { return -1 as long }
    v = 0 as long
    i = 0
    while i < n {
        c = string.char_at(s, i)
        if c < 48 || c > 57 { return -1 as long }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    return v
}

// (*Options, "") or (null, "InvalidReplayArguments" | "InvalidSessionId").
parse_options(args: ptr) -> (ptr, string) {
    n = list.list_size(args)
    if n == 0 { return null, "InvalidReplayArguments" }
    id, _g = list.get_string(args, 0)
    if string.length(id) != 32 { return null, "InvalidSessionId" }
    k = 0
    while k < 32 {
        c = string.char_at(id, k)
        if !((c >= 48 && c <= 57) || (c >= 97 && c <= 102)) { return null, "InvalidSessionId" }
        k = k + 1
    }
    o = heap.new(Options)
    o.id = id
    o.has_key = 0
    o.step = 0
    o.run = 0
    o.all = 0
    o.script = ""
    o.has_script = 0
    o.json = 0
    i = 1
    while i < n {
        arg, _g2 = list.get_string(args, i)
        if arg == "--all" {
            if o.all == 1 || o.has_key == 1 { return null, "InvalidReplayArguments" }
            o.all = 1
        } else if arg == "--run" {
            if o.has_key == 1 || o.all == 1 { return null, "InvalidReplayArguments" }
            i = i + 1
            if i == n { return null, "InvalidReplayArguments" }
            v, _g3 = list.get_string(args, i)
            colon = string.index_of(v, ":")
            if colon < 0 { return null, "InvalidReplayArguments" }
            step = decimal_(string.substring(v, 0, colon))
            index = decimal_(string.substring(v, colon + 1, string.length(v)))
            if step <= 0 || index < 0 { return null, "InvalidReplayArguments" }
            o.step = step as int
            o.run = index as int
            o.has_key = 1
        } else if arg == "--script" {
            if o.has_script == 1 { return null, "InvalidReplayArguments" }
            i = i + 1
            if i == n { return null, "InvalidReplayArguments" }
            sv, _g4 = list.get_string(args, i)
            if string.length(sv) == 0 || string.starts_with(sv, "--") == 1 { return null, "InvalidReplayArguments" }
            o.script = sv
            o.has_script = 1
        } else if arg == "--json" {
            if o.json == 1 { return null, "InvalidReplayArguments" }
            o.json = 1
        } else {
            return null, "InvalidReplayArguments"
        }
        i = i + 1
    }
    if (o.all == 0 && o.has_key == 0) || (o.all == 1 && o.has_script == 1) { return null, "InvalidReplayArguments" }
    return o as ptr, ""
}

// ---- JSON reads ----

field_(ld: *Load, v: ptr, name: string) -> ptr {
    f = jsonx.field(v, name)
    if f == null { bad_(ld) }
    return f
}

str_(ld: *Load, v: ptr) -> string {
    if v == null || json.json_type(v) != json.JSON_STRING {
        bad_(ld)
        return ""
    }
    return string.copy(jsonx.str_field(v))
}

natural_(ld: *Load, v: ptr) -> long {
    if v == null || json.json_type(v) != json.JSON_NUMBER || json.json_is_integer(v) == 0 {
        bad_(ld)
        return 0 as long
    }
    n = json.json_get_long(v)
    if n < 0 {
        bad_(ld)
        return 0 as long
    }
    return n
}

// 1 and the string when member `name` is a string, 0 when absent or null.
opt_str_(ld: *Load, v: ptr, name: string) -> (int, string) {
    if v == null || json.json_type(v) != json.JSON_OBJECT {
        bad_(ld)
        return 0, ""
    }
    item = jsonx.field(v, name)
    if item == null { return 0, "" }
    if json.json_type(item) == json.JSON_NULL { return 0, "" }
    return 1, str_(ld, item)
}

present_(v: ptr, name: string) -> int {
    item = jsonx.field(v, name)
    if item == null { return 0 }
    if json.json_type(item) == json.JSON_NULL { return 0 }
    return 1
}

// The complete lines of `data` (a last one without its newline is left out).
lines_(data: string) -> ptr {
    out = list.list_new()
    n = string.length(data)
    start = 0
    i = 0
    while i < n {
        if string.char_at(data, i) == 10 {
            list.list_add(out, string.substring(data, start, i))
            start = i + 1
        }
        i = i + 1
    }
    return out
}

// ---- the main log ----

find_run_(runs: ptr, step: int, run: int) -> ptr {
    i = 0
    while i < list.list_size(runs) {
        r = list.list_get_raw(runs, i) as *Run
        if r.step == step && r.run == run { return r as ptr }
        i = i + 1
    }
    return null
}

// The Runs of a main log, Steps counted across the Session. Replacement
// records (compaction, repair) and fork headers retain assistant messages,
// not new Steps. (runs, "") or (null, err).
load_main(data: string) -> (ptr, string) {
    ld = heap.new(Load)
    ld.err = ""
    runs = list.list_new()
    length = 0 as long
    step = 0
    torn = 0
    records = 0
    child = 0
    ls = lines_(data)
    li = 0
    while li < list.list_size(ls) {
        line, _g = list.get_string(ls, li)
        li = li + 1
        if string.length(line) == 0 { continue }
        rec = jsonx.parse(line)
        if rec == null {
            torn = 1
            continue
        }
        if json.json_type(rec) != json.JSON_OBJECT { return null, "InvalidReplayLog" }
        repair = jsonx.field(rec, "repair")
        if repair != null && json.json_type(repair) == json.JSON_BOOL && json.json_get_bool(repair) == 1 {
            torn = 0
            continue
        }
        if torn == 1 { return null, "InvalidReplayLog" }
        if present_(rec, "diagnostic") == 1 || present_(rec, "agent_session") == 1 || present_(rec, "background") == 1 || present_(rec, "bash") == 1 || present_(rec, "task_stop") == 1 || present_(rec, "sandbox_unavailable") == 1 { continue }
        messages = jsonx.field(rec, "messages")
        nm = 0
        if messages != null {
            if json.json_type(messages) != json.JSON_ARRAY { return null, "InvalidReplayLog" }
            nm = json.json_array_size(messages)
        }
        if nm == 0 {
            has_fb, _fb = opt_str_(ld, rec, "transport_fallback")
            if has_fb == 1 { continue }
        }
        from = 0 as long
        if jsonx.field(rec, "from") != null { from = natural_(ld, jsonx.field(rec, "from")) }
        if ld.err != "" { return null, ld.err }
        if from > length { return null, "InvalidReplayLog" }
        if records == 0 {
            has_parent, _p = opt_str_(ld, rec, "parent_session_id")
            child = has_parent
        }
        appended = 0
        if from == length { appended = 1 }
        length = from + nm
        records = records + 1
        if appended == 0 { continue }
        if present_(rec, "forked_from") == 1 { continue }
        m = 0
        while m < nm {
            msg_ = json.json_array_get_raw(messages, m)
            completion = jsonx.field(msg_, "background_run")
            if completion != null && json.json_type(completion) != json.JSON_NULL {
                cs = natural_(ld, field_(ld, completion, "step")) as int
                cr = natural_(ld, field_(ld, completion, "run_index")) as int
                co = str_(ld, field_(ld, completion, "output"))
                if ld.err != "" { return null, ld.err }
                k = 0
                while k < list.list_size(runs) {
                    rr = list.list_get_raw(runs, k) as *Run
                    if rr.step == cs && rr.run == cr {
                        rr.expected = co
                        rr.has_expected = 1
                        rr.remaining_steps = -1 as long
                    }
                    k = k + 1
                }
            }
            role = str_(ld, field_(ld, msg_, "role"))
            if ld.err != "" { return null, ld.err }
            if role != "assistant" {
                m = m + 1
                continue
            }
            step = step + 1
            calls = jsonx.field(msg_, "tool_calls")
            if calls == null || json.json_type(calls) == json.JSON_NULL {
                m = m + 1
                continue
            }
            if json.json_type(calls) != json.JSON_ARRAY { return null, "InvalidReplayLog" }
            nc = json.json_array_size(calls)
            index = 0
            while index < nc {
                tc = json.json_array_get_raw(calls, index)
                fn_ = field_(ld, tc, "function")
                fname = str_(ld, field_(ld, fn_, "name"))
                if ld.err != "" { return null, ld.err }
                if fname == "run" {
                    astr = str_(ld, field_(ld, fn_, "arguments"))
                    if ld.err != "" { return null, ld.err }
                    arguments = jsonx.parse(astr)
                    code = ""
                    has_code = 0
                    if arguments != null && json.json_type(arguments) == json.JSON_OBJECT {
                        cv = jsonx.field(arguments, "code")
                        if cv != null && json.json_type(cv) == json.JSON_STRING {
                            code = string.copy(jsonx.str_field(cv))
                            has_code = 1
                        }
                    }
                    jsonx.free(arguments)
                    if has_code == 1 {
                        id = str_(ld, field_(ld, tc, "id"))
                        if ld.err != "" { return null, ld.err }
                        r = heap.new(Run)
                        r.step = step
                        r.run = index
                        r.code = code
                        r.expected = ""
                        r.has_expected = 0
                        r.child = child
                        r.remaining_steps = -1 as long
                        q = m + 1
                        while q < nm {
                            result = json.json_array_get_raw(messages, q)
                            rrole = str_(ld, field_(ld, result, "role"))
                            if ld.err != "" { return null, ld.err }
                            if rrole == "assistant" { break }
                            if rrole == "tool" {
                                has_id, rid = opt_str_(ld, result, "tool_call_id")
                                if has_id == 1 && rid == id {
                                    has_c, content = opt_str_(ld, result, "content")
                                    r.has_expected = has_c
                                    r.expected = content
                                    break
                                }
                            }
                            q = q + 1
                        }
                        results = jsonx.field(rec, "run_results")
                        if results != null && json.json_type(results) != json.JSON_NULL {
                            if json.json_type(results) != json.JSON_ARRAY { return null, "InvalidReplayLog" }
                            nr = json.json_array_size(results)
                            ri = 0
                            while ri < nr {
                                rv = json.json_array_get_raw(results, ri)
                                if str_(ld, field_(ld, rv, "tool_call_id")) == id {
                                    has_bg, _bg = opt_str_(ld, rv, "background_id")
                                    if has_bg == 1 { r.has_expected = 0 }
                                    rem = jsonx.field(rv, "remaining_steps")
                                    if rem != null && json.json_type(rem) != json.JSON_NULL { r.remaining_steps = natural_(ld, rem) }
                                    break
                                }
                                ri = ri + 1
                            }
                        }
                        if ld.err != "" { return null, ld.err }
                        list.list_add(runs, r as ptr)
                    }
                }
                index = index + 1
            }
            m = m + 1
        }
        if ld.err != "" { return null, ld.err }
    }
    if records == 0 { return null, "InvalidReplayLog" }
    return runs, ""
}

// ---- the calls sidecar ----

recording_for_(recs: ptr, step: int, run: int) -> ptr {
    i = 0
    while i < list.list_size(recs) {
        r = list.list_get_raw(recs, i) as *Recording
        if r.step == step && r.run == run { return r as ptr }
        i = i + 1
    }
    return null
}

is_end_(s: string) -> int {
    if s == replay.END_OK || s == replay.END_ERROR || s == replay.END_TIMEOUT || s == replay.END_CANCELLED { return 1 }
    return 0
}

// The recordings of a calls sidecar, same_as references resolved across the
// Session. (recordings, "") or (null, err).
load_calls(data: string) -> (ptr, string) {
    ld = heap.new(Load)
    ld.err = ""
    recs = list.list_new()
    resolved = map.map_new()
    ls = lines_(data)
    li = 0
    while li < list.list_size(ls) {
        line, _g = list.get_string(ls, li)
        li = li + 1
        if string.length(line) == 0 { continue }
        row = jsonx.parse(line)
        if row == null || json.json_type(row) != json.JSON_OBJECT { return null, "InvalidReplayLog" }
        step = natural_(ld, field_(ld, row, "step")) as int
        run = natural_(ld, field_(ld, row, "run")) as int
        if ld.err != "" { return null, ld.err }
        if step == 0 || jsonx.has(row, "type") == 1 || jsonx.has(row, "same_as") == 1 { return null, "InvalidReplayLog" }
        rp = recording_for_(recs, step, run)
        if rp == null {
            nr = heap.new(Recording)
            nr.step = step
            nr.run = run
            nr.start_ms_epoch = 0 as long
            nr.run_output_bytes = output.MAX_BYTES as long
            nr.entries = list.list_new()
            nr.end = ""
            nr.incomplete = 0
            list.list_add(recs, nr as ptr)
            rp = nr as ptr
        }
        r = rp as *Recording
        if r.end != "" { return null, "InvalidReplayLog" }
        meta = jsonx.field(row, "meta")
        if meta != null {
            start = field_(ld, meta, "start_ms_epoch")
            if ld.err != "" { return null, ld.err }
            if json.json_type(start) != json.JSON_NUMBER || json.json_is_integer(start) == 0 { return null, "InvalidReplayLog" }
            r.start_ms_epoch = json.json_get_long(start)
            limit = jsonx.field(meta, "run_output_bytes")
            if limit != null {
                r.run_output_bytes = natural_(ld, limit)
                if ld.err != "" { return null, ld.err }
                if r.run_output_bytes < 16384 || r.run_output_bytes > 16777216 { return null, "InvalidReplayLog" }
            }
            inc = jsonx.field(meta, "incomplete")
            if inc != null {
                if json.json_type(inc) != json.JSON_BOOL { return null, "InvalidReplayLog" }
                if json.json_get_bool(inc) == 1 { r.incomplete = 1 }
            }
            end = str_(ld, field_(ld, meta, "end"))
            if ld.err != "" { return null, ld.err }
            if is_end_(end) == 0 { return null, "InvalidReplayLog" }
            r.end = end
            continue
        }
        okv = field_(ld, row, "ok")
        if ld.err != "" { return null, ld.err }
        if json.json_type(okv) != json.JSON_BOOL { return null, "InvalidReplayLog" }
        ok = json.json_get_bool(okv)
        index = natural_(ld, field_(ld, row, "index")) as int
        seq = natural_(ld, field_(ld, row, "seq")) as int
        name = str_(ld, field_(ld, row, "name"))
        args = field_(ld, row, "args")
        has_sha, sha = opt_str_(ld, row, "sha256")
        has_err, errtext = opt_str_(ld, row, "error")
        if ld.err != "" { return null, ld.err }
        ep = replay.new_entry(index, seq, name, jsonx.encode(args), ok)
        if ep == null { return null, "InvalidReplayLog" }
        e = ep as *replay.Entry
        if has_sha == 1 { e.sha256 = sha }
        if has_err == 1 { replay.entry_set_error(ep, errtext) }
        tr = jsonx.field(row, "truncated")
        if tr != null {
            if json.json_type(tr) != json.JSON_BOOL { return null, "InvalidReplayLog" }
            e.truncated = json.json_get_bool(tr)
        }
        res = jsonx.field(row, "result")
        if res != null {
            if ok == 0 { return null, "InvalidReplayLog" }
            if json.json_type(res) == json.JSON_STRING {
                replay.entry_set_result(ep, string.copy(jsonx.str_field(res)))
            } else if json.json_type(res) == json.JSON_OBJECT {
                e.same_as = str_(ld, field_(ld, res, "same_as"))
                e.has_same_as = 1
                if ld.err != "" { return null, ld.err }
            } else {
                return null, "InvalidReplayLog"
            }
        }
        if e.has_same_as == 1 {
            if map.map_has(resolved, e.same_as) == 1 {
                original = map.map_get_raw(resolved, e.same_as) as *replay.Entry
                e.result = original.result
                e.has_result = original.has_result
                if original.truncated == 1 { e.truncated = 1 }
            } else {
                r.incomplete = 1
                e.truncated = 1
            }
        }
        has = e.has_error
        if ok == 1 { has = e.has_result }
        if has == 0 {
            r.incomplete = 1
            e.truncated = 1
            if ok == 1 { replay.entry_set_result(ep, "") } else { replay.entry_set_error(ep, "") }
        }
        if e.truncated == 1 { r.incomplete = 1 }
        if ok == 1 && string.length(e.sha256) != 0 { map.map_put(resolved, e.sha256, ep) }
        list.list_add(r.entries, ep)
        jsonx.free(row)
    }
    i = 0
    while i < list.list_size(recs) {
        rr = list.list_get_raw(recs, i) as *Recording
        if rr.end == "" { rr.incomplete = 1 }
        i = i + 1
    }
    return recs, ""
}

// ---- replay and reports ----

new_report_(run: string) -> *Report {
    rep = heap.new(Report)
    rep.run = run
    rep.verdict = -1
    rep.divergence = ""
    rep.has_divergence = 0
    rep.incomplete = 1
    rep.uses_time = 0
    rep.uses_random = 0
    rep.output = ""
    rep.end = ""
    return rep
}

// One Run replayed against its recording; script "" (has_script 0) for the
// original code. (*Report, "") or (null, err).
replay_one(rp: ptr, cp: ptr, script: string, has_script: int) -> (ptr, string) {
    original = rp as *Run
    recording = cp as *Recording
    code = original.code
    if has_script == 1 { code = script }
    end = recording.end
    if end == "" { end = replay.END_OK }
    ev = replay.execute_session(code, recording.entries, recording.start_ms_epoch, end, has_script, original.child) as *replay.Report
    if ev.failed == 1 { return null, "OutOfMemory" }
    text = output.step_limit_output(output.format(ev.outcome, recording.run_output_bytes), original.remaining_steps)
    incomplete = 0
    if recording.incomplete == 1 || ev.incomplete == 1 || original.has_expected == 0 { incomplete = 1 }
    determined = 0
    if has_script == 0 && incomplete == 0 && recording.end != replay.END_TIMEOUT && recording.end != replay.END_CANCELLED { determined = 1 }
    equal = 0
    if original.has_expected == 1 && original.expected == text { equal = 1 }
    rep = new_report_("${original.step}:${original.run}")
    if determined == 1 {
        rep.verdict = 0
        if ev.has_divergence == 0 && equal == 1 { rep.verdict = 1 }
    }
    if ev.has_divergence == 1 {
        rep.divergence = ev.divergence
        rep.has_divergence = 1
    } else if determined == 1 && equal == 0 {
        rep.divergence = "output differs: expected=${jsonx.quote(original.expected)}; actual=${jsonx.quote(text)}"
        rep.has_divergence = 1
    }
    rep.incomplete = incomplete
    rep.uses_time = ev.uses_time
    rep.uses_random = ev.uses_random
    rep.output = text
    rep.end = recording.end
    return rep as ptr, ""
}

bool_(b: int) -> string {
    if b == 1 { return "true" }
    return "false"
}

report_json_(rep: *Report) -> string {
    m = "null"
    if rep.verdict == 1 { m = "true" }
    if rep.verdict == 0 { m = "false" }
    d = "null"
    if rep.has_divergence == 1 { d = jsonx.quote(rep.divergence) }
    e = "null"
    if rep.end != "" { e = jsonx.quote(rep.end) }
    return "{\"run\":${jsonx.quote(rep.run)},\"match\":${m},\"divergence\":${d},\"incomplete\":${bool_(rep.incomplete)},\"uses_time\":${bool_(rep.uses_time)},\"uses_random\":${bool_(rep.uses_random)},\"output\":${jsonx.quote(rep.output)},\"end\":${e}}"
}

abnormal_(end: string) -> int {
    if end == replay.END_TIMEOUT || end == replay.END_CANCELLED { return 1 }
    return 0
}

// `nib replay <args>` with $NIB_HOME `home`: (stdout, stderr, err).
run(home: string, args: ptr) -> (string, string, string) {
    op, perr = parse_options(args)
    if perr != "" { return "", "", perr }
    o = op as *Options
    dir = "${home}/sessions"
    data, rerr = fs.read("${dir}/${o.id}.jsonl")
    if rerr != "" { return "", "", "FileNotFound" }
    runs, merr = load_main(data)
    if merr != "" { return "", "", merr }
    calls_path = "${dir}/${o.id}.calls.jsonl"
    if fs.exists(calls_path) == 0 { return "", "", "ReplayMetadataNotFound" }
    calls, cerr = fs.read(calls_path)
    if cerr != "" { return "", "", cerr }
    recs, lerr = load_calls(calls)
    if lerr != "" { return "", "", lerr }
    script = ""
    if o.has_script == 1 {
        st, serr = fs.read(o.script)
        if serr != "" { return "", "", "FileNotFound" }
        script = st
    }
    out = strbuilder.new(1024)
    errs = strbuilder.new(256)
    if o.all == 1 {
        reports = list.list_new()
        differences = list.list_new()
        matched = 0
        divergences = 0
        undetermined = 0
        i = 0
        while i < list.list_size(recs) {
            rec = list.list_get_raw(recs, i) as *Recording
            original = find_run_(runs, rec.step, rec.run)
            if original == null {
                missing = new_report_("${rec.step}:${rec.run}")
                missing.end = rec.end
                list.list_add(reports, missing as ptr)
                undetermined = undetermined + 1
            } else {
                rp, err = replay_one(original, rec as ptr, "", 0)
                if err != "" { return "", "", err }
                rep = rp as *Report
                list.list_add(reports, rp)
                if rep.has_divergence == 1 { list.list_add(differences, rp) }
                if rep.verdict == 1 { matched = matched + 1 }
                if rep.verdict == 0 { divergences = divergences + 1 }
                if rep.verdict == -1 { undetermined = undetermined + 1 }
            }
            i = i + 1
        }
        if o.json == 1 {
            strbuilder.append(out, "{\"total\":${list.list_size(reports)},\"matched\":${matched},\"divergences\":${divergences},\"undetermined\":${undetermined},\"differences\":[")
            k = 0
            while k < list.list_size(differences) {
                dr = list.list_get_raw(differences, k) as *Report
                if k > 0 { strbuilder.append(out, ",") }
                strbuilder.append(out, "{\"run\":${jsonx.quote(dr.run)},\"divergence\":${jsonx.quote(dr.divergence)}}")
                k = k + 1
            }
            strbuilder.append(out, "],\"reports\":[")
            k = 0
            while k < list.list_size(reports) {
                if k > 0 { strbuilder.append(out, ",") }
                strbuilder.append(out, report_json_(list.list_get_raw(reports, k) as *Report))
                k = k + 1
            }
            strbuilder.append(out, "]}\n")
        } else {
            strbuilder.append(out, "total: ${list.list_size(reports)}, matched: ${matched}, divergences: ${divergences}, undetermined: ${undetermined}\n")
            k = 0
            while k < list.list_size(differences) {
                dr2 = list.list_get_raw(differences, k) as *Report
                strbuilder.append(out, "replay ${dr2.run}: diff: ${dr2.divergence}\n")
                k = k + 1
            }
            k = 0
            while k < list.list_size(reports) {
                ar = list.list_get_raw(reports, k) as *Report
                if abnormal_(ar.end) == 1 { strbuilder.append(out, "replay ${ar.run}: end=${ar.end} (incomplete)\n") }
                k = k + 1
            }
        }
    } else {
        original2 = find_run_(runs, o.step, o.run)
        if original2 == null { return "", "", "ReplayRunNotFound" }
        rec2 = recording_for_(recs, o.step, o.run)
        if rec2 == null { return "", "", "ReplayMetadataNotFound" }
        rp2, err2 = replay_one(original2, rec2, script, o.has_script)
        if err2 != "" { return "", "", err2 }
        rep2 = rp2 as *Report
        if o.json == 1 {
            strbuilder.append(out, "${report_json_(rep2)}\n")
        } else {
            strbuilder.append(out, rep2.output)
            verdict = "undetermined"
            if rep2.verdict == 1 { verdict = "match" }
            if rep2.verdict == 0 { verdict = "diff" }
            inc = ""
            if rep2.incomplete == 1 { inc = " (incomplete)" }
            sc = ""
            if o.has_script == 1 { sc = " (script)" }
            strbuilder.append(errs, "replay ${rep2.run}: ${verdict}${inc}${sc}\n")
            if abnormal_(rep2.end) == 1 { strbuilder.append(errs, "end=${rep2.end}\n") }
            if rep2.has_divergence == 1 { strbuilder.append(errs, "${rep2.divergence}\n") }
            if rep2.uses_time == 1 || rep2.uses_random == 1 { strbuilder.append(errs, "uses_time=${bool_(rep2.uses_time)} uses_random=${bool_(rep2.uses_random)}\n") }
        }
    }
    return strbuilder.finish(out), strbuilder.finish(errs), ""
}
