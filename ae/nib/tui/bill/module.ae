// tui.bill: the quiet footer and the status details of a turn's usage
// (upstream src/tui/bill.zig).
// Differences from upstream: no Text buffer struct, so format/details/fit are
// plain functions returning new strings (no 1024-byte truncation); the
// TurnSummary is nib.tui.turn_summary's; runs/width are int.

import std.string
import std.strbuilder
import term.screen
import nib.tui.format
import nib.tui.turn_summary

exports(format_footer, details, fit)

plural_(n: long) -> string {
    if n == 1 { return "" }
    return "s"
}

// Appends " · " first when something is already in the line.
separator_(sb: ptr, wrote: int) {
    if wrote > 0 { strbuilder.append(sb, " · ") }
}

// Upstream's Text.format (`format` is also the name of the imported module).
format_footer(summary: turn_summary.TurnSummary, runs: int, width: int) -> string {
    sb = strbuilder.new(128)
    wrote = 0
    if runs > 0 {
        strbuilder.append(sb, "${runs} Run${plural_(runs as long)}")
        wrote = 1
    }
    if summary.steps > 0 {
        separator_(sb, wrote)
        strbuilder.append(sb, "${summary.steps} step${plural_(summary.steps)}")
        wrote = 1
    }
    if summary.timing.wall_ms > 0 {
        separator_(sb, wrote)
        strbuilder.append(sb, format.duration(summary.timing.wall_ms))
        wrote = 1
    }
    total = summary.usage.prompt_tokens + summary.usage.completion_tokens
    if total > 0 {
        separator_(sb, wrote)
        strbuilder.append(sb, "${format.number(total)} tokens")
        wrote = 1
    }
    if summary.timing.tool_bytes > 0 {
        separator_(sb, wrote)
        strbuilder.append(sb, "tool data ${format.bytes(summary.timing.tool_bytes)}")
        if summary.timing.output_bytes > 0 {
            strbuilder.append(sb, " → ${format.bytes(summary.timing.output_bytes)}")
        }
        wrote = 1
    } else if summary.timing.output_bytes > 0 {
        separator_(sb, wrote)
        strbuilder.append(sb, "Run result ${format.bytes(summary.timing.output_bytes)}")
        wrote = 1
    }
    return fit(strbuilder.finish(sb), width)
}

details(summary: turn_summary.TurnSummary) -> string {
    denom = summary.usage.prompt_tokens
    if denom < 1 { denom = 1 }
    pct = summary.usage.prompt_cache_hit_tokens * 100 / denom
    return "Last turn · ${summary.status}\nTotal ${format.duration(summary.timing.wall_ms)} · model ${format.duration(summary.timing.model_ms)} · Run ${format.duration(summary.timing.run_ms)}\nInput ${summary.usage.prompt_tokens} tokens · output ${summary.usage.completion_tokens} tokens\nCache ${summary.usage.prompt_cache_hit_tokens} tokens · ${pct}% of input · writes ${summary.usage.prompt_cache_write_tokens} tokens\nDelegation · llm ${summary.timing.llm_calls} · agent ${summary.timing.agent_calls}"
}

// Code points in `s` (UTF-8 lead bytes).
codepoints_(s: string) -> int {
    n = 0
    i = 0
    len = string.length(s)
    while i < len {
        if (s[i] & 192) != 128 { n = n + 1 }
        i = i + 1
    }
    return n
}

// Byte offset of the last " · " in `s`, -1 if none.
last_separator_(s: string) -> int {
    sep = " · "
    seplen = string.length(sep)
    i = string.length(s) - seplen
    while i >= 0 {
        if string.substring(s, i, i + seplen) == sep { return i }
        i = i - 1
    }
    return -1
}

// Drops whole trailing " · " fields until the line fits `width` code points; "" if none fits.
fit(full: string, width: int) -> string {
    line = full
    while codepoints_(line) > width {
        end = last_separator_(line)
        if end < 0 { return "" }
        line = string.substring(line, 0, end)
    }
    return line
}
