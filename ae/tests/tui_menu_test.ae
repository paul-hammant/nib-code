// Ports the tests of upstream src/tui/menu.zig under their names. The skills
// a `$` mention lists come from the menu's skill_source (the app sets it to
// session.skills.load over the four roots, as upstream discoverSkills).
import std.spec
import nib.tui.menu
import nib.tui.editor
import nib.session.skills
import std.fs

label_(m: *menu.Menu, input: string) -> string {
    c, ok = menu.selected(m, input)
    if !ok { return "<none>" }
    return c.label
}

main() {
    fw = spec.init()
    spec.describe(fw, "tui.menu") {
        spec.it("selection wraps, closing hides the list and editing reopens it") callback {
            m = menu.new()
            spec.assert_str_eq(label_(m, "/co"), "/copy", "first")
            menu.move(m, "/co", true)
            spec.assert_str_eq(label_(m, "/co"), "/compact", "down")
            menu.move(m, "/co", true)
            spec.assert_str_eq(label_(m, "/co"), "/copy", "wraps")
            menu.move(m, "/co", false)
            spec.assert_str_eq(label_(m, "/co"), "/compact", "up wraps")
            m.closed = 1
            spec.assert_str_eq(label_(m, "/co"), "<none>", "closed")
            menu.input_changed(m, "/c")
            spec.assert_str_eq(label_(m, "/c"), "/copy", "reopened")
        }
        spec.it("reflection is hidden unless enabled") callback {
            m = menu.new()
            spec.assert_eq(menu.items(m, "/ref").len, 0, "hidden")
            m.reflect_enabled = 1
            spec.assert_str_eq(menu.items(m, "/ref")[0].label, "/reflect", "shown")
        }
        spec.it("moving straight from an @ mention to a $ mention loads skills") callback {
            root, _e = fs.make_temp_dir("", "nibmenu")
            fs.mkdir_p("${root}/skills/review")
            fs.write("${root}/skills/review/SKILL.md", "---\nname: review\ndescription: Review a change.\n---\nBody\n")
            m = menu.new()
            m.skill_source = || {
                ptr found = skills.load(root, root, root).skills
                return found
            }
            m.has_skill_source = 1
            m.mention = menu.MENTION_FILE
            e = editor.new()
            editor.replace(e, "$re")
            menu.sync(m, e)
            spec.assert_eq(m.mention, menu.MENTION_SKILL, "skill mention")
            c, ok = menu.selected(m, "$re")
            spec.assert_true(ok, "listed")
            spec.assert_str_eq(c.label, "review", "review")
            spec.assert_str_eq(c.value, "$review ", "inserts the mention")
        }
    }
}
