// image: image attachments (upstream src/image.zig): header probing, content-
// hash storage under `$NIB_HOME/sessions/<id>.images/`, base64 request parts,
// the omitted-image text and pasted-path detection. Pixels are never decoded
// or resized.
//
// An Image is the JSON object text the Session log records (nib.msg's
// `images` array holds them): {"path","name","media_type","bytes","width",
// "height"}, in upstream's field order. File data are Aether strings read
// binary-safely (fs.read_binary keeps NULs; string.bytes(s) is the whole
// payload); nothing here goes through a C-string.
//
// The Run's attached images live in an Attached (a list behind a lock owned
// by the Run's scope, as upstream's per-RunScope list behind a mutex).
// A Target is what tools.view and tools.mcp attach through: the model's
// vision, where the Session stores images, and the Run's Attached.

import std.string
import std.list
import std.strbuilder
import std.bytes
import std.fs
import std.cryptography
import std.encoding
import nib.jsonx
import nib.lock
import nib.sysgap
import nib.tools.atomic_file

exports(MAX_BYTES, MAX_PER_RUN, ESTIMATED_TOKENS, probe, probe_json, media_type, extension, store, rejection, image_json,
        omitted_text, omitted_text_at, count, image_at, name_of, width_of, height_of, bytes_of, part_at, data_url, pasted_path,
        sample_png, Attached, new_attached, attach, attached_count, take, clear, free_attached, Target, new_target,
        image_dir)

const MAX_BYTES = 5 * 1024 * 1024
const MAX_PER_RUN = 4
// Context estimate for one image; compaction budgeting only.
const ESTIMATED_TOKENS = 1500

media_type(fmt: string) -> string {
    if fmt == "png" { return "image/png" }
    if fmt == "jpeg" { return "image/jpeg" }
    if fmt == "gif" { return "image/gif" }
    if fmt == "webp" { return "image/webp" }
    return ""
}

extension(fmt: string) -> string {
    if fmt == "jpeg" { return "jpg" }
    return fmt
}

// ---- header probing -------------------------------------------------------

be16_(b: byte[], i: int) -> long {
    return ((b[i] as long) << 8) | (b[i + 1] as long)
}

le16_(b: byte[], i: int) -> long {
    return (b[i] as long) | ((b[i + 1] as long) << 8)
}

be32_(b: byte[], i: int) -> long {
    return ((b[i] as long) << 24) | ((b[i + 1] as long) << 16) | ((b[i + 2] as long) << 8) | (b[i + 3] as long)
}

le32_(b: byte[], i: int) -> long {
    return (b[i] as long) | ((b[i + 1] as long) << 8) | ((b[i + 2] as long) << 16) | ((b[i + 3] as long) << 24)
}

// 1 when b[off..off+len(lit)) is the ASCII text `lit`.
eq_at_(b: byte[], off: int, lit: string) -> int {
    n = string.length(lit)
    i = 0
    while i < n {
        if (b[off + i] as int) != string.char_at(lit, i) { return 0 }
        i = i + 1
    }
    return 1
}

png_magic_(b: byte[]) -> int {
    m = [137, 80, 78, 71, 13, 10, 26, 10]
    i = 0
    while i < 8 {
        if (b[i] as int) != m[i] { return 0 }
        i = i + 1
    }
    return 1
}

// (format, width, height) of a JPEG: the first frame header after the segments; ("", 0, 0) none.
probe_jpeg_(b: byte[]) -> (string, long, long) {
    n = b.len
    i = 2
    while i + 4 <= n {
        if (b[i] as int) != 255 { return "", 0 as long, 0 as long }
        marker = b[i + 1] as int
        if marker == 255 {
            i = i + 1
            continue
        }
        if marker == 1 || (marker >= 208 && marker <= 216) {
            i = i + 2
            continue
        }
        if marker == 217 || marker == 218 { return "", 0 as long, 0 as long }
        length = be16_(b, i + 2) as int
        sof = 0
        if marker >= 192 && marker <= 207 && marker != 196 && marker != 200 && marker != 204 { sof = 1 }
        if sof == 1 {
            if length < 8 || i + 9 > n { return "", 0 as long, 0 as long }
            return "jpeg", be16_(b, i + 7), be16_(b, i + 5)
        }
        if length < 2 { return "", 0 as long, 0 as long }
        i = i + 2 + length
    }
    return "", 0 as long, 0 as long
}

// The three WebP encodings; `b` holds at least 30 bytes.
probe_webp_(b: byte[]) -> (string, long, long) {
    if eq_at_(b, 12, "VP8 ") == 1 {
        if (b[23] as int) != 157 || (b[24] as int) != 1 || (b[25] as int) != 42 { return "", 0 as long, 0 as long }
        return "webp", le16_(b, 26) & (16383 as long), le16_(b, 28) & (16383 as long)
    }
    if eq_at_(b, 12, "VP8L") == 1 {
        if (b[20] as int) != 47 { return "", 0 as long, 0 as long }
        bits = le32_(b, 21)
        return "webp", (bits & (16383 as long)) + 1, ((bits >> 14) & (16383 as long)) + 1
    }
    if eq_at_(b, 12, "VP8X") == 1 {
        w = (b[24] as long) | ((b[25] as long) << 8) | ((b[26] as long) << 16)
        h = (b[27] as long) | ((b[28] as long) << 8) | ((b[29] as long) << 16)
        return "webp", w + 1, h + 1
    }
    return "", 0 as long, 0 as long
}

probe_format_(b: byte[]) -> (string, long, long) {
    n = b.len
    if n >= 24 && png_magic_(b) == 1 && eq_at_(b, 12, "IHDR") == 1 { return "png", be32_(b, 16), be32_(b, 20) }
    if n >= 10 && (eq_at_(b, 0, "GIF87a") == 1 || eq_at_(b, 0, "GIF89a") == 1) { return "gif", le16_(b, 6), le16_(b, 8) }
    if n >= 4 && (b[0] as int) == 255 && (b[1] as int) == 216 { return probe_jpeg_(b) }
    if n >= 30 && eq_at_(b, 0, "RIFF") == 1 && eq_at_(b, 8, "WEBP") == 1 { return probe_webp_(b) }
    return "", 0 as long, 0 as long
}

// (format, width, height) of image data, or ("", 0, 0) when not a png, jpeg, gif or webp with a size.
probe(data: string) -> (string, long, long) {
    n = string.length(data)
    if n == 0 { return "", 0 as long, 0 as long }
    fmt, w, h = probe_format_(string.bytes(data)[0..n])
    if fmt == "" || w == 0 || h == 0 { return "", 0 as long, 0 as long }
    return fmt, w, h
}

// probe() as a string: "png 640x480", or "" for none (for tests).
probe_json(data: string) -> string {
    fmt, w, h = probe(data)
    if fmt == "" { return "" }
    return "${fmt} ${w}x${h}"
}

// A 640x480 PNG header, enough for probing and wire-encoding tests (it has NUL bytes).
sample_png() -> string {
    b = bytes.new(40)
    bytes.set_length(b, 29)
    m = [137, 80, 78, 71, 13, 10, 26, 10]
    i = 0
    while i < 8 {
        bytes.set(b, i, m[i])
        i = i + 1
    }
    bytes.set_be32(b, 8, 13)
    bytes.set(b, 12, 73)
    bytes.set(b, 13, 72)
    bytes.set(b, 14, 68)
    bytes.set(b, 15, 82)
    bytes.set_be32(b, 16, 640)
    bytes.set_be32(b, 20, 480)
    bytes.set(b, 24, 8)
    bytes.set(b, 25, 6)
    bytes.set(b, 26, 0)
    bytes.set(b, 27, 0)
    bytes.set(b, 28, 0)
    return bytes.finish(b, 29)
}

// ---- storage ------------------------------------------------------------

rejection(err: string) -> string {
    if err == "UnsupportedImage" { return "unsupported image: expected png, jpeg, gif or webp" }
    if err == "ImageTooLarge" { return "image is larger than 5 MB" }
    if err == "FileNotFound" { return "file not found" }
    return err
}

// The Image JSON object for a stored file.
image_json(path: string, name: string, media: string, size: long, width: long, height: long) -> string {
    return "{\"path\":${jsonx.quote(path)},\"name\":${jsonx.quote(name)},\"media_type\":${jsonx.quote(media)},\"bytes\":${size},\"width\":${width},\"height\":${height}}"
}

// `$home/sessions/<id>.images`: where a Session keeps its images.
image_dir(home: string, session_id: string) -> string {
    return "${home}/sessions/${session_id}.images"
}

// Copies `data` into `dir` (created on demand, 0700) under a content-hash
// name (files 0600) and returns (the Image JSON, ""), or ("", the error name):
// UnsupportedImage, ImageTooLarge, or the file system's.
store(dir: string, name: string, data: string) -> (string, string) {
    n = string.length(data)
    if n > MAX_BYTES { return "", "ImageTooLarge" }
    fmt, w, h = probe(data)
    if fmt == "" { return "", "UnsupportedImage" }
    hex, herr = cryptography.sha256_hex(string.bytes(data)[0..n])
    if herr != "" { return "", "Unexpected" }
    file = "${string.substring(hex, 0, 32)}.${extension(fmt)}"
    path = atomic_file.join(dir, file)
    mrc = sysgap.mkdir(dir, 448)
    if mrc != 0 {
        e = sysgap.errname(mrc)
        if e == "FileNotFound" {
            merr = fs.mkdir_p(dir)
            if string.length(merr) > 0 { return "", "AccessDenied" }
            sysgap.chmod(dir, 448)
        } else if e != "PathAlreadyExists" {
            return "", e
        }
    }
    st = sysgap.new_stat()
    present = 0
    if sysgap.stat(path, 1, st) == 0 && (st as *sysgap.Stat).size == (n as long) { present = 1 }
    if present == 0 {
        werr = atomic_file.replace(path, data, 384, 0, 0, null)
        if werr != "" { return "", werr }
    }
    return image_json(path, name, media_type(fmt), n as long, w, h), ""
}

// ---- reading an images array --------------------------------------------

// Number of Images in `images` (a JSON array text; "" is none).
count(images: string) -> int {
    if images == "" { return 0 }
    v = jsonx.parse(images)
    if v == null { return 0 }
    n = jsonx.array_size(v)
    jsonx.free(v)
    return n
}

// The i-th Image object as JSON text.
image_at(images: string, i: int) -> string {
    v = jsonx.parse(images)
    if v == null { return "" }
    out = jsonx.encode(jsonx.array_at(v, i))
    jsonx.free(v)
    return out
}

field_str_(image: string, key: string) -> string {
    v = jsonx.parse(image)
    if v == null { return "" }
    s = string.copy(jsonx.str_or(v, key, ""))
    jsonx.free(v)
    return s
}

field_long_(image: string, key: string) -> long {
    v = jsonx.parse(image)
    if v == null { return 0 as long }
    n = jsonx.long_or(v, key, 0 as long)
    jsonx.free(v)
    return n
}

name_of(image: string) -> string { return field_str_(image, "name") }
width_of(image: string) -> long { return field_long_(image, "width") }
height_of(image: string) -> long { return field_long_(image, "height") }
bytes_of(image: string) -> long { return field_long_(image, "bytes") }

omitted_text(image: string) -> string {
    return "[image ${name_of(image)} ${width_of(image)}×${height_of(image)} omitted]"
}

omitted_text_at(images: string, i: int) -> string { return omitted_text(image_at(images, i)) }

// What a request carries for the i-th image of `images`: (0, text, "") for a
// text placeholder (a model without vision, or a file that is gone), or
// (1, media type, base64) for the pixels. Reads and encodes the file on demand.
part_at(images: string, i: int, vision: int) -> (int, string, string) {
    image = image_at(images, i)
    if vision == 0 { return 0, omitted_text(image), "" }
    name = name_of(image)
    gone = "[image ${name} unavailable: file is gone]"
    path = field_str_(image, "path")
    st = sysgap.new_stat()
    if sysgap.stat(path, 1, st) != 0 { return 0, gone, "" }
    if (st as *sysgap.Stat).size > (MAX_BYTES as long) { return 0, gone, "" }
    data, n, rerr = fs.read_binary(path)
    if string.length(rerr) > 0 { return 0, gone, "" }
    if n == 0 { return 1, field_str_(image, "media_type"), "" }
    return 1, field_str_(image, "media_type"), encoding.base64_encode_padded(string.bytes(data)[0..n])
}

data_url(media: string, base64: string) -> string {
    return "data:${media};base64,${base64}"
}

// ---- a Run's attached images ----------------------------------------------

struct Attached {
    guard: ptr
    items: ptr      // list of Image JSON texts
}

new_attached() -> ptr {
    a = heap.new(Attached)
    a.guard = lock.new()
    a.items = list.list_new()
    return a as ptr
}

// 1 when stored; 0 once the Run holds MAX_PER_RUN.
attach(ap: ptr, image: string) -> int {
    a = ap as *Attached
    lock.acquire(a.guard)
    if list.list_size(a.items) >= MAX_PER_RUN {
        lock.release(a.guard)
        return 0
    }
    list.list_add(a.items, string.copy(image))
    lock.release(a.guard)
    return 1
}

attached_count(ap: ptr) -> int {
    a = ap as *Attached
    lock.acquire(a.guard)
    n = list.list_size(a.items)
    lock.release(a.guard)
    return n
}

// The attached images as a JSON array text ("" when none), emptying the list.
take(ap: ptr) -> string {
    a = ap as *Attached
    lock.acquire(a.guard)
    n = list.list_size(a.items)
    if n == 0 {
        lock.release(a.guard)
        return ""
    }
    b = strbuilder.new(256)
    strbuilder.append(b, "[")
    i = 0
    while i < n {
        item, _e = list.get_string(a.items, i)
        if i > 0 { strbuilder.append(b, ",") }
        strbuilder.append(b, item)
        i = i + 1
    }
    strbuilder.append(b, "]")
    a.items = list.list_new()
    lock.release(a.guard)
    return strbuilder.finish(b)
}

clear(ap: ptr) {
    a = ap as *Attached
    lock.acquire(a.guard)
    a.items = list.list_new()
    lock.release(a.guard)
}

free_attached(ap: ptr) {
    a = ap as *Attached
    lock.free(a.guard)
    heap.free(ap)
}

// What attaching needs: whether the model has vision, the data home and the
// Session id (where images are stored; "" id: no storage) and the Run's Attached.
struct Target {
    vision: int
    data_home: string
    session_id: string
    attached: ptr
}

new_target(vision: int, data_home: string, session_id: string, attached: @keep ptr) -> ptr {
    t = heap.new(Target)
    t.vision = vision
    t.data_home = data_home
    t.session_id = session_id
    t.attached = attached
    return t as ptr
}

// ---- pasted paths ---------------------------------------------------------

hex_val_(c: int) -> int {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    if c >= 65 && c <= 70 { return c - 55 }
    return -1
}

// The file path named by pasted text, as terminals produce on drag-and-drop:
// quoted, `file://` or with backslash-escaped characters. "" unless it names
// a supported image extension.
pasted_path(pasted: string) -> string {
    text = string.trim(pasted)
    if string.length(text) == 0 { return "" }
    if string.index_of(text, "\n") >= 0 || string.index_of(text, "\r") >= 0 { return "" }
    n = string.length(text)
    if n >= 2 {
        q = string.char_at(text, 0)
        if (q == 39 || q == 34) && string.char_at(text, n - 1) == q {
            text = string.substring(text, 1, n - 1)
            n = n - 2
        }
    }
    url = 0
    if string.starts_with(text, "file://") == 1 {
        url = 1
        text = string.substring(text, 7, n)
        n = n - 7
    }
    out = bytes.new(n + 1)
    k = 0
    i = 0
    while i < n {
        c = string.char_at(text, i)
        if c == 92 && url == 0 && i + 1 < n {
            i = i + 1
            bytes.set(out, k, string.char_at(text, i))
            k = k + 1
        } else if c == 37 && url == 1 && i + 2 < n && hex_val_(string.char_at(text, i + 1)) >= 0 && hex_val_(string.char_at(text, i + 2)) >= 0 {
            bytes.set(out, k, hex_val_(string.char_at(text, i + 1)) * 16 + hex_val_(string.char_at(text, i + 2)))
            k = k + 1
            i = i + 2
        } else {
            bytes.set(out, k, c)
            k = k + 1
        }
        i = i + 1
    }
    path = bytes.finish(out, k)
    base = atomic_file.basename(path)
    dot = -1
    j = 0
    while j < string.length(base) {
        if string.char_at(base, j) == 46 { dot = j }
        j = j + 1
    }
    if dot <= 0 { return "" }
    ext = string.to_lower(string.substring(base, dot, string.length(base)))
    if ext == ".png" || ext == ".jpg" || ext == ".jpeg" || ext == ".gif" || ext == ".webp" { return path }
    return ""
}
