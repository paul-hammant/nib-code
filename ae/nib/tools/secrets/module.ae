// tools.secrets: environment variable names stripped from child processes
// (upstream src/tools/secrets.zig).

import std.string
import std.list

exports(environment_names, is_secret, remove_from)

const NAMES[] = ["CODEX_ACCESS_TOKEN", "CODEX_REFRESH_TOKEN", "OPENAI_AUTH_TOKEN", "OPENAI_REFRESH_TOKEN",
                 "NIB_API_KEY", "CODEX_API_KEY", "DEEPSEEK_API_KEY", "OPENAI_API_KEY",
                 "ANTHROPIC_API_KEY", "OPENAI_ACCESS_TOKEN", "ANTHROPIC_AUTH_TOKEN", "AZURE_OPENAI_API_KEY",
                 "AZURE_OPENAI_KEY", "GEMINI_API_KEY", "GOOGLE_API_KEY", "GROQ_API_KEY",
                 "MISTRAL_API_KEY", "COHERE_API_KEY", "TOGETHER_API_KEY", "OPENROUTER_API_KEY",
                 "HF_TOKEN", "HUGGING_FACE_HUB_TOKEN", "GITHUB_TOKEN", "GH_TOKEN",
                 "GITLAB_TOKEN", "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN",
                 "AZURE_CLIENT_SECRET", "XAI_API_KEY"]

const NAME_COUNT = 30

// A fresh std.list of the names (strings); the caller frees it.
environment_names() -> ptr {
    out = list.list_new()
    i = 0
    while i < NAME_COUNT {
        list.list_add(out, NAMES[i])
        i = i + 1
    }
    return out
}

is_secret(name: string) -> int {
    i = 0
    while i < NAME_COUNT {
        if string.equals(NAMES[i], name) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// env: a list of "NAME=value" strings. Returns a new list without the secret names.
remove_from(env: ptr) -> ptr {
    out = list.list_new()
    n = list.list_size(env)
    i = 0
    while i < n {
        entry, _err = list.get_string(env, i)
        eq = string.index_of(entry, "=")
        name = entry
        if eq >= 0 { name = string.substring(entry, 0, eq) }
        if is_secret(name) == 0 { list.list_add(out, entry) }
        i = i + 1
    }
    return out
}
