// tools.registry: active bash commands, for supersession (upstream
// src/tools/bash/registry.zig, ADR 0016). A new identical command (same
// text and cwd, neither detached) from a later Run supersedes an active one
// once edit/write changed files after the old one started.

import std.list
import std.string
import std.sync
import std.os
import nib.lock

exports(Registry, Command, new, new_command, changed, revision, start, finish)

struct Command {
    id: string
    run: int
    command: string
    cwd: string
    detached: int
    revision: long
    started_ms: long
    cancel: ptr          // std.sync cell
    superseded_by: string
}

struct Registry {
    guard: ptr
    revision: long
    active: ptr          // list of *Command
}

new() -> ptr {
    r = heap.new(Registry)
    r.guard = lock.new()
    r.revision = 0
    r.active = list.list_new()
    return r as ptr
}

new_command(id: string, run: int, command: string, cwd: string, detached: int) -> ptr {
    c = heap.new(Command)
    c.id = id
    c.run = run
    c.command = command
    c.cwd = cwd
    c.detached = detached
    c.revision = 0
    c.started_ms = os.now_monotonic_ms()
    c.cancel = sync.atomic_new(0)
    c.superseded_by = ""
    return c as ptr
}

changed(rp: ptr) {
    r = rp as *Registry
    lock.acquire(r.guard)
    r.revision = r.revision + 1
    lock.release(r.guard)
}

revision(rp: ptr) -> long { return (rp as *Registry).revision }

replaces_(old: *Command, nw: *Command) -> int {
    if old.detached == 1 || nw.detached == 1 { return 0 }
    if old.superseded_by != "" { return 0 }
    if sync.atomic_load(old.cancel) != 0 { return 0 }
    if old.run >= nw.run { return 0 }
    if old.revision >= nw.revision { return 0 }
    if old.command != nw.command || old.cwd != nw.cwd { return 0 }
    return 1
}

start(rp: ptr, cp: @keep ptr) {
    r = rp as *Registry
    c = cp as *Command
    lock.acquire(r.guard)
    c.revision = r.revision
    n = list.list_size(r.active)
    i = 0
    while i < n {
        old = list.list_get_raw(r.active, i) as *Command
        if replaces_(old, c) == 1 {
            old.superseded_by = c.id
            sync.atomic_store(old.cancel, 1)
        }
        i = i + 1
    }
    list.list_add(r.active, cp)
    lock.release(r.guard)
}

// The id that superseded it, or "".
finish(rp: ptr, cp: ptr) -> string {
    r = rp as *Registry
    c = cp as *Command
    lock.acquire(r.guard)
    n = list.list_size(r.active)
    i = 0
    while i < n {
        if list.list_get_raw(r.active, i) == cp {
            list.list_remove(r.active, i)
            break
        }
        i = i + 1
    }
    s = c.superseded_by
    lock.release(r.guard)
    return s
}
