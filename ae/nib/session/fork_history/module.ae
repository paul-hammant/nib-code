// session.fork_history: a Step's history prefix for `tools.agent({fork:
// true})`, and the child's inherited copy of it (upstream
// src/session/history.zig, ADR 0015). Messages are the JSON texts nib.msg
// writes; a copy is a fresh string per message, so nothing the parent later
// changes in its own lists reaches a snapshot.

import std.list
import std.string
import nib.msg
import nib.provider.types

exports(snapshot, inherit)

// committed ++ pending, copied.
snapshot(committed: ptr, pending: ptr) -> ptr {
    out = list.list_new()
    i = 0
    while i < list.list_size(committed) {
        m, _g = list.get_string(committed, i)
        list.list_add(out, string.copy(m))
        i = i + 1
    }
    k = 0
    while k < list.list_size(pending) {
        m2, _g2 = list.get_string(pending, k)
        list.list_add(out, string.copy(m2))
        k = k + 1
    }
    return out
}

// The child's history: the fork's messages, each tool call without a result
// completed by a placeholder that says the parent keeps running it.
// (messages, "") or (null, "InvalidForkHistory").
inherit(history: ptr, message_count: int, fork_id: string, fork_session: string) -> (ptr, string) {
    n = list.list_size(history)
    if message_count != n || n == 0 { return null, "InvalidForkHistory" }
    first, _g = list.get_string(history, 0)
    if msg.role(first) != "system" { return null, "InvalidForkHistory" }
    out = list.list_new()
    i = 0
    while i < n {
        m, _g2 = list.get_string(history, i)
        r = msg.role(m)
        if i > 0 && r != "user" && r != "assistant" { return null, "InvalidForkHistory" }
        list.list_add(out, string.copy(m))
        i = i + 1
        calls = msg.tool_calls(m)
        k = 0
        while k < list.list_size(calls) {
            c = list.list_get_raw(calls, k) as *types.ToolCall
            paired = 0
            if i < n {
                next, _g3 = list.get_string(history, i)
                if msg.role(next) == "tool" { paired = 1 }
            }
            if paired == 1 {
                result, _g4 = list.get_string(history, i)
                if msg.str_or(result, "tool_call_id", "") != c.id { return null, "InvalidForkHistory" }
                list.list_add(out, string.copy(result))
                i = i + 1
            } else {
                list.list_add(out, msg.tool(c.id, "[forked as child agent ${fork_id} from session ${fork_session}; this tool call continues independently in the parent session; its result is not available in this child]", ""))
            }
            k = k + 1
        }
    }
    return out, ""
}
