// tui.clipboard: reads a PNG from the system clipboard with a shell script and
// a 2 s timeout (upstream src/tui/clipboard.zig).
//
// Differences from upstream:
//  - The test-only global `reader_override` is the `reader` field of a
//    Clipboard instance: new() sets it to the system reader and a spec
//    replaces it (`cb.reader = |env: ptr| {...}`, returning a *Result as ptr).
//    read_image(cb, env) calls it. Its argument is the env list.
//  - Result is a struct {kind, png, error} instead of a union: kind is one of
//    KIND_PNG (png holds the bytes), KIND_NO_TOOL, KIND_NO_IMAGE,
//    KIND_TOO_LARGE; `error` is "" or the spawn error upstream would raise.
//  - The script runs through nib.tools.process (output to a file, 2 s deadline,
//    killed with its group on timeout) because std.os has no timed capture;
//    that merges stderr into the output, so the Linux branches of the script
//    redirect the tool's stderr to /dev/null (upstream discards it separately).
//    `env` is a list of "NAME=value" or null (inherit).
//  - STAND-IN: upstream's image check is src/image.zig `probe` and `max_bytes`
//    (5 MB). Until nib.image is ported, MAX_BYTES and probe_png_ (an 8-byte
//    PNG signature check) are defined here; switch to nib.image then.
//  - read_script(script, env, timeout_ms) is the part below read_image, exposed
//    so the shell/exit-code/timeout handling can be tested with other scripts.

import std.string
import std.list
import nib.tools.process

exports(Result, Clipboard, KIND_PNG, KIND_NO_TOOL, KIND_NO_IMAGE, KIND_TOO_LARGE,
        MAX_BYTES, TIMEOUT_MS, SCRIPT, new, free, read_image, read_script)

// A stand-in for nib.image.max_bytes.
const MAX_BYTES = 5242880

const KIND_PNG = 0
const KIND_NO_TOOL = 1
const KIND_NO_IMAGE = 2
const KIND_TOO_LARGE = 3

// A hung clipboard tool must not freeze the UI; its child is killed and the read counts as no image.
const TIMEOUT_MS = 2000

const SCRIPT = "case \"$(uname)\" in
  Darwin)
    f=$(mktemp -t nibclip) || exit 1
    osascript -e 'on run argv' -e 'set d to the clipboard as «class PNGf»' -e 'set f to open for access POSIX file (item 1 of argv) with write permission' -e 'set eof f to 0' -e 'write d to f' -e 'close access f' -e 'end run' \"$f\" >/dev/null 2>&1 && cat \"$f\"
    status=$?
    rm -f \"$f\"
    exit $status ;;
  *)
    if [ -n \"$WAYLAND_DISPLAY\" ] && command -v wl-paste >/dev/null 2>&1; then exec wl-paste --type image/png 2>/dev/null
    elif command -v xclip >/dev/null 2>&1; then exec xclip -selection clipboard -t image/png -o 2>/dev/null
    fi
    exit 127 ;;
esac"

struct Result {
    kind: int
    png: string     // PNG bytes when kind is KIND_PNG
    error: string   // "" or why the script could not run
}

struct Clipboard {
    reader: fn      // |env: ptr| -> *Result as ptr
}

result_(kind: int, png: string, error: string) -> ptr {
    r = heap.new(Result)
    r.kind = kind
    r.png = png
    r.error = error
    return r as ptr
}

// STAND-IN for nib.image.probe: true for data starting with the PNG signature
// and no larger than MAX_BYTES.
probe_png_(data: string) -> int {
    n = string.length(data)
    if n < 8 || n > MAX_BYTES { return 0 }
    sig = [137, 80, 78, 71, 13, 10, 26, 10]
    i = 0
    while i < 8 {
        if (data[i] & 255) != sig[i] { return 0 }
        i = i + 1
    }
    return 1
}

// Runs `script` under /bin/sh with a deadline; see read_image for the results.
read_script(script: string, env: ptr, timeout_ms: long) -> ptr {
    argv = list.list_new()
    list.list_add(argv, "/bin/sh")
    list.list_add(argv, "-c")
    list.list_add(argv, script)
    pr = process.run(argv, env, null, null, timeout_ms, (MAX_BYTES + 1) as long) as *process.Result
    list.list_free(argv)
    if pr.error == "OutputLimit" { return result_(KIND_TOO_LARGE, "", "") }
    if pr.error != "" { return result_(KIND_NO_IMAGE, "", pr.error) }
    if pr.stop == process.STOP_TIMED_OUT { return result_(KIND_NO_IMAGE, "", "") }
    if pr.exit_code == 127 { return result_(KIND_NO_TOOL, "", "") }
    if pr.exit_code != 0 || probe_png_(pr.output) == 0 { return result_(KIND_NO_IMAGE, "", "") }
    return result_(KIND_PNG, pr.output, "")
}

// The system clipboard reader new() installs.
system_read_(env: ptr) -> ptr {
    return read_script(SCRIPT, env, TIMEOUT_MS as long)
}

new() -> *Clipboard {
    c = heap.new(Clipboard)
    c.reader = |env: ptr| { return system_read_(env) }
    return c
}

free(c: *Clipboard) { heap.free(c) }

// The PNG on the clipboard: a *Result (as ptr; the caller frees it with heap.free).
read_image(c: *Clipboard, env: ptr) -> ptr {
    ptr r = call(c.reader, env)
    return r
}
