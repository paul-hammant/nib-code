// Ports src/provider/timing.zig's tests, under their names, plus the
// attempt records the Step log carries.
import std.spec
import std.list
import std.longarr
import nib.provider.model_timing as mt
import nib.provider.types

call_(id: string, name: string) -> ptr {
    return types.tool_call_new(id, name, "{}")
}

main() {
    fw = spec.init()
    spec.describe(fw, "provider.timing") {
        spec.it("argument arrival samples cap at 1024 and finish at 32 with actual endpoints") callback {
            m = mt.new(0 as long)
            i = 0
            while i < 1024 {
                mt.arguments_at(m, 142, 3, (i + 20) as long)
                i = i + 1
            }
            s = mt.slot_at(m, 0) as *mt.ArgSlot
            spec.assert_eq(s.len, 1024, "cap reached")
            i = 1024
            while i < 10000 {
                b = 5
                if i % 2 == 0 { b = 1 }
                mt.arguments_at(m, 142, b, (i + 20) as long)
                spec.assert_true(s.len <= 1024, "never past the cap")
                i = i + 1
            }
            spec.assert_true(s.stride > (1 as long), "stride grew")
            spec.assert_eq_long(mt.point_ms(s as ptr, 0), 20, "first ms")
            spec.assert_eq_long(mt.point_bytes(s as ptr, 0), 3, "first bytes")
            spec.assert_eq_long(mt.point_ms(s as ptr, s.len - 1), 10019, "last ms")
            spec.assert_eq_long(mt.point_bytes(s as ptr, s.len - 1), 30000, "last bytes")
            k = 1
            while k < s.len {
                spec.assert_true(mt.point_ms(s as ptr, k) >= mt.point_ms(s as ptr, k - 1), "ms monotonic")
                spec.assert_true(mt.point_bytes(s as ptr, k) > mt.point_bytes(s as ptr, k - 1), "bytes increasing")
                k = k + 1
            }
            mt.arguments_at(m, 142, 1, 0 as long)
            mt.bind(m, 142, 0)
            calls = list.list_new()
            list.list_add(calls, call_("streamed", "run"))
            codes = mt.finish(m, calls)
            spec.assert_eq(list.list_size(codes), 1, "one code")
            code = list.list_get_raw(codes, 0) as *mt.Code
            spec.assert_eq(code.count, 32, "32 points")
            spec.assert_eq_long(code.first_ms, 20, "first_ms")
            spec.assert_eq_long(code.last_ms, 10019, "last_ms")
            spec.assert_eq_long(longarr_get_(code.progress, 0), 20, "p0 ms")
            spec.assert_eq_long(longarr_get_(code.progress, 1), 3, "p0 bytes")
            spec.assert_eq_long(longarr_get_(code.progress, 62), 10019, "p31 ms")
            spec.assert_eq_long(longarr_get_(code.progress, 63), 30001, "p31 bytes")
            j = 1
            while j < 32 {
                spec.assert_true(longarr_get_(code.progress, j * 2) >= longarr_get_(code.progress, (j - 1) * 2), "code ms monotonic")
                spec.assert_true(longarr_get_(code.progress, j * 2 + 1) > longarr_get_(code.progress, (j - 1) * 2 + 1), "code bytes increasing")
                j = j + 1
            }
            j = 0
            while j < 32 {
                at = j * (s.len - 1) / 31
                spec.assert_eq_long(longarr_get_(code.progress, j * 2), mt.point_ms(s as ptr, at), "sample ms")
                spec.assert_eq_long(longarr_get_(code.progress, j * 2 + 1), mt.point_bytes(s as ptr, at), "sample bytes")
                j = j + 1
            }
        }
        spec.it("attempt reset drops only argument slots and preserves the Step clock") callback {
            m = mt.new(777 as long)
            i = 0
            while i < 3000 {
                mt.arguments_at(m, 100, 9, (i + 10) as long)
                i = i + 1
            }
            mt.bind(m, 100, 1)
            mt.reset_attempt(m)
            mm = m as *mt.Model
            spec.assert_eq(mm.used, 0, "no slots")
            spec.assert_eq_long(mm.started_ms, 777, "clock kept")
            mt.arguments_at(m, 100, 2, 5000 as long)
            s = mt.slot_at(m, 0) as *mt.ArgSlot
            spec.assert_eq_long(s.bytes, 2, "bytes")
            spec.assert_eq_long(mt.point_ms(s as ptr, 0), 5000, "first point")
            spec.assert_eq(s.len, 1, "one point")
            spec.assert_eq_long(s.arrivals, 1, "arrivals")
            spec.assert_eq_long(s.stride, 1, "stride")
            spec.assert_eq(s.call_index, -1, "unbound")
        }
        spec.it("sparse indices final-only fallback and run filtering") callback {
            m = mt.new(0 as long)
            mt.arguments_at(m, 200, 2, 10 as long)
            mt.arguments_at(m, 200, 3, 20 as long)
            mt.final_arguments_at(m, 200, 5, 80 as long)
            mt.bind(m, 200, 1)
            mt.final_arguments_at(m, 150, 8, 30 as long)
            mt.bind(m, 150, 0)
            mt.final_arguments_at(m, 201, 9, 40 as long)
            mt.bind(m, 201, 2)
            calls = list.list_new()
            list.list_add(calls, call_("final", "run"))
            list.list_add(calls, call_("streamed", "run"))
            list.list_add(calls, call_("other", "search"))
            codes = mt.finish(m, calls)
            spec.assert_eq(list.list_size(codes), 2, "two run codes")
            a = list.list_get_raw(codes, 0) as *mt.Code
            spec.assert_str_eq(a.tool_call_id, "final", "first id")
            spec.assert_eq_long(a.first_ms, 30, "final first")
            spec.assert_eq_long(a.last_ms, 30, "final last")
            spec.assert_eq(a.count, 1, "one point")
            spec.assert_eq_long(longarr_get_(a.progress, 1), 8, "final bytes")
            b = list.list_get_raw(codes, 1) as *mt.Code
            spec.assert_str_eq(b.tool_call_id, "streamed", "second id")
            spec.assert_eq(b.count, 2, "two points")
            spec.assert_eq_long(longarr_get_(b.progress, 0), 10, "p0 ms")
            spec.assert_eq_long(longarr_get_(b.progress, 1), 2, "p0 bytes")
            spec.assert_eq_long(longarr_get_(b.progress, 2), 20, "p1 ms")
            spec.assert_eq_long(longarr_get_(b.progress, 3), 5, "p1 bytes")
            spec.assert_str_eq(mt.code_json(codes), "[{\"tool_call_id\":\"final\",\"first_ms\":30,\"last_ms\":30,\"progress\":[[30,8]]},{\"tool_call_id\":\"streamed\",\"first_ms\":10,\"last_ms\":20,\"progress\":[[10,2],[20,5]]}]", "code json")
        }
        spec.it("fixed slots cover all accepted chat indices and ignore excess safely") callback {
            m = mt.new(0 as long)
            i = 0
            while i < 66 {
                mt.arguments_at(m, i + 100, 1, i as long)
                i = i + 1
            }
            spec.assert_eq((m as *mt.Model).used, 65, "65 slots")
            spec.assert_eq((mt.slot_at(m, 64) as *mt.ArgSlot).index, 164, "last index")
            mt.arguments_at(m, 100, 1, 100 as long)
            spec.assert_eq_long((mt.slot_at(m, 0) as *mt.ArgSlot).bytes, 2, "first slot still counts")
        }
        spec.it("byte gaps exclude first wait and reset between attempts") callback {
            m = mt.new(0 as long)
            mm = m as *mt.Model
            spec.assert_eq_long(mm.max_gap_ms, -1, "none")
            mt.received_at(m, 10000 as long)
            spec.assert_eq_long(mm.max_gap_ms, -1, "first wait is no gap")
            mt.received_at(m, 10015 as long)
            mt.received_at(m, 10015 as long)
            mt.received_at(m, 10030 as long)
            spec.assert_eq_long(mm.max_gap_ms, 15, "15")
            mt.received_at(m, 10100 as long)
            spec.assert_eq_long(mm.max_gap_ms, 70, "70")
            mt.reset_attempt(m)
            spec.assert_eq_long(mm.max_gap_ms, -1, "reset")
            mt.received_at(m, 50000 as long)
            mt.received_at(m, 50000 as long)
            spec.assert_eq_long(mm.max_gap_ms, 0, "zero gap is a gap")
        }
        spec.it("attempt records keep failed attempts and the final attempt's gaps") callback {
            m = mt.new(0 as long)
            mm = m as *mt.Model
            mt.received_at(m, 5 as long)
            mt.received_at(m, 25 as long)
            mm.bytes = 12 as long
            mt.finish_attempt(m, 0 as long, "StreamIdleTimeout", "Stream idle timeout after 1s without receiving bytes.")
            mt.reset_attempt(m)
            mt.received_at(m, 1000 as long)
            mt.received_at(m, 1040 as long)
            mm.bytes = 7 as long
            mm.content_bytes = 3 as long
            mm.first_content_ms = 1000 as long
            mm.last_content_ms = 1040 as long
            mm.max_content_gap_ms = 40 as long
            mt.finish_attempt(m, 900 as long, "", "")
            spec.assert_eq(mt.attempt_count(m), 2, "two attempts")
            a = mt.attempt_at(m, 0) as *mt.Attempt
            spec.assert_str_eq(a.error_name, "StreamIdleTimeout", "error")
            spec.assert_eq_long(a.max_gap_ms, 20, "failed attempt gap")
            spec.assert_eq_long(a.bytes, 12, "failed bytes")
            spec.assert_eq_long(mm.max_gap_ms, 40, "final gap only")
            j = mt.attempts_json(m)
            spec.assert_contains(j, "\"error_name\":\"StreamIdleTimeout\",\"detail\":\"Stream idle timeout after 1s", "error and detail")
            spec.assert_contains(j, "\"transport\":\"sse\",\"incremental\":false,\"bytes\":7,\"content_bytes\":3,\"first_content_ms\":1000,\"last_content_ms\":1040,\"max_content_gap_ms\":40,\"max_gap_ms\":40}", "second attempt members in order")
        }
    }
    return spec.run_summary(fw)
}

longarr_get_(p: ptr, i: int) -> long { return longarr.longarr_get_raw(p, i) }
