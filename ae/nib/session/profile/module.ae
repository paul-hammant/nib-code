// session.profile: model-family behavior, chosen from the model name rather
// than the provider (upstream src/session/profile.zig, ADR 0025), so a custom
// endpoint serving `deepseek-flash` gets DEEPSEEK.
//
// A profile is an int; a Set (upstream std.EnumSet(Profile)) is a bit mask.

import std.string

exports(CODEX, DEEPSEEK, CLAUDE, DEFAULT, ALL, for_model, bit, set_contains, set_of, set_without, name)

const CODEX = 0
const DEEPSEEK = 1
const CLAUDE = 2
const DEFAULT = 3
const ALL = 15          // every profile (upstream Profile.all)

// The Set holding just `profile`.
bit(profile: int) -> int { return 1 << profile }

set_contains(set: int, profile: int) -> int {
    if (set & bit(profile)) != 0 { return 1 }
    return 0
}

set_of(profile: int) -> int { return bit(profile) }

// `set` minus `profile`.
set_without(set: int, profile: int) -> int { return set & (15 - bit(profile)) }

name(profile: int) -> string {
    match profile {
        0 -> { return "codex" }
        1 -> { return "deepseek" }
        2 -> { return "claude" }
        _ -> { return "default" }
    }
}

lower_(s: string) -> string { return string.to_lower(s) }

starts_fold_(text: string, prefix: string) -> int {
    return string.starts_with(lower_(text), prefix)
}

// The profile for a model name; a leading "vendor/" is ignored.
for_model(model: string) -> int {
    n = string.length(model)
    start = 0
    i = n - 1
    while i >= 0 {
        if string.char_at(model, i) == 47 {
            start = i + 1
            break
        }
        i = i - 1
    }
    short = string.substring(model, start, n)
    if starts_fold_(short, "gpt-") == 1 || starts_fold_(short, "codex") == 1 { return CODEX }
    if starts_fold_(short, "deepseek-") == 1 { return DEEPSEEK }
    if starts_fold_(short, "claude-") == 1 { return CLAUDE }
    return DEFAULT
}
