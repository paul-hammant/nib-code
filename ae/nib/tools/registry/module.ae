// tools.registry: active bash commands, for supersession (upstream
// src/tools/bash/registry.zig, ADR 0016). A new identical command (same
// text and cwd, neither detached) from a later Run supersedes an active one
// once edit/write changed files after the old one started.

import std.list
import std.string
import std.sync
import std.os hiding (exec, run_capture, run_pipe, run_pipe_drain_and_wait, run_socket,
    run_stdio, run_full, run_supervised, spawn_proc, spawn_proc_to, os_system,
    os_exec_raw, os_execv, os_run, os_run_capture_raw, os_run_capture_status_raw,
    os_run_pipe_raw, os_run_pipe_drain_and_wait_raw, os_run_socket_raw,
    os_run_stdio_raw, os_run_full_raw, os_run_supervised_raw, os_spawn_raw,
    os_spawn_to_raw)
import nib.lock
import nib.jsonx

exports(Registry, Command, new, new_command, changed, revision, replaces, start, finish, set_log)

struct Command {
    id: string
    run: int
    command: string
    cwd: string
    detached: int
    revision: long
    started_ms: long
    cancel: ptr          // std.sync cell
    superseded_by: string
}

struct Registry {
    guard: ptr
    revision: long
    active: ptr          // list of *Command
    has_log: int
    log_ctx: ptr
    log_fn: fn           // |ctx: ptr, members: string|: a session-log record's members
}

new() -> ptr {
    r = heap.new(Registry)
    r.guard = lock.new()
    r.revision = 0
    r.active = list.list_new()
    r.has_log = 0
    r.log_ctx = null
    r.log_fn = |ctx: ptr, members: string| {}
    return r as ptr
}

// Bash start/supersede/finish events go to the session log through fn.
set_log(rp: ptr, ctx: @keep ptr, f: @keep fn) {
    r = rp as *Registry
    r.log_ctx = ctx
    r.log_fn = f
    r.has_log = 1
}

elapsed_(c: *Command) -> long { return os.now_monotonic_ms() - c.started_ms }

log_(r: *Registry, event: string) {
    if r.has_log == 0 { return }
    call(r.log_fn, r.log_ctx, ",\"bash\":${event}")
}

new_command(id: string, run: int, command: string, cwd: string, detached: int) -> ptr {
    c = heap.new(Command)
    c.id = id
    c.run = run
    c.command = command
    c.cwd = cwd
    c.detached = detached
    c.revision = 0
    c.started_ms = os.now_monotonic_ms()
    c.cancel = sync.atomic_new(0)
    c.superseded_by = ""
    return c as ptr
}

changed(rp: ptr) {
    r = rp as *Registry
    lock.acquire(r.guard)
    r.revision = r.revision + 1
    lock.release(r.guard)
}

revision(rp: ptr) -> long { return (rp as *Registry).revision }

replaces(old: *Command, nw: *Command) -> int {
    if old.detached == 1 || nw.detached == 1 { return 0 }
    if old.superseded_by != "" { return 0 }
    if sync.atomic_load(old.cancel) != 0 { return 0 }
    if old.run >= nw.run { return 0 }
    if old.revision >= nw.revision { return 0 }
    if old.command != nw.command || old.cwd != nw.cwd { return 0 }
    return 1
}

start(rp: ptr, cp: @keep ptr) {
    r = rp as *Registry
    c = cp as *Command
    lock.acquire(r.guard)
    detached = "false"
    if c.detached == 1 { detached = "true" }
    log_(r, "{\"id\":${jsonx.quote(c.id)},\"run\":${c.run},\"state\":\"started\",\"command\":${jsonx.quote(c.command)},\"cwd\":${jsonx.quote(c.cwd)},\"detached\":${detached}}")
    c.revision = r.revision
    n = list.list_size(r.active)
    i = 0
    while i < n {
        old = list.list_get_raw(r.active, i) as *Command
        if replaces(old, c) == 1 {
            log_(r, "{\"id\":${jsonx.quote(old.id)},\"run\":${old.run},\"state\":\"superseded\",\"superseded_by\":${jsonx.quote(c.id)},\"elapsed_ms\":${elapsed_(old)}}")
            old.superseded_by = c.id
            sync.atomic_store(old.cancel, 1)
        }
        i = i + 1
    }
    list.list_add(r.active, cp)
    lock.release(r.guard)
}

// The id that superseded it, or "".
finish(rp: ptr, cp: ptr) -> string {
    r = rp as *Registry
    c = cp as *Command
    lock.acquire(r.guard)
    n = list.list_size(r.active)
    i = 0
    while i < n {
        if list.list_get_raw(r.active, i) == cp {
            list.list_remove(r.active, i)
            break
        }
        i = i + 1
    }
    s = c.superseded_by
    log_(r, "{\"id\":${jsonx.quote(c.id)},\"run\":${c.run},\"state\":\"finished\",\"elapsed_ms\":${elapsed_(c)}}")
    lock.release(r.guard)
    return s
}
