// Ports the tests of upstream src/tools/search.zig (a2dd439) that exercise the
// grep and glob entries. Upstream drives them through a full Tools value
// (callTool); here the entries are called directly with the credential path
// list a Tools would compute. The two tests that go through the sandbox's JS
// wrapper (RegExp literals, and the host's error text) are ported at the
// entry: string patterns and the error text the host would receive.
import std.spec
import std.string
import std.list
import std.fs
import std.strbuilder
import std.json
import nib.jsonx
import nib.tools.search

tmp_dir_() -> string {
    d, err = fs.make_temp_dir("", "nibsearch")
    spec.assert_str_eq(err, "", "make_temp_dir")
    return d
}

put_(path: string, data: string) {
    h, err = fs.open(path, "wb")
    spec.assert_str_eq(err, "", "open ${path}")
    fs.file_write_raw(h, data, string.length(data))
    fs.close(h)
}

rep_(text: string, count: int) -> string {
    sb = strbuilder.new(string.length(text) * count + 8)
    i = 0
    while i < count {
        strbuilder.append(sb, text)
        i = i + 1
    }
    return strbuilder.finish(sb)
}

utf8_valid_(s: string) -> int {
    n = string.length(s)
    i = 0
    while i < n {
        c = string.char_at(s, i)
        need = 0
        if c < 128 {
            need = 0
        } else if c >= 194 && c <= 223 {
            need = 1
        } else if c >= 224 && c <= 239 {
            need = 2
        } else if c >= 240 && c <= 244 {
            need = 3
        } else {
            return 0
        }
        if need > 0 && i + need > n - 1 { return 0 }
        k = 1
        while k <= need {
            if (string.char_at(s, i + k) & 192) != 128 { return 0 }
            k = k + 1
        }
        i = i + need + 1
    }
    return 1
}

contains_(s: string, part: string) -> int { return string.contains(s, part) }

main() {
    fw = spec.init()
    spec.describe(fw, "tools.search") {
        spec.it("grep and glob never surface credential files") callback {
            root = tmp_dir_()
            fs.mkdir_p("${root}/.codex")
            put_("${root}/.codex/auth.json", "{\"token\":\"fake-secret\"}")
            put_("${root}/notes.json", "{\"token\":\"public\"}")
            home, _k, _m = fs.realpath(root)
            creds = list.list_new()
            list.list_add(creds, "${home}/.codex/auth.json")

            ok, found = search.grep("{\"pattern\":\"token\",\"path\":${jsonx.quote(root)}}", creds, null)
            spec.assert_eq(ok, 1, "grep ok")
            spec.assert_true(contains_(found, "public"), "public found")
            spec.assert_false(contains_(found, "fake-secret"), "secret never surfaces")

            ok2, listed = search.glob("{\"pattern\":\"*.json\",\"path\":${jsonx.quote(root)}}", creds, null)
            spec.assert_eq(ok2, 1, "glob ok")
            spec.assert_true(contains_(listed, "notes.json"), "notes listed")
            spec.assert_false(contains_(listed, "auth.json"), "credential not listed")

            ok3, direct = search.grep("{\"pattern\":\"token\",\"path\":${jsonx.quote("${root}/.codex/auth.json")}}", creds, null)
            spec.assert_eq(ok3, 0, "direct grep fails")
            spec.assert_str_eq(direct, "CredentialAccessDenied", "direct credential grep is denied")
            list.list_free(creds)
            fs.remove_tree(root)
        }
        spec.it("grep serializes match byte column and clipped text") callback {
            root = tmp_dir_()
            path = "${root}/long.jsonl"
            put_(path, "${rep_("a", 6000)}中SyntaxError")
            ok, text = search.grep("{\"pattern\":\"SyntaxError\",\"path\":${jsonx.quote(path)}}", null, null)
            spec.assert_eq(ok, 1, "ok")
            doc = jsonx.parse(text)
            matches = jsonx.field(doc, "matches")
            spec.assert_eq(json.json_array_size(matches), 1, "one match")
            m = json.json_array_get_raw(matches, 0)
            spec.assert_eq(jsonx.int_or(m, "column", 0), 6004, "byte column")
            spec.assert_eq(jsonx.int_or(m, "line", 0), 1, "line")
            spec.assert_false(contains_(text, "text_column"), "no text_column field")
            snippet = jsonx.str_or(m, "text", "")
            spec.assert_eq(string.length(snippet), 500, "text is 500 bytes")
            spec.assert_true(utf8_valid_(snippet), "valid utf-8")
            spec.assert_true(string.ends_with(snippet, "中SyntaxError"), "ends with the hit")
            spec.assert_true(string.starts_with(snippet, "…"), "starts with a marker")
            spec.assert_false(contains_(text, "\"before\""), "no context: no before")
            jsonx.free(doc)
            fs.remove_tree(root)
        }
        spec.it("grep string patterns are regular expressions and ignore_case folds only when asked") callback {
            root = tmp_dir_()
            path = "${root}/f"
            put_(path, "x.reserve(\nX.RESERVE(\nareserve(\n")
            q = jsonx.quote(path)
            ok, literal = search.grep("{\"pattern\":\"\\\\.reserve\\\\(\",\"path\":${q}}", null, null)
            spec.assert_eq(ok, 1, "ok")
            spec.assert_eq(json.json_array_size(jsonx.field(jsonx.parse(literal), "matches")), 1, "escaped dot matches only x.reserve(")
            ok2, folded = search.grep("{\"pattern\":\"X\",\"ignore_case\":true,\"path\":${q}}", null, null)
            spec.assert_eq(ok2, 1, "ok2")
            spec.assert_eq(json.json_array_size(jsonx.field(jsonx.parse(folded), "matches")), 2, "ignore_case folds")
            ok3, exact = search.grep("{\"pattern\":\"X\",\"ignore_case\":false,\"path\":${q}}", null, null)
            spec.assert_eq(ok3, 1, "ok3")
            spec.assert_eq(json.json_array_size(jsonx.field(jsonx.parse(exact), "matches")), 1, "case sensitive")
            fs.remove_tree(root)
        }
        spec.it("grep invalid JS string pattern reports what the host received") callback {
            ok, text = search.grep("{\"pattern\":\".a(\"}", null, null)
            spec.assert_eq(ok, 0, "fails")
            spec.assert_true(contains_(text, "invalid pattern \".a(\": expecting ')'"), "message: ${text}")
        }
        spec.it("grep invalid pattern preview is JSON quoted and bounded to 200 UTF-8 bytes") callback {
            units = ["a", "中"]
            ui = 0
            while ui < 2 {
                unit = units[ui]
                pattern = "${rep_(unit, 201)}("
                ok, text = search.grep("{\"pattern\":${jsonx.quote(pattern)}}", null, null)
                spec.assert_eq(ok, 0, "fails")
                end = 200
                if ui == 1 { end = 198 }
                expected = "invalid pattern ${jsonx.quote(string.substring(pattern, 0, end))}:"
                spec.assert_true(string.starts_with(text, expected), "preview prefix ${ui}")
                spec.assert_true(utf8_valid_(text), "valid utf-8 ${ui}")
                ui = ui + 1
            }
            ok2, quoted = search.grep("{\"pattern\":\"\\\"\\n(\"}", null, null)
            spec.assert_eq(ok2, 0, "fails")
            spec.assert_true(string.starts_with(quoted, "invalid pattern \"\\\"\\n(\":"), "quoted preview: ${quoted}")
        }
        spec.it("argument validation and defaults use the upstream texts") callback {
            ok, t = search.grep("{\"path\":\".\"}", null, null)
            spec.assert_eq(ok, 0, "no pattern")
            spec.assert_str_eq(t, "expected { pattern: string, path?: string, glob?: string, ignore_case?: boolean, literal?: boolean, context?: number, limit?: number }", "grep usage")
            ok2, t2 = search.glob("{\"pattern\":3}", null, null)
            spec.assert_eq(ok2, 0, "bad pattern")
            spec.assert_str_eq(t2, "expected { pattern: string, path?: string, limit?: number }", "glob usage")
            ok3, t3 = search.grep("{\"pattern\":\"x\",\"limit\":-1}", null, null)
            spec.assert_eq(ok3, 0, "negative limit")
            ok4, t4 = search.grep("{\"pattern\":\"x\",\"path\":\"/nonexistent-nib-dir\"}", null, null)
            spec.assert_eq(ok4, 0, "missing path")
            spec.assert_str_eq(t4, "/nonexistent-nib-dir: FileNotFound", "path error text")
        }
        spec.it("glob limits, truncation and ./ prefixes") callback {
            root = tmp_dir_()
            put_("${root}/a.txt", "")
            put_("${root}/b.txt", "")
            put_("${root}/c.md", "")
            q = jsonx.quote(root)
            ok, t = search.glob("{\"pattern\":\"./*.txt\",\"path\":${q},\"limit\":1}", null, null)
            spec.assert_eq(ok, 1, "ok")
            spec.assert_str_eq(t, "{\"paths\":[${jsonx.quote("${root}/a.txt")}],\"truncated\":true}", "limited")
            ok2, t2 = search.glob("{\"pattern\":\"*.txt\",\"path\":${q}}", null, null)
            spec.assert_str_eq(t2, "{\"paths\":[${jsonx.quote("${root}/a.txt")},${jsonx.quote("${root}/b.txt")}],\"truncated\":false}", "all")
            fs.remove_tree(root)
        }
    }
    return spec.run_summary(fw)
}
