// The Aether port's unit tests: one program per file under ae/tests/, each
// a std.spec suite that exits non-zero on a failure. Upstream's Python
// end-to-end tests (tests/*.py) drive a full nib and wait for the session
// slices; PORT_STATUS.md lists which of them apply to what is ported.

import bldr
import aether
import aether (source, lib, caps)
import bldr (dep)
import bash
import bash (script)

aeb(cap) {
    bldr.build() {
        aether.program_test() {
            source("ae/tests/console_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/timing_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/sandbox_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/timer_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/policy_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/secrets_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/diff_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/changes_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/walk_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/grep_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/search_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/atomic_file_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/jail_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/file_state_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/files_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/process_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/bash_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/registry_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/tools_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/background_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/config_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/auth_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/session_output_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/tool_summary_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/prompt_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/responses_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/openai_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/session_log_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/provider_timing_test.ae")
            lib("ae")
        }
        aether.program_test() {
            source("ae/tests/undo_test.ae")
            lib("ae")
        }
        // Workspace mode end to end, through the built binary.
        dep(".build.ae")
        bash.test() {
            script("ae/tests/workspace.sh")
            script("tools/check_layers.sh")
        }
        return 0
    }
}
