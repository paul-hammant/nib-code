                i = i + 1
            }
        }
        spec.it("model arguments and configuration preserve comments and sections") callback {
            p, m, err = config.parse_model("openai/gpt-test")
            spec.assert_true(p == "openai" && m == "gpt-test" && err == "", "slash form")
            p2, m2, _e2 = config.parse_model("openai gpt-test")
            spec.assert_true(p2 == "openai" && m2 == "gpt-test", "space form")
            p3, m3, _e3 = config.parse_model("openai")
            spec.assert_true(p3 == "openai" && m3 == "", "provider only")
            bad = ["", "/model", "openai/", "openai a b", "openai/a b", "   "]
            i = 0
            while i < 6 {
                _p, _m, be = config.parse_model(bad[i])
                spec.assert_str_eq(be, "InvalidModelArgument", "bad argument '${bad[i]}'")
                i = i + 1
            }
            text = "# header\nprovider = \"deepseek\" # keep\n[openai] # section\nmodel = \"old\" # model\n[skills]\nx = true\n"
            updated, uerr = config.model_text(text, "openai", "new")
            spec.assert_str_eq(uerr, "", "no error")
            spec.assert_str_eq(updated, "# header\nprovider = \"openai\" # keep\n[openai] # section\nmodel = \"new\" # model\n[skills]\nx = true\n", "rewritten in place")
            fresh, _e4 = config.model_text("", "openai", "new")
            spec.assert_str_eq(fresh, "provider = \"openai\"\n[openai]\nmodel = \"new\"\n", "from nothing")
            custom = "[providers.local]\nprotocol = \"responses\"\nbase_url = \"http://localhost\"\nmodel = \"old\" # keep\ncontext_window = 1000\n"
            changed, _e5 = config.model_text(custom, "local", "new")
            spec.assert_true(contains_(changed, "model = \"new\" # keep") == 1, "custom model")
            spec.assert_true(contains_(changed, "[providers.local]") == 1, "custom section")
            _x, xerr = config.model_text("broken", "openai", "new")
            spec.assert_str_eq(xerr, "InvalidConfig", "invalid file refused")
        }
        spec.it("model entries list only the current service and saving is atomic") callback {
            d = tmp_()
            e = env.new()
            env.set(e, "HOME", d)
            custom = "[providers.local]\nprotocol = \"responses\"\nbase_url = \"http://localhost\"\nmodel = \"old\"\ncontext_window = 1000\n[providers.locked]\nprotocol = \"responses\"\nbase_url = \"http://localhost\"\nmodel = \"old\"\ncontext_window = 1000\napi_key_env = \"SITE_KEY\"\n"
            fs.write("${d}/config.toml", custom)
            ae = env.clone(e)
            env.set(ae, "NIB_PROVIDER", "anthropic")
            anthropic = ok_(ae, custom)
            own, oerr = config.model_entries(d, anthropic)
            spec.assert_str_eq(oerr, "", "entries")
            spec.assert_eq(list.list_size(own), 4, "anthropic's catalog")
            i = 0
            while i < 4 {
                spec.assert_str_eq((list.list_get_raw(own, i) as *config.ModelEntry).provider, "anthropic", "entry ${i} provider")
                i = i + 1
            }
            le = env.clone(e)
            env.set(le, "NIB_PROVIDER", "local")
            local = ok_(le, custom)
            listed, _e2 = config.model_entries(d, local)
            spec.assert_eq(list.list_size(listed), 1, "custom lists its model")
            spec.assert_str_eq((list.list_get_raw(listed, 0) as *config.ModelEntry).model, "old", "old")
            saved_cfg, serr, _d3 = config.save_model(e, d, "local", "new")
            spec.assert_str_eq(serr, "", "saved")
            spec.assert_str_eq(cfg_(saved_cfg).model, "new", "returned config")
            saved = read_("${d}/config.toml")
            spec.assert_true(string.starts_with(saved, "provider = \"local\"\n"), "provider first")
            spec.assert_true(contains_(saved, "model = \"new\"") == 1, "model written")
            spec.assert_true(contains_(saved, "[providers.locked]") == 1, "other sections kept")
            env.set(e, "OPENAI_API_KEY", "fake")
            _c, berr, bd = config.save_model(e, d, "openai", "unknown")
            spec.assert_str_eq(berr, "InvalidConfig", "unknown model refused")
            spec.assert_true(contains_(bd, "unknown model context window") == 1, "refusal detail")
            spec.assert_str_eq(read_("${d}/config.toml"), saved, "file untouched by the refusal")
            new_home = "${d}/new"
            _c2, nerr, _d4 = config.save_model(e, new_home, "openai", "")
            spec.assert_str_eq(nerr, "", "new home")
            spec.assert_str_eq(read_("${new_home}/config.toml"), "provider = \"openai\"\n[openai]\nmodel = \"gpt-6.1-sol\"\n", "created")
            spec.assert_eq(mode_("${new_home}/config.toml"), 384, "0600")
            cc = env.clone(e)
            env.set(cc, "NIB_PROVIDER", "chat_completions")
            fs.write("${d}/chat.toml", "")
            _c3, cerr, _d5 = config.save_model(e, "${d}/chat", "chat_completions", "other-model")
            spec.assert_str_eq(cerr, "UnknownModelContextWindow", "chat_completions needs a window for a new model")
            fs.remove_tree(d)
        }
        spec.it("startup picks the first credentialed service without persisting") callback {
            d = tmp_()
            e = env_home_(d)
            cp, err, _x = config.load(e, d)
            spec.assert_str_eq(err, "", "loads")
            spec.assert_str_eq(cfg_(cp).provider, "anthropic", "the default stays")
            spec.assert_eq(config.credentialed(cp), 0, "not credentialed")
            fs.write("${d}/auth.json", "{\"keys\":{\"xai\":\"stored-fake\"}}")
            cp, _e1, _x1 = config.load(e, d)
            spec.assert_str_eq(cfg_(cp).provider, "xai", "stored xAI key")
            spec.assert_str_eq(cfg_(cp).key_source, "store", "from the store")
            spec.assert_str_eq(cfg_(cp).api_key, "stored-fake", "the key")
            env.set(e, "OPENAI_API_KEY", "env-fake")
            cp, _e2, _x2 = config.load(e, d)
            spec.assert_str_eq(cfg_(cp).provider, "openai", "OpenAI before xAI")
            spec.assert_str_eq(cfg_(cp).key_source, "env", "from the environment")
            env.set(e, "ANTHROPIC_API_KEY", "env-fake")
            cp, _e3, _x3 = config.load(e, d)
            spec.assert_str_eq(cfg_(cp).provider, "anthropic", "Anthropic first")
            // A configured service that is credentialed wins over the order; an explicit NIB_PROVIDER is never replaced.
            fs.write("${d}/config.toml", "provider = \"deepseek\"\n")
            cp, _e4, _x4 = config.load(e, d)
            spec.assert_str_eq(cfg_(cp).provider, "anthropic", "configured but uncredentialed: pick")
            env.set(e, "DEEPSEEK_API_KEY", "env-fake")
            cp, _e5, _x5 = config.load(e, d)
            spec.assert_str_eq(cfg_(cp).provider, "deepseek", "configured and credentialed")
            env.set(e, "NIB_PROVIDER", "xai")
            fs.write("${d}/auth.json", "{}")
            cp, _e6, _x6 = config.load(e, d)
            spec.assert_str_eq(cfg_(cp).provider, "xai", "explicit provider kept")
            spec.assert_eq(config.credentialed(cp), 0, "and not credentialed")
            spec.assert_str_eq(read_("${d}/config.toml"), "provider = \"deepseek\"\n", "nothing persisted")
            fs.remove_tree(d)
        }
        spec.it("custom services come last and a stored key serves a keyless config") callback {
            d = tmp_()
            e = env_home_(d)
            fs.write("${d}/config.toml", "[providers.site]\nprotocol = \"chat_completions\"\nbase_url = \"http://h\"\nmodel = \"m\"\ncontext_window = 9\napi_key_env = \"SITE_KEY\"\n")
            cp, _e0, _x0 = config.load(e, d)
            spec.assert_str_eq(cfg_(cp).provider, "anthropic", "no credentials: the default stays")
            fs.write("${d}/auth.json", "{\"keys\":{\"site\":\"stored-fake\"}}")
            cp, _e1, _x1 = config.load(e, d)
            spec.assert_str_eq(cfg_(cp).provider, "custom", "custom picked")
            spec.assert_str_eq(types.name(cp), "site", "named site")
            spec.assert_str_eq(cfg_(cp).api_key, "stored-fake", "stored key")
            spec.assert_str_eq(types.key_hint(cp), "the key stored by nib (run nib login)", "hint")
            env.set(e, "SITE_KEY", "env-fake")
            cp, _e2, _x2 = config.load(e, d)
            spec.assert_str_eq(cfg_(cp).api_key, "env-fake", "environment wins over the store")
            spec.assert_str_eq(cfg_(cp).key_source, "env", "source")
            fs.remove_tree(d)
        }
        spec.it("adding an endpoint appends one section and validates ids") callback {
            d = tmp_()
            fs.write("${d}/config.toml", "# keep\neffort = \"high\"")
            spec.assert_str_eq(config.add_endpoint(d, "my-site", "chat_completions", "https://x.example/v1", "m\"1", 128000 as long), "", "added")
            text = read_("${d}/config.toml")
            spec.assert_true(string.starts_with(text, "# keep\neffort = \"high\"\n\n[providers.my-site]\nprotocol = \"chat_completions\"\n"), "appended: ${text}")
            found, ferr = config.custom_providers(d)
            spec.assert_str_eq(ferr, "", "listed")
            spec.assert_eq(list.list_size(found), 1, "one custom")
            cu = list.list_get_raw(found, 0) as *config.Custom
            spec.assert_str_eq(cu.model, "m\"1", "model round trips")
            spec.assert_str_eq(cu.id, "my-site", "id")
            spec.assert_eq(cu.context_window as int, 128000, "window")
            spec.assert_str_eq(config.add_endpoint(d, "my-site", "responses", "http://h", "m", 1 as long), "InvalidConfig", "duplicate refused")
            spec.assert_str_eq(read_("${d}/config.toml"), text, "file untouched")
            spec.assert_true(config.endpoint_id_problem("", null) != "", "empty")
            spec.assert_true(config.endpoint_id_problem("a b", null) != "", "space")
            spec.assert_true(config.endpoint_id_problem("openai", null) != "", "built-in")
            spec.assert_true(config.endpoint_id_problem("custom", null) != "", "reserved")
            taken = list.list_new()
            list.list_add(taken, "my-site")
            spec.assert_true(config.endpoint_id_problem("my-site", taken) != "", "taken")
            other = list.list_new()
            list.list_add(other, "other")
            spec.assert_str_eq(config.endpoint_id_problem("ok_1", other), "", "fine")
            spec.assert_str_eq(config.endpoint_id_problem("openai", null), "Name is taken by a built-in service", "built-in text")
            spec.assert_str_eq(config.endpoint_id_problem("a b", null), "Use letters, digits, _ and - only", "chars text")
            spec.assert_str_eq(config.endpoint_id_problem("", null), "Name cannot be empty", "empty text")
            fs.remove_tree(d)
        }
        spec.it("hooks parse command arrays and reject unknown duplicate and malformed values") callback {
            f = expect_parse_ok_("[hooks]\nafter_edit = [\"zig fmt {files}\"]\nturn_end = []")
            spec.assert_str_eq(str_(f.hooks_after_edit, 0), "zig fmt {files}", "after_edit")
            spec.assert_eq(list.list_size(f.hooks_turn_end), 0, "turn_end empty")
            bads = ["[hooks]\nother = []", "[hooks]\nafter_edit = true", "[hooks]\nafter_edit = [1]", "[hooks]\nafter_edit = []\nafter_edit = []", "[hooks]\n[hooks]", "[hooks]\nturn_end = [\"a\" \"b\"]"]
            i = 0
