// session.instructions: the system prompt's trailing instruction files
// (upstream src/session/instructions.zig): the global one, then the
// project's AGENTS.md, later taking priority.

import std.string
import std.fs
import std.strbuilder

exports(project_root, append)

// std.fs.path.dirname: "" when there is no parent ("/", "a").
dirname_(p: string) -> string {
    n = string.length(p)
    while n > 1 && string.char_at(p, n - 1) == 47 { n = n - 1 }
    i = n - 1
    while i >= 0 && string.char_at(p, i) != 47 { i = i - 1 }
    if i < 0 { return "" }
    if i == 0 {
        if n == 1 { return "" }
        return "/"
    }
    while i > 1 && string.char_at(p, i - 1) == 47 { i = i - 1 }
    return string.substring(p, 0, i)
}

join_(a: string, b: string) -> string {
    if string.ends_with(a, "/") == 1 { return "${a}${b}" }
    return "${a}/${b}"
}

// The nearest directory at or above `cwd` holding a .git entry (a worktree's
// .git is a file); `cwd` itself when there is none.
project_root(cwd: string) -> string {
    path = cwd
    while true {
        if fs.exists(join_(path, ".git")) == 1 { return path }
        parent = dirname_(path)
        if parent == "" { return cwd }
        path = parent
    }
}

// `base`, the ordering note, then each existing file of `global`, `project`
// as "\n--- <path> ---\n<text>\n". ("", error) if an existing file cannot
// be read.
append(base: string, global: string, project: string) -> (string, string) {
    b = strbuilder.new(string.length(base) + 256)
    strbuilder.append(b, base)
    strbuilder.append(b, "\n\nInstructions below apply in order; later instructions take priority.\n")
    paths = [global, project]
    i = 0
    while i < 2 {
        path = paths[i]
        if fs.exists(path) == 1 {
            text, err = fs.read(path)
            if err != "" { return "", "${path}: ${err}" }
            strbuilder.append(b, "\n--- ${path} ---\n${text}\n")
        }
        i = i + 1
    }
    return strbuilder.finish(b), ""
}
