// tools.atomic_file: canonical paths and atomic same-directory replacement
// (upstream src/tools/atomic_file.zig). Errors are Zig's names for them
// ("FileNotFound", "NotDir", "SymLinkLoop", ...), which tool errors show.

import std.fs
import std.os hiding (exec, run_capture, run_pipe, run_pipe_drain_and_wait, run_socket,
    run_stdio, run_full, run_supervised, spawn_proc, spawn_proc_to, os_system,
    os_exec_raw, os_execv, os_run, os_run_capture_raw, os_run_capture_status_raw,
    os_run_pipe_raw, os_run_pipe_drain_and_wait_raw, os_run_socket_raw,
    os_run_stdio_raw, os_run_full_raw, os_run_supervised_raw, os_spawn_raw,
    os_spawn_to_raw)
import std.string
import std.list
import std.cryptography
import std.io
import nib.fserr

exports(canonical_path, replace, replace_stat, dirname, basename, join, cwd_path)

const MAX_LINKS = 40

cwd_path() -> string {
    c = os.getcwd()
    return c
}

// "/a/b" -> "/a"; "/a" -> "/"; "/" -> "/".
dirname(p: string) -> string {
    n = string.length(p)
    while n > 1 && string.char_at(p, n - 1) == 47 { n = n - 1 }
    i = n - 1
    while i >= 0 && string.char_at(p, i) != 47 { i = i - 1 }
    if i <= 0 { return "/" }
    return string.substring(p, 0, i)
}

basename(p: string) -> string {
    n = string.length(p)
    while n > 1 && string.char_at(p, n - 1) == 47 { n = n - 1 }
    i = n - 1
    while i >= 0 && string.char_at(p, i) != 47 { i = i - 1 }
    return string.substring(p, i + 1, n)
}

join(a: string, b: string) -> string {
    if string.ends_with(a, "/") == 1 { return "${a}${b}" }
    return "${a}/${b}"
}

// The components of p ("." and ".." kept, empty ones dropped).
components_(p: string) -> ptr {
    out = list.list_new()
    n = string.length(p)
    i = 0
    while i < n {
        while i < n && string.char_at(p, i) == 47 { i = i + 1 }
        if i >= n { break }
        j = i
        while j < n && string.char_at(p, j) != 47 { j = j + 1 }
        list.list_add(out, string.substring(p, i, j))
        i = j
    }
    return out
}

// Absolute path with every symlink resolved and . / .. applied in order; a
// missing suffix is allowed. (path, "") or ("", error name).
canonical_path(path: string) -> (string, string) {
    if string.length(path) == 0 { return "", "FileNotFound" }
    resolved = "/"
    pending = path
    if string.starts_with(path, "/") == 0 {
        resolved = cwd_path()
    }
    links = 0
    // Process pending's components; a symlink restarts with its target + rest.
    comps = components_(pending)
    idx = 0
    total = list.list_size(comps)
    while idx < total {
        name, _ge = list.get_string(comps, idx)
        is_last = 0
        if idx == total - 1 { is_last = 1 }
        idx = idx + 1
        if name == "." { continue }
        if name == ".." {
            resolved = dirname(resolved)
            continue
        }
        candidate = join(resolved, name)
        st, sk, _sm = fs.stat(candidate, 0)
        if sk != fs.KIND_OK {
            name_err = fserr.errname(sk)
            if name_err == "FileNotFound" {
                resolved = candidate
                continue
            }
            return "", name_err
        }
        if st.kind != fs.STAT_KIND_SYMLINK {
            if is_last == 0 {
                if st.kind != fs.STAT_KIND_DIR { return "", "NotDir" }
            }
            resolved = candidate
            continue
        }
        links = links + 1
        if links > MAX_LINKS { return "", "SymLinkLoop" }
        target, lerr = fs.readlink(candidate)
        if lerr != "" { return "", "Unexpected" }
        // target + the rest of the components
        rest = ""
        k = idx
        while k < total {
            rc_, _ge2 = list.get_string(comps, k)
            rest = "${rest}/${rc_}"
            k = k + 1
        }
        if string.ends_with(pending, "/") == 1 && total > 0 { rest = "${rest}/" }
        pending = "${target}${rest}"
        if string.starts_with(target, "/") == 1 { resolved = "/" }
        comps = components_(pending)
        total = list.list_size(comps)
        idx = 0
    }
    // A trailing "/", "." or ".." requires a directory.
    last = basename(pending)
    if string.ends_with(pending, "/") == 1 || last == "." || last == ".." {
        rst, rk, _rm = fs.stat(resolved, 1)
        if rk != fs.KIND_OK { return "", fserr.errname(rk) }
        if rst.kind != fs.STAT_KIND_DIR { return "", "NotDir" }
    }
    return resolved, ""
}

random_name_() -> string {
    hex, _e = cryptography.random_hex(16)
    return ".nib-${hex}"
}

none_() -> fs.Stat {
    return fs.Stat { kind: 0, mode: 0, nlink: 0, ino: 0, dev: 0, size: 0, mtime_ns: 0 }
}

// Writes data to a fresh .nib-* file beside the canonical target and renames
// it over the target. An existing target keeps its permission bits unless
// force_mode; a new one gets `mode` (subject to umask). "" or the error name.
replace(path: string, data: string, mode: int, force_mode: int, sync: int) -> string {
    _st, err = replace_stat(path, data, mode, force_mode, sync)
    return err
}

// replace, returning the written file's Stat (a zeroed one with an error).
replace_stat(path: string, data: string, mode: int, force_mode: int, sync: int) -> (fs.Stat, string) {
    target, err = canonical_path(path)
    if err != "" { return none_(), err }
    dir = dirname(target)
    dst, dk, _dm = fs.stat(dir, 1)
    if dk != fs.KIND_OK { return none_(), fserr.errname(dk) }
    if dst.kind != fs.STAT_KIND_DIR { return none_(), "NotDir" }
    existing = 0
    existing_mode = 0
    tst, tk, _tm = fs.stat(target, 1)
    if tk == fs.KIND_OK {
        if tst.kind != fs.STAT_KIND_FILE && tst.kind != fs.STAT_KIND_DIR { return none_(), "NotFile" }
        existing = 1
        existing_mode = tst.mode
    } else if tk != fs.KIND_NOT_FOUND {
        return none_(), fserr.errname(tk)
    }
    create_mode = mode
    if existing == 1 { create_mode = 384 }
    fd = -1
    name = ""
    tries = 0
    while tries < 16 {
        name = join(dir, random_name_())
        cfd, ck, _cm = fs.create_exclusive(name, create_mode)
        fd = cfd
        if fd >= 0 { break }
        if ck != fs.KIND_EXISTS { return none_(), fserr.errname(ck) }
        tries = tries + 1
    }
    if fd < 0 { return none_(), "PathAlreadyExists" }
    _w, wk, _wm = fs.fd_pwrite_all(fd, string.bytes(data), 0 as long)
    if wk == fs.KIND_OK && existing == 1 && force_mode == 0 { _f, wk, _fm = fs.fchmod(fd, existing_mode) }
    if wk == fs.KIND_OK && force_mode == 1 { _f2, wk, _fm2 = fs.fchmod(fd, mode) }
    if wk == fs.KIND_OK && sync == 1 { _y, wk, _ym = fs.fd_fsync(fd) }
    failed = ""
    if wk != fs.KIND_OK { failed = fserr.errname(wk) }
    io.fd_close(fd)
    if failed != "" {
        fs.unlink(name)
        return none_(), failed
    }
    written, _ok, _om = fs.stat(name, 1)
    _mv, mk, _mm = fs.move(name, target)
    if mk != fs.KIND_OK {
        failed = fserr.errname(mk)
        fs.unlink(name)
        return none_(), failed
    }
    return written, ""
}
