// tui.transcript: what the conversation area shows, built from Session events
// or replayed history (upstream src/tui/transcript.zig).
//
// A Transcript is a heap struct (`new()`) holding `entries`, a ptr[] of heap
// *entry.Entry boxes (a slice of struct pointers cannot be spelled *Entry[]);
// read them with `at(t, i)` / `count(t)`. Upstream's methods are functions
// taking the transcript first, in snake_case.
//
// Differences from upstream:
//  - Event payloads are TUI-side values: a Session `Progress` is an
//    *agent_tree.Agent (made with agent_tree.new_agent / from_progress /
//    from_json); Background.Kind is agent_tree.BK_*; Recovery.Reason is the
//    changes.REASON_* ints of nib.tools.changes; provider.Kind for deltas is
//    DELTA_TEXT / DELTA_REASONING; the Run effort is a string ("" none);
//    ChangeText is turn_changes.ChangeText (a heap box); ToolSummary is the
//    *tool_summary.Summary of nib.session.tool_summary (null: none).
//  - Time is a `long` of milliseconds from the caller's clock (smooth_delta,
//    advance_visible), never read here.
//  - The viewport (upstream viewport.zig, ported elsewhere) enters through
//    `Scroll`, the three fields clear_retry and retry_attempt read and write:
//    has_top / top_entry / top_row (upstream Viewport.top: ?Anchor{entry,row}).
//    `scroll_removed` is Viewport.removed. Copy the fields to and from the
//    real Viewport around the call (or make the Viewport hold a Scroll).
//  - Optionals: last_answer returns (text, found); latest_details returns -1
//    for null; add_changes ignores a TurnChanges whose head is "".
//  - add_history takes the history as a ptr list of message JSON texts (the
//    nib.msg form the Session log and history use), not provider.Message
//    structs. Not ported there: skills.typed (user messages are added as
//    they are; the skills module is not ported), and the log replay that
//    attaches tool summaries (session.log "not yet ported"): a Run's summary
//    is read from the message's `tool_summary` member when present.
//  - Entries removed from the transcript are freed (entry.free_entry).
//  - `print`-like names: transcript draws nothing itself; the Entry's drawing
//    is entry.draw.

import std.string
import std.strbuilder
import std.list
import std.json
import nib.jsonx
import nib.msg
import nib.session.tool_summary
import nib.sandbox.timing
import nib.tools.changes
import nib.tools.diff
import nib.tui.agent_tree
import nib.tui.entry
import nib.tui.label
import nib.tui.long_text
import nib.tui.smooth
import nib.tui.turn_changes

exports(DELTA_TEXT, DELTA_REASONING, Scroll, scroll_removed, PendingResult, Transcript,
        new, clear, count, at, add, add_changes, background_result, lost_background,
        clear_background_progress, user_inserted, remove_queued, toggle, toggle_all,
        latest_details, last_answer, append_delta, smooth_delta, flush_visible,
        advance_visible, has_backlog, begin_attempt, discard_attempt, clear_retry,
        retry_attempt, failure, start_run, start_run_with_effort, progress_changed,
        activity_detail, progress, hook_notice, end_run, end_run_with_summary,
        background_hook_notice, update_background_run, background_run, add_history,
        run_result_text)

// provider.Kind of a streamed delta.
const DELTA_TEXT = 0
const DELTA_REASONING = 1

// What the viewport shares with the transcript: upstream Viewport.top.
struct Scroll {
    has_top: int
    top_entry: int
    top_row: int
}

// Viewport.removed: entry `index` left the transcript.
scroll_removed(s: *Scroll, index: int) {
    if s.has_top != 0 {
        if s.top_entry > index {
            s.top_entry = s.top_entry - 1
        } else if s.top_entry == index {
            s.top_row = 0
        }
    }
}

struct PendingResult {
    id: string
    kind: int
    ok: int
}

struct Transcript {
    entries: ptr[]
    attempt: int
    revision: long
    next_run: int
    pending_results: ptr[]
}

new() -> *Transcript {
    t = heap.new(Transcript)
    t.entries = make([]ptr, 0)
    t.pending_results = make([]ptr, 0)
    return t
}

count(t: *Transcript) -> int {
    return t.entries.len
}

at(t: *Transcript, i: int) -> *entry.Entry {
    return t.entries[i] as *entry.Entry
}

last_(t: *Transcript) -> *entry.Entry {
    return t.entries[t.entries.len - 1] as *entry.Entry
}

clear(t: *Transcript) {
    for i in 0..t.entries.len {
        entry.free_entry(t.entries[i] as *entry.Entry)
    }
    t.entries = make([]ptr, 0)
    t.next_run = 0
    t.attempt = 0
    clear_pending_results_(t, 0)
}

remove_at_(t: *Transcript, index: int) {
    entry.free_entry(t.entries[index] as *entry.Entry)
    next = make([]ptr, 0)
    for j in 0..t.entries.len {
        if j != index { next.push(t.entries[j]) }
    }
    t.entries = next
}

add(t: *Transcript, kind: int, text: string) {
    t.revision = t.revision + 1
    e = entry.new_entry(kind)
    e.use_cache = 1
    e.text = string.copy(text)
    entry.refresh_label(e)
    t.entries.push(e as ptr)
}

// The line under a Turn footer; a TurnChanges with an empty head (what
// turn_changes returns for no changed files) adds nothing.
add_changes(t: *Transcript, c: turn_changes.TurnChanges) {
    if string.length(c.head) == 0 { return }
    t.revision = t.revision + 1
    e = entry.new_entry(entry.KIND_CHANGES)
    e.use_cache = 1
    e.label = string.copy(c.head)
    e.text = string.copy(c.rows)
    t.entries.push(e as ptr)
}

// ---------------------------------------------------------------- JSON reads

// kind_ok_: member `key` of `o` is missing, null or of JSON type `want`.
member_ok_(o: ptr, key: string, want: int) -> bool {
    k = jsonx.kind(o, key)
    return k == jsonx.KIND_MISSING || k == json.JSON_NULL || k == want
}

struct BgSummary {
    parsed: int
    superseded_by: string
    has_exit: int
    exit_code: int
    err: string
}

// Upstream's `Summary { superseded_by: ?[]const u8, exit_code: ?u8,
// error: ?[]const u8 }` parsed with unknown fields ignored: not parsed when
// `result` is not a JSON object or a member has the wrong type.
parse_bg_summary_(result: string) -> BgSummary {
    out = BgSummary { parsed: 0, superseded_by: "", has_exit: 0, exit_code: 0, err: "" }
    v = jsonx.parse(result)
    if v == null { return out }
    if json.json_type(v) != json.JSON_OBJECT {
        jsonx.free(v)
        return out
    }
    if !member_ok_(v, "superseded_by", json.JSON_STRING) || !member_ok_(v, "error", json.JSON_STRING) || !member_ok_(v, "exit_code", json.JSON_NUMBER) {
        jsonx.free(v)
        return out
    }
    if jsonx.kind(v, "exit_code") == json.JSON_NUMBER {
        ev = jsonx.field(v, "exit_code")
        if json.json_is_integer(ev) == 0 {
            jsonx.free(v)
            return out
        }
        code = json.json_get_long(ev)
        if code < 0 || code > 255 {
            jsonx.free(v)
            return out
        }
        out.has_exit = 1
        out.exit_code = code as int
    }
    out.parsed = 1
    if jsonx.kind(v, "superseded_by") == json.JSON_STRING { out.superseded_by = string.copy(jsonx.str_or(v, "superseded_by", "")) }
    if jsonx.kind(v, "error") == json.JSON_STRING { out.err = string.copy(jsonx.str_or(v, "error", "")) }
    jsonx.free(v)
    return out
}

// ---------------------------------------------------------------- background

kind_word_(kind: int) -> string {
    if kind == agent_tree.BK_RUN { return "Run" }
    return agent_tree.kind_name(kind)
}

background_result(t: *Transcript, kind: int, id: string, ok: bool, result: string) {
    t.revision = t.revision + 1
    settle_background_progress_(t, kind, id, ok)
    if kind == agent_tree.BK_RUN {
        found = background_run_entry_(t, id)
        if found >= 0 {
            en = at(t, found)
            en.output = string.copy(result)
            entry.refresh_label(en)
            entry.invalidate(en)
            return
        }
    }
    e = entry.new_entry(entry.KIND_BACKGROUND)
    e.run = entry.RUN_FAILED
    if ok { e.run = entry.RUN_OK }
    e.task_id = string.copy(id)
    e.text = string.copy(result)
    outcome = "failed"
    if ok { outcome = "completed" }
    e.label = "${id} ${kind_word_(kind)} · ${outcome}"
    s = parse_bg_summary_(result)
    if s.parsed != 0 {
        if s.superseded_by != "" {
            e.run = entry.RUN_SUPERSEDED
            e.label = "${id} superseded by ${s.superseded_by}"
            replace_bash_(t, id, s.superseded_by)
        }
        if !ok && string.index_of(s.err, "timed out") >= 0 {
            e.run = entry.RUN_WARNING
            e.label = "${id} ${agent_tree.kind_name(kind)} · timed out"
        }
        if kind == agent_tree.BK_BASH && s.has_exit != 0 {
            e.label = "${e.label} · exit ${s.exit_code}"
        }
    }
    t.entries.push(e as ptr)
}

replace_bash_(t: *Transcript, id: string, replacement: string) {
    for i in 0..t.entries.len {
        en = at(t, i)
        for j in 0..en.agents.len {
            p = en.agents[j] as *agent_tree.Agent
            if p.id != id { continue }
            p.superseded_by = string.copy(replacement)
            p.`state` = agent_tree.PS_DONE
            p.background = 0
        }
        entry.refresh_agents(en)
        entry.refresh_label(en)
        entry.invalidate(en)
    }
}

lost_background(t: *Transcript, kind: int, id: string, result: string) {
    t.revision = t.revision + 1
    settle_background_progress_(t, kind, id, false)
    if kind == agent_tree.BK_RUN {
        found = background_run_entry_(t, id)
        if found >= 0 {
            en = at(t, found)
            en.run = entry.RUN_LOST
            en.output = string.copy(result)
            entry.refresh_label(en)
            entry.invalidate(en)
            return
        }
    }
    e = entry.new_entry(entry.KIND_BACKGROUND)
    e.run = entry.RUN_WARNING
    e.task_id = string.copy(id)
    e.label = "${id} ${agent_tree.kind_name(kind)} · lost"
    e.text = string.copy(result)
    t.entries.push(e as ptr)
}

settle_progress_(p: *agent_tree.Agent, ok: bool) {
    p.background = 0
    if ok {
        p.`state` = agent_tree.PS_DONE
    } else if p.`state` != agent_tree.PS_CANCELED && p.`state` != agent_tree.PS_TIMED_OUT {
        p.`state` = agent_tree.PS_FAILED
    }
}

settle_background_progress_(t: *Transcript, kind: int, id: string, ok: bool) {
    for i in 0..t.entries.len {
        en = at(t, i)
        if kind != agent_tree.BK_RUN || en.kind != entry.KIND_RUN || en.task_id != id { continue }
        if ok {
            en.run = entry.RUN_OK
        } else if en.run != entry.RUN_TIMED_OUT && en.run != entry.RUN_CANCELED {
            en.run = entry.RUN_FAILED
        }
        entry.refresh_label(en)
        entry.invalidate(en)
    }
    // Results have only task IDs; registration order is the delivery FIFO.
    for i in 0..t.entries.len {
        en = at(t, i)
        if en.kind != entry.KIND_RUN { continue }
        for j in 0..en.invocations.len {
            call = en.invocations[j] as *entry.Invocation
            if call.background == 0 || call.result != -1 || call.kind != kind || call.id != id { continue }
            call.result = 0
            if ok { call.result = 1 }
            for k in 0..en.agents.len {
                p = en.agents[k] as *agent_tree.Agent
                if p.invocation == call.invocation && p.id == id { settle_progress_(p, ok) }
            }
            entry.refresh_agents(en)
            entry.refresh_label(en)
            entry.invalidate(en)
            return
        }
    }
    pr = heap.new(PendingResult)
    pr.id = string.copy(id)
    pr.kind = kind
    pr.ok = 0
    if ok { pr.ok = 1 }
    t.pending_results.push(pr as ptr)
}

clear_pending_results_(t: *Transcript, from: int) {
    next = make([]ptr, 0)
    for i in 0..t.pending_results.len {
        if i < from {
            next.push(t.pending_results[i])
        } else {
            heap.free(t.pending_results[i] as *PendingResult)
        }
    }
    t.pending_results = next
}

clear_background_progress(t: *Transcript) {
    for i in 0..t.entries.len {
        en = at(t, i)
        if en.kind != entry.KIND_RUN { continue }
        for j in 0..en.invocations.len {
            call = en.invocations[j] as *entry.Invocation
            if call.result == -1 { call.background = 0 }
        }
        changed = false
        kept = make([]ptr, 0)
        for j in 0..en.agents.len {
            p = en.agents[j] as *agent_tree.Agent
            if p.background == 0 {
                kept.push(en.agents[j])
            } else {
                heap.free(p)
                changed = true
            }
        }
        en.agents = kept
        if changed {
            entry.refresh_agents(en)
            entry.refresh_label(en)
            entry.invalidate(en)
        }
    }
}

// ---------------------------------------------------------------- queue and toggles

user_inserted(t: *Transcript, id: long) {
    for i in 0..t.entries.len {
        en = at(t, i)
        if en.queued == id {
            en.queued = -1
            entry.invalidate(en)
            return
        }
    }
}

remove_queued(t: *Transcript) {
    i = t.entries.len
    while i > 0 {
        i = i - 1
        if at(t, i).queued >= 0 { remove_at_(t, i) }
    }
}

toggle(t: *Transcript, index: int) {
    en = at(t, index)
    if entry.collapsible(en) {
        if en.open == 0 {
            en.open = 1
        } else {
            en.open = 0
        }
    }
}

// Ctrl+O on everything: opens all collapsible entries, or closes them all
// when any is open (the transcript's toggleAll test helper upstream).
toggle_all(t: *Transcript) {
    any = false
    for i in 0..t.entries.len {
        en = at(t, i)
        if entry.collapsible(en) && en.open != 0 { any = true }
    }
    for i in 0..t.entries.len {
        en = at(t, i)
        if entry.collapsible(en) {
            en.open = 1
            if any { en.open = 0 }
        }
    }
}

// Latest Run, background or failure entry; Ctrl+O targets it. -1: none.
latest_details(t: *Transcript) -> int {
    i = t.entries.len
    while i > 0 {
        i = i - 1
        en = at(t, i)
        k = en.kind
        if k == entry.KIND_RUN || k == entry.KIND_BACKGROUND || k == entry.KIND_FAILURE || (k == entry.KIND_CHANGES && en.simple == 0) { return i }
    }
    return -1
}

// The text of the latest answer, and whether there is one.
last_answer(t: *Transcript) -> (string, bool) {
    i = t.entries.len
    while i > 0 {
        i = i - 1
        if at(t, i).kind == entry.KIND_ASSISTANT { return at(t, i).text, true }
    }
    return "", false
}

// ---------------------------------------------------------------- streaming

append_delta(t: *Transcript, kind: int, text: string) {
    if kind == DELTA_REASONING || string.length(text) == 0 { return }
    t.revision = t.revision + 1
    n = t.entries.len
    if n == 0 || at(t, n - 1).kind != entry.KIND_ASSISTANT || at(t, n - 1).attempt != t.attempt {
        e = entry.new_entry(entry.KIND_ASSISTANT)
        e.attempt = t.attempt
        t.entries.push(e as ptr)
    }
    current = last_(t)
    current.use_cache = 1
    current.text = "${current.text}${text}"
}

smooth_delta(t: *Transcript, text: string, now: long) {
    old = 0
    n = t.entries.len
    if n > 0 && at(t, n - 1).kind == entry.KIND_ASSISTANT && at(t, n - 1).attempt == t.attempt {
        old = string.length(at(t, n - 1).text)
    }
    append_delta(t, DELTA_TEXT, text)
    if string.length(text) == 0 { return }
    en = last_(t)
    if en.has_smooth == 0 {
        en.has_smooth = 1
        en.smooth.visible = old
    }
    smooth.arrive(en.smooth, old, string.length(en.text), now)
}

flush_visible(t: *Transcript) {
    for i in 0..t.entries.len {
        en = at(t, i)
        if en.has_smooth != 0 { smooth.flush(en.smooth, string.length(en.text)) }
    }
}

advance_visible(t: *Transcript, now: long) {
    for i in 0..t.entries.len {
        en = at(t, i)
        if en.has_smooth != 0 { smooth.advance(en.smooth, en.text, now) }
    }
}

has_backlog(t: *Transcript) -> bool {
    for i in 0..t.entries.len {
        en = at(t, i)
        if en.has_smooth != 0 && en.smooth.has_deadline != 0 { return true }
    }
    return false
}

begin_attempt(t: *Transcript) {
    t.attempt = t.attempt + 1
}

discard_attempt(t: *Transcript) {
    i = 0
    while i < t.entries.len {
        en = at(t, i)
        if en.kind == entry.KIND_ASSISTANT && en.attempt == t.attempt {
            remove_at_(t, i)
        } else {
            i = i + 1
        }
    }
}

clear_retry(t: *Transcript, scroll: *Scroll) {
    i = 0
    while i < t.entries.len {
        if at(t, i).retry_placeholder == 0 {
            i = i + 1
            continue
        }
        remove_at_(t, i)
        scroll_removed(scroll, i)
        t.revision = t.revision + 1
    }
}

retry_attempt(t: *Transcript, scroll: *Scroll) {
    kept = false
    i = 0
    while i < t.entries.len {
        en = at(t, i)
        if en.retry_placeholder != 0 { kept = true }
        if en.kind != entry.KIND_ASSISTANT || en.attempt != t.attempt {
            i = i + 1
            continue
        }
        if !kept {
            ph = entry.new_entry(entry.KIND_INFO)
            ph.retry_placeholder = 1
            ph.text = "Interrupted · retrying"
            entry.free_entry(en)
            t.entries[i] = ph as ptr
            t.revision = t.revision + 1
            if scroll.has_top != 0 && scroll.top_entry == i { scroll.top_row = 0 }
            kept = true
            i = i + 1
        } else {
            remove_at_(t, i)
            scroll_removed(scroll, i)
        }
    }
}

// reason: one of changes.REASON_*.
failure(t: *Transcript, detail: string, reason: int) {
    t.revision = t.revision + 1
    e = entry.new_entry(entry.KIND_FAILURE)
    e.run = entry.RUN_FAILED
    if reason == changes.REASON_TIMEOUT { e.run = entry.RUN_WARNING }
    e.text = string.copy(detail)
    sentence = "The model request failed."
    if reason == changes.REASON_TIMEOUT {
        sentence = "The request timed out."
    } else if reason == changes.REASON_LIMIT {
        sentence = "The step limit was reached."
    } else if reason == changes.REASON_TOOL {
        sentence = "The Run failed."
    }
    e.label = sentence
    t.entries.push(e as ptr)
}

// ---------------------------------------------------------------- runs

start_run(t: *Transcript, code: string) {
    start_run_with_effort(t, code, "")
}

// effort: the step's effort ("" none).
start_run_with_effort(t: *Transcript, code: string, effort: string) {
    t.revision = t.revision + 1
    add_run_(t, code, false, effort)
    t.next_run = t.next_run + 1
    last_(t).run_number = t.next_run
}

progress_changed(t: *Transcript, p: *agent_tree.Agent) -> bool {
    for i in 0..t.entries.len {
        en = at(t, i)
        for j in 0..en.agents.len {
            old = en.agents[j] as *agent_tree.Agent
            if old.id != p.id || old.invocation != p.invocation { continue }
            return old.`state` != p.`state` || old.step != p.step || old.output_bytes != p.output_bytes || !agent_tree.same_strings(old.tools, p.tools) || !agent_tree.same_strings(old.files, p.files)
        }
    }
    return true
}

// What the activity line shows for a running Run's foreground task:
// "<kind> <prompt prefix>" with control bytes as spaces, else `tool`.
activity_detail(t: *Transcript, tool: string) -> string {
    i = t.entries.len
    while i > 0 {
        i = i - 1
        en = at(t, i)
        if en.kind != entry.KIND_RUN { continue }
        if en.run != entry.RUN_RUNNING { continue }
        for j in 0..en.agents.len {
            p = en.agents[j] as *agent_tree.Agent
            if p.detached != 0 || (p.`state` != agent_tree.PS_QUEUED && p.`state` != agent_tree.PS_WORKING) { continue }
            if p.background == 0 && (string.length(tool) == 0 || agent_tree.kind_name(p.kind) == tool) {
                text = "${agent_tree.kind_name(p.kind)} ${label.prompt_prefix(p.prompt)}"
                return control_to_space_(text)
            }
        }
    }
    return tool
}

control_to_space_(text: string) -> string {
    n = string.length(text)
    sb = strbuilder.new(n + 4)
    start = 0
    i = 0
    while i < n {
        b = text[i]
        if b < 32 || b == 127 {
            if i > start { strbuilder.append(sb, string.substring(text, start, i)) }
            strbuilder.append(sb, " ")
            start = i + 1
        }
        i = i + 1
    }
    if n > start { strbuilder.append(sb, string.substring(text, start, n)) }
    return strbuilder.finish(sb)
}

// The Run entry a progress snapshot belongs to, or -1.
find_target_(t: *Transcript, p: *agent_tree.Agent) -> int {
    for i in 0..t.entries.len {
        en = at(t, i)
        if en.kind != entry.KIND_RUN || (p.run != 0 && en.run_number != p.run) { continue }
        for j in 0..en.invocations.len {
            call = en.invocations[j] as *entry.Invocation
            if call.invocation == p.invocation && call.id == p.id { return i }
        }
    }
    if p.run != 0 {
        i = t.entries.len
        while i > 0 {
            i = i - 1
            en = at(t, i)
            if en.kind == entry.KIND_RUN && en.run_number == p.run && (en.run == entry.RUN_RUNNING || en.run == entry.RUN_BACKGROUND || p.background != 0) { return i }
        }
        return -1
    }
    return last_running_(t)
}

// Routes a task snapshot to its Run (cloning it): see upstream
// Transcript.progress for the invocation and background-result rules.
progress(t: *Transcript, p: *agent_tree.Agent) {
    if progress_changed(t, p) { t.revision = t.revision + 1 }
    target = find_target_(t, p)
    if target < 0 { return }
    e = at(t, target)
    call = null as *entry.Invocation
    for j in 0..e.invocations.len {
        c = e.invocations[j] as *entry.Invocation
        if c.invocation == p.invocation && c.id == p.id {
            call = c
            break
        }
    }
    if call == null {
        c = heap.new(entry.Invocation)
        c.id = string.copy(p.id)
        c.kind = p.kind
        c.invocation = p.invocation
        c.background = p.background
        c.result = -1
        e.invocations.push(c as ptr)
        call = c
    }
    if call.background != 0 && call.result == -1 {
        for i in 0..t.pending_results.len {
            pr = t.pending_results[i] as *PendingResult
            if pr.kind != p.kind || pr.id != p.id { continue }
            call.result = pr.ok
            next = make([]ptr, 0)
            for k in 0..t.pending_results.len {
                if k != i { next.push(t.pending_results[k]) }
            }
            t.pending_results = next
            heap.free(pr)
            break
        }
    }
    for j in 0..e.agents.len {
        current = e.agents[j] as *agent_tree.Agent
        if current.id == p.id && current.invocation > p.invocation { return }
    }
    copy = agent_tree.clone_agent(p)
    if call.result != -1 { settle_progress_(copy, call.result == 1) }
    replaced = false
    for j in 0..e.agents.len {
        current = e.agents[j] as *agent_tree.Agent
        if current.id != p.id { continue }
        heap.free(current)
        e.agents[j] = copy as ptr
        replaced = true
        break
    }
    if !replaced { e.agents.push(copy as ptr) }
    if p.kind == agent_tree.BK_RUN && p.id == e.task_id {
        if p.`state` == agent_tree.PS_TIMED_OUT { e.run = entry.RUN_TIMED_OUT }
        if p.`state` == agent_tree.PS_CANCELED { e.run = entry.RUN_CANCELED }
    }
    entry.refresh_agents(e)
    entry.refresh_label(e)
    entry.invalidate(e)
}

hook_notice(t: *Transcript, notice: string) {
    idx = last_running_(t)
    if idx < 0 { return }
    e = at(t, idx)
    e.hook_notice = "${e.hook_notice}${notice}"
    entry.invalidate(e)
    t.revision = t.revision + 1
}

// `changes` is taken over (the transcript keeps it).
end_run(t: *Transcript, ok: bool, output: string, elapsed_ms: long, changes: *turn_changes.ChangeText) {
    end_run_with_summary(t, ok, output, elapsed_ms, changes, null)
}

// `changes` is taken over; `summary` (null: none) is borrowed and cloned.
end_run_with_summary(t: *Transcript, ok: bool, output: string, elapsed_ms: long, changes: *turn_changes.ChangeText, summary: ptr) {
    t.revision = t.revision + 1
    idx = last_running_(t)
    if idx < 0 {
        heap.free(changes)
        return
    }
    e = at(t, idx)
    e.run = entry.RUN_FAILED
    if e.task_id != "" {
        e.run = entry.RUN_BACKGROUND
    } else if ok {
        e.run = entry.RUN_OK
    }
    e.elapsed_ms = elapsed_ms
    heap.free(e.changes)
    e.changes = changes
    if summary != null {
        if e.has_tool_summary != 0 { heap.free(e.tool_summary) }
        e.tool_summary = tool_summary.clone(summary as *tool_summary.Summary)
        e.has_tool_summary = 1
    }
    e.output = "${e.output}${output}"
    entry.refresh_label(e)
    entry.invalidate(e)
}

// Index of the Run entry of background task `id`, or -1.
background_run_entry_(t: *Transcript, id: string) -> int {
    for i in 0..t.entries.len {
        en = at(t, i)
        if en.kind == entry.KIND_RUN && en.task_id == id { return i }
    }
    return -1
}

background_hook_notice(t: *Transcript, id: string, notice: string) {
    idx = background_run_entry_(t, id)
    if idx < 0 { return }
    e = at(t, idx)
    e.hook_notice = "${e.hook_notice}${notice}"
    entry.invalidate(e)
    t.revision = t.revision + 1
}

// Replaces the output, changes and summary of background Run `id`'s entry;
// `changes` and `summary` are borrowed and cloned.
update_background_run(t: *Transcript, id: string, output: string, changes: *turn_changes.ChangeText, summary: *tool_summary.Summary) {
    for i in 0..t.entries.len {
        en = at(t, i)
        if en.kind != entry.KIND_RUN || en.task_id != id { continue }
        en.output = string.copy(output)
        heap.free(en.changes)
        en.changes = turn_changes.change_text_clone(changes)
        if en.has_tool_summary != 0 { heap.free(en.tool_summary) }
        en.tool_summary = tool_summary.clone(summary)
        en.has_tool_summary = 1
        entry.refresh_label(en)
        entry.invalidate(en)
        return
    }
}

// Marks the running Run as the background task `id`.
background_run(t: *Transcript, id: string) {
    idx = last_running_(t)
    if idx < 0 { return }
    at(t, idx).task_id = string.copy(id)
}

// The result text of a background Run: the result, then the changed files
// and their diff. `changes` is a list of *diff.Change.
run_result_text(result: string, cs: ptr) -> string {
    formatted = turn_changes.change_text_new(cs)
    if string.length(formatted.summary) == 0 { return result }
    return "${result}\n\n${formatted.summary}\n${formatted.diff}"
}

// ---------------------------------------------------------------- history

struct RunMap {
    ids: string[]
    idx: int[]
}

add_run_(t: *Transcript, code: string, open: bool, effort: string) {
    e = entry.new_entry(entry.KIND_RUN)
    if open { e.open = 1 }
    if effort != "" {
        e.has_step_effort = 1
        e.step_effort = string.copy(effort)
    }
    e.text = trim_nl_both_(code)
    entry.refresh_label(e)
    t.entries.push(e as ptr)
}

trim_nl_both_(s: string) -> string {
    start = 0
    end = string.length(s)
    while start < end && s[start] == 10 { start = start + 1 }
    while end > start && s[end - 1] == 10 { end = end - 1 }
    return string.substring(s, start, end)
}

last_running_(t: *Transcript) -> int {
    i = t.entries.len
    while i > 0 {
        i = i - 1
        en = at(t, i)
        if en.kind == entry.KIND_RUN && en.run == entry.RUN_RUNNING { return i }
    }
    return -1
}

// A Summary from the JSON of a message's `tool_summary` member:
// {"counts":[{"name","count"}],"omitted":N,"files":[{"tool","path","duration_ms"?,"failed"?}]}.
summary_from_json_(v: ptr) -> *tool_summary.Summary {
    s = tool_summary.empty()
    s.omitted = jsonx.long_or(v, "omitted", 0 as long)
    cv = jsonx.field(v, "counts")
    if cv != null && json.json_type(cv) == json.JSON_ARRAY {
        for i in 0..json.json_array_size(cv) {
            o = json.json_array_get_raw(cv, i)
            c = heap.new(tool_summary.Count)
            c.name = string.copy(jsonx.str_or(o, "name", ""))
            c.count = jsonx.long_or(o, "count", 0 as long)
            list.list_add(s.counts, c as ptr)
        }
    }
    fv = jsonx.field(v, "files")
    if fv != null && json.json_type(fv) == json.JSON_ARRAY {
        for i in 0..json.json_array_size(fv) {
            o = json.json_array_get_raw(fv, i)
            f = heap.new(tool_summary.File)
            f.tool = string.copy(jsonx.str_or(o, "tool", ""))
            f.path = string.copy(jsonx.str_or(o, "path", ""))
            f.duration_ms = -1
            if jsonx.kind(o, "duration_ms") == json.JSON_NUMBER { f.duration_ms = jsonx.long_or(o, "duration_ms", 0 as long) }
            f.failed = jsonx.bool_or(o, "failed", 0)
            list.list_add(s.files, f as ptr)
        }
    }
    return s
}

// A list of *diff.Change from a JSON array of {path, added, removed, created?, diff}.
changes_from_json_(arr: ptr) -> ptr {
    out = list.list_new()
    if arr == null || json.json_type(arr) != json.JSON_ARRAY { return out }
    for i in 0..json.json_array_size(arr) {
        o = json.json_array_get_raw(arr, i)
        c = heap.new(diff.Change)
        c.path = string.copy(jsonx.str_or(o, "path", ""))
        c.added = jsonx.int_or(o, "added", 0)
        c.removed = jsonx.int_or(o, "removed", 0)
        c.created = jsonx.bool_or(o, "created", 0)
        c.diff = string.copy(jsonx.str_or(o, "diff", ""))
        list.list_add_raw(out, c as ptr)
    }
    return out
}

// The summary of the dispatched calls of Run `run_index` in a JSON `calls`
// array (upstream ToolSummary.init over the timing Calls).
summary_from_calls_(calls: ptr, run_index: int, omitted: long) -> *tool_summary.Summary {
    run = timing.new()
    if calls != null && json.json_type(calls) == json.JSON_ARRAY {
        for i in 0..json.json_array_size(calls) {
            o = json.json_array_get_raw(calls, i)
            idx = timing.reserve_entry(run, jsonx.str_or(o, "name", ""))
            if idx < 0 { continue }
            c = timing.entry(run, idx) as *timing.Call
            c.name = string.copy(jsonx.str_or(o, "name", ""))
            c.start_ms = jsonx.long_or(o, "start_ms", 0 as long)
            c.end_ms = jsonx.long_or(o, "end_ms", 0 as long)
            c.ok = jsonx.bool_or(o, "ok", 0)
            c.run_index = jsonx.int_or(o, "run_index", 0)
            c.path = string.copy(jsonx.str_or(o, "path", ""))
            c.dispatched = 1
            if jsonx.kind(o, "dispatched") == json.JSON_BOOL { c.dispatched = jsonx.bool_or(o, "dispatched", 1) }
            c.id = string.copy(jsonx.str_or(o, "id", ""))
        }
    }
    return tool_summary.init(run, run_index, omitted)
}

// Replays a history: `history` is a ptr list of message JSON texts.
add_history(t: *Transcript, history: ptr) {
    pending_start = t.pending_results.len
    runs = heap.new(RunMap)
    runs.ids = make([]string, 0)
    runs.idx = make([]int, 0)
    for i in 0..list.list_size(history) {
        m, _g = list.get_string(history, i)
        v = jsonx.parse(m)
        if v == null { continue }
        add_history_message_(t, v, runs)
        jsonx.free(v)
    }
    clear_pending_results_(t, pending_start)
}

kind_from_name_(s: string, d: int) -> int {
    if s == "agent" { return agent_tree.BK_AGENT }
    if s == "bash" { return agent_tree.BK_BASH }
    if s == "run" { return agent_tree.BK_RUN }
    return d
}

add_history_message_(t: *Transcript, v: ptr, runs: *RunMap) {
    role = string.copy(jsonx.str_or(v, "role", ""))
    content = string.copy(jsonx.str_or(v, "content", ""))
    source = jsonx.str_or(v, "source", "")
    bg_id = ""
    has_bg_id = jsonx.kind(v, "background_id") == json.JSON_STRING
    if has_bg_id { bg_id = string.copy(jsonx.str_or(v, "background_id", "")) }
    if source == "background" {
        kind = kind_from_name_(jsonx.str_or(v, "background_kind", ""), agent_tree.BK_AGENT)
        bid = bg_id
        if !has_bg_id { bid = "?" }
        if string.starts_with(content, "[background ") != 0 && string.index_of(content, " lost:") >= 0 {
            lost_background(t, kind, bid, content)
            return
        }
        result = content
        nl = string.index_of(content, "\n")
        if nl >= 0 { result = string.substring(content, nl + 1, string.length(content)) }
        parsed_ok = false
        rv = jsonx.parse(result)
        if rv != null && json.json_type(rv) == json.JSON_OBJECT {
            valid = member_ok_(rv, "ok", json.JSON_BOOL) && member_ok_(rv, "exit_code", json.JSON_NUMBER)
            if valid && jsonx.kind(rv, "exit_code") == json.JSON_NUMBER && json.json_is_integer(jsonx.field(rv, "exit_code")) == 0 { valid = false }
            if valid {
                if kind == agent_tree.BK_AGENT {
                    parsed_ok = jsonx.kind(rv, "ok") == json.JSON_BOOL && jsonx.bool_or(rv, "ok", 0) == 1
                } else {
                    parsed_ok = jsonx.kind(rv, "exit_code") == json.JSON_NUMBER && jsonx.long_or(rv, "exit_code", 1 as long) == 0
                }
            }
        }
        jsonx.free(rv)
        completion = jsonx.field(v, "background_run")
        shown = result
        if completion != null && background_run_entry_(t, bid) < 0 {
            cs = changes_from_json_(jsonx.field(completion, "changes"))
            shown = run_result_text(string.copy(jsonx.str_or(completion, "output", "")), cs)
        }
        if completion != null {
            cs2 = changes_from_json_(jsonx.field(completion, "changes"))
            ct = turn_changes.change_text_new(cs2)
            sm = summary_from_calls_(jsonx.field(completion, "calls"), jsonx.int_or(completion, "run_index", 0), jsonx.long_or(completion, "calls_omitted", 0 as long))
            update_background_run(t, bid, string.copy(jsonx.str_or(completion, "output", "")), ct, sm)
        }
        ok = parsed_ok
        bo = jsonx.kind(v, "background_ok")
        if bo == json.JSON_BOOL { ok = jsonx.bool_or(v, "background_ok", 0) == 1 }
        background_result(t, kind, bid, ok, shown)
    } else if source == "undo" {
        add(t, entry.KIND_INFO, content)
    } else if role == "user" {
        add(t, entry.KIND_USER, content)
    } else if role == "assistant" {
        if string.length(content) > 0 {
            k = entry.KIND_ASSISTANT
            if jsonx.kind(v, "waiting") == json.JSON_BOOL && jsonx.bool_or(v, "waiting", 0) == 1 { k = entry.KIND_INFO }
            add(t, k, content)
        }
        effort = ""
        ef = jsonx.field(v, "step_effort")
        if ef != null { effort = string.copy(jsonx.str_or(ef, "effort", "")) }
        tcs = jsonx.field(v, "tool_calls")
        if tcs != null && json.json_type(tcs) == json.JSON_ARRAY {
            for i in 0..json.json_array_size(tcs) {
                call = json.json_array_get_raw(tcs, i)
                fn_ = jsonx.field(call, "function")
                args = jsonx.parse(jsonx.str_or(fn_, "arguments", ""))
                if args == null { continue }
                if json.json_type(args) != json.JSON_OBJECT || !member_ok_(args, "code", json.JSON_STRING) || jsonx.kind(args, "code") == json.JSON_NULL {
                    if jsonx.kind(args, "code") != jsonx.KIND_MISSING {
                        jsonx.free(args)
                        continue
                    }
                }
                code = string.copy(jsonx.str_or(args, "code", ""))
                jsonx.free(args)
                add_run_(t, code, false, effort)
                runs.ids.push(string.copy(jsonx.str_or(call, "id", "")))
                runs.idx.push(t.entries.len - 1)
            }
        }
        if jsonx.kind(v, "step_calls_omitted") == json.JSON_NUMBER {
            n = jsonx.long_or(v, "step_calls_omitted", 0 as long)
            add(t, entry.KIND_INFO, "tools +${n} · omitted calls (Run unknown)")
        }
    } else if role == "tool" {
        call_id = jsonx.str_or(v, "tool_call_id", "")
        found = -1
        i = runs.ids.len
        while i > 0 {
            i = i - 1
            if runs.ids[i] == call_id {
                found = runs.idx[i]
                break
            }
        }
        if found < 0 { return }
        e = at(t, found)
        e.run = entry.RUN_FAILED
        if has_bg_id {
            e.run = entry.RUN_BACKGROUND
        } else if jsonx.kind(v, "run_ok") != json.JSON_BOOL || jsonx.bool_or(v, "run_ok", 1) == 1 {
            e.run = entry.RUN_OK
        }
        if has_bg_id { e.task_id = bg_id }
        reps = jsonx.field(v, "bash_replacements")
        if reps != null && json.json_type(reps) == json.JSON_ARRAY {
            for i2 in 0..json.json_array_size(reps) {
                b = json.json_array_get_raw(reps, i2)
                p = agent_tree.new_agent(jsonx.str_or(b, "id", ""), jsonx.str_or(b, "command", ""),
                    kind: agent_tree.BK_BASH, `state`: agent_tree.PS_DONE,
                    elapsed_ms: jsonx.long_or(b, "elapsed_ms", 0 as long),
                    superseded_by: jsonx.str_or(b, "superseded_by", ""))
                e.agents.push(p as ptr)
            }
        }
        entry.refresh_agents(e)
        sv = jsonx.field(v, "tool_summary")
        if sv != null && json.json_type(sv) == json.JSON_OBJECT {
            e.tool_summary = summary_from_json_(sv)
            e.has_tool_summary = 1
        }
        e.output = "${e.output}${content}"
        entry.refresh_label(e)
    }
}
