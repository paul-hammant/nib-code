        spec.it("delivered background agent results do not settle foreground or background reuse") callback {
            flags = [0, 1]
            for fi in 0..2 {
                background = flags[fi]
                t = transcript.new()
                transcript.start_run(t, "tools.agent({background:true})")
                transcript.progress(t, agent_tree.new_agent("a1", "first", run: 1, background: 1, `state`: agent_tree.PS_DONE, step: 2))
                transcript.end_run(t, true, "started", 100, none_())
                transcript.background_result(t, BK_AGENT, "a1", false, "{}")
                transcript.start_run(t, "tools.agent({resume:'a1'})")
                transcript.progress(t, agent_tree.new_agent("a1", "resume", run: 2, background: background, step: 1))
                streq(row_(e_(t, 0), 0), "  └─ a1 first · failed · step 2")
                spec.assert_eq(e_(t, 2).agents.len, 1, "one")
                spec.assert_eq(agent_(e_(t, 2), 0).`state`, agent_tree.PS_WORKING, "working")
                spec.assert_eq(agent_(e_(t, 2), 0).background, background, "background kept")
                transcript.progress(t, agent_tree.new_agent("a1", "first", run: 1, background: 1, `state`: agent_tree.PS_DONE, step: 3))
                streq(row_(e_(t, 0), 0), "  └─ a1 first · failed · step 3")
                spec.assert_eq(agent_(e_(t, 0), 0).background, 0, "settled")
                spec.assert_eq(agent_(e_(t, 2), 0).step, 1, "step")
                spec.assert_eq(agent_(e_(t, 2), 0).`state`, agent_tree.PS_WORKING, "still working")
                if background == 1 {
                    transcript.background_result(t, BK_AGENT, "a1", true, "{}")
                    transcript.progress(t, agent_tree.new_agent("a1", "resume", run: 2, background: 1, step: 4))
                    streq(row_(e_(t, 2), 0), "  └─ a1 resume · completed · step 4")
                    spec.assert_eq(agent_(e_(t, 2), 0).background, 0, "settled resume")
                    streq(row_(e_(t, 0), 0), "  └─ a1 first · failed · step 3")
                }
            }
        }
        spec.it("delayed background results settle only the oldest undelivered invocation of a reused ID") callback {
            t = transcript.new()
