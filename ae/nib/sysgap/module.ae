// sysgap: a marked STAND-IN for POSIX file primitives std.fs lacks (stat
// with inode, mode and ns mtime; flock; O_EXCL creation with a mode; the
// errno's name), until asks/aether-fs-stat-flock-exclusive.md is answered.
// Only the file tools import it.

import std.string
import std.list

@source("sysgap.c")

exports(Stat, new_stat, stat, errname, lock_open, try_lock, close, fd_size, fd_truncate,
        create_excl, write_all, pwrite_all, watch_signals, ignore_sigpipe, signal_received, stdin_echo, environ, fchmod, fsync, rename, unlink, chmod, mkdir,
        KIND_FILE, KIND_DIR, KIND_LINK, KIND_OTHER, ENOENT_NAME)

const KIND_FILE = 1
const KIND_DIR = 2
const KIND_LINK = 3
const KIND_OTHER = 4
const ENOENT_NAME = "FileNotFound"

struct Stat {
    kind: int
    mode: int
    ino: long
    size: long
    mtime_ns: long
    dev: long
}

extern nibsys_stat(path: string, follow: int, out: ptr) -> int
extern nibsys_errname(e: int) -> string
extern nibsys_lock_open(path: string) -> int
extern nibsys_try_lock(fd: int) -> int
extern nibsys_close(fd: int) -> int
extern nibsys_fd_size(fd: int) -> long
extern nibsys_fd_truncate(fd: int, n: long) -> int
extern nibsys_create_excl(path: string, mode: int) -> int
extern nibsys_write_all(fd: int, data: string, n: long) -> int
extern nibsys_pwrite_all(fd: int, data: string, n: long, offset: long) -> int
extern nibsys_watch_signals() -> int
extern nibsys_ignore_sigpipe() -> int
extern nibsys_stdin_echo(on: int) -> int
extern nibsys_signal_received() -> int
extern nibsys_fchmod(fd: int, mode: int) -> int
extern nibsys_fsync(fd: int) -> int
extern nibsys_rename(from: string, to: string) -> int
extern nibsys_unlink(path: string) -> int
extern nibsys_chmod(path: string, mode: int) -> int
extern nibsys_mkdir(path: string, mode: int) -> int
extern nibsys_environ_count() -> int
extern nibsys_environ_get(i: int) -> string

new_stat() -> ptr {
    s = heap.new(Stat)
    s.kind = 0
    s.mode = 0
    s.ino = 0
    s.size = 0
    s.mtime_ns = 0
    s.dev = 0
    return s as ptr
}

// 0, or the errno; out (*Stat) filled on 0.
stat(path: string, follow: int, out: ptr) -> int { return nibsys_stat(path, follow, out) }
errname(e: int) -> string {
    if e < 0 { return string.copy(nibsys_errname(0 - e)) }
    return string.copy(nibsys_errname(e))
}
lock_open(path: string) -> int { return nibsys_lock_open(path) }
try_lock(fd: int) -> int { return nibsys_try_lock(fd) }
close(fd: int) -> int { return nibsys_close(fd) }
fd_size(fd: int) -> long { return nibsys_fd_size(fd) }
fd_truncate(fd: int, n: long) -> int { return nibsys_fd_truncate(fd, n) }
create_excl(path: string, mode: int) -> int { return nibsys_create_excl(path, mode) }
write_all(fd: int, data: string) -> int { return nibsys_write_all(fd, data, string.length(data) as long) }
pwrite_all(fd: int, data: string, offset: long) -> int { return nibsys_pwrite_all(fd, data, string.length(data) as long, offset) }
// SIGINT/SIGTERM set a flag instead of ending the process; signal_received()
// is the last one's number, 0 none.
// Turns stdin's terminal echo on (1) or off (0); 1 if stdin is a terminal.
stdin_echo(on: int) -> int { return nibsys_stdin_echo(on) }
watch_signals() -> int { return nibsys_watch_signals() }
ignore_sigpipe() -> int { return nibsys_ignore_sigpipe() }
signal_received() -> int { return nibsys_signal_received() }
fchmod(fd: int, mode: int) -> int { return nibsys_fchmod(fd, mode) }
fsync(fd: int) -> int { return nibsys_fsync(fd) }
rename(from: string, to: string) -> int { return nibsys_rename(from, to) }
unlink(path: string) -> int { return nibsys_unlink(path) }
chmod(path: string, mode: int) -> int { return nibsys_chmod(path, mode) }
mkdir(path: string, mode: int) -> int { return nibsys_mkdir(path, mode) }

// This process's environment as a list of "NAME=value" strings (copies).
environ() -> ptr {
    out = list.list_new()
    n = nibsys_environ_count()
    i = 0
    while i < n {
        list.list_add(out, string.copy(nibsys_environ_get(i)))
        i = i + 1
    }
    return out
}
