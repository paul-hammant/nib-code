// Tests for src/tools/secrets.zig (no upstream test blocks; covers the list and filter).
import std.spec
import std.string
import std.list
import nib.tools.secrets

main() {
    fw = spec.init()
    spec.describe(fw, "tools.secrets") {
        spec.it("every upstream name is secret and ordinary names are not") callback {
            names = secrets.environment_names()
            spec.assert_eq(list.list_size(names), 30, "count")
            i = 0
            while i < 30 {
                nm, _e = list.get_string(names, i)
                spec.assert_eq(secrets.is_secret(nm), 1, "secret ${nm}")
                i = i + 1
            }
            spec.assert_eq(secrets.is_secret("PATH"), 0, "PATH")
            spec.assert_eq(secrets.is_secret("GITHUB_TOKEN_X"), 0, "prefix")
            spec.assert_eq(secrets.is_secret("XAI_API_KEY"), 1, "last")
            spec.assert_eq(secrets.is_secret("CODEX_ACCESS_TOKEN"), 1, "first")
        }
        spec.it("remove_from drops secret entries and keeps the rest in order") callback {
            env = list.list_new()
            list.list_add(env, "PATH=/bin")
            list.list_add(env, "GITHUB_TOKEN=abc")
            list.list_add(env, "HOME=/home/u")
            list.list_add(env, "OPENAI_API_KEY=sk-1")
            list.list_add(env, "GITHUB_TOKEN_X=keep")
            out = secrets.remove_from(env)
            spec.assert_eq(list.list_size(out), 3, "size")
            a, _e1 = list.get_string(out, 0)
            b, _e2 = list.get_string(out, 1)
            c, _e3 = list.get_string(out, 2)
            spec.assert_str_eq(a, "PATH=/bin", "0")
            spec.assert_str_eq(b, "HOME=/home/u", "1")
            spec.assert_str_eq(c, "GITHUB_TOKEN_X=keep", "2")
        }
    }
    return spec.run_summary(fw)
}
