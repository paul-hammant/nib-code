// Ports the 55 tests of upstream src/tui/transcript.zig under their names.
//
// Partially ported (the backing is not ported yet):
//  - "restored Run summaries follow run_index and tool_call_id and survive
//    compaction", "legacy Step overflow is not attributed to a pure JS Run":
//    upstream builds the summaries by replaying a session log through
//    session/log.zig, whose tool-summary restoration is not ported
//    (ae/nib/session/log header). Ported as far as the transcript: the
//    messages carry the `tool_summary` / `step_calls_omitted` members the
//    replay would attach, and the labels are checked; the log round trip
//    ("compaction", the second loop of the Step-overflow test) is not.
//  - "legacy logs without tool facts keep a plain Run title": the same, from
//    a message without the members.
//  - "endRun summary cloning failures release owned data": upstream drives
//    std.testing.checkAllAllocationFailures; there is no allocator to fail
//    here, so it checks the same call completes and labels the Run.
//  - "history Run effort is copied ...": upstream mutates the source buffer
//    after the call to prove a copy; Aether strings are immutable, so it
//    checks the value and that the label does not show it.
//  - Messages are JSON texts (nib.msg form), not provider.Message structs;
//    "user" history content is added as typed (skills.typed not ported).
import std.spec
import std.string
import std.list
import nib.jsonx
import nib.tui.transcript
import nib.tui.entry
import nib.tui.viewport
import nib.tui.agent_tree
import nib.tui.turn_changes
import nib.tui.turn_summary
import nib.tui.bill
import nib.tui.label
import nib.tools.changes
import nib.tools.diff
import nib.tools.progress
import nib.session.tool_summary
import nib.sandbox.timing
import term.screen

// ---------------------------------------------------------------- helpers

e_(t: *transcript.Transcript, i: int) -> *entry.Entry { return transcript.at(t, i) }

streq(a: string, b: string) { spec.assert_str_eq(a, b, "string") }

seg_text_(e: *entry.Entry, i: int) -> string {
    s = entry.segments(e)
    return s[i].text
}

seg_count_(e: *entry.Entry) -> int {
    s = entry.segments(e)
    return s.len
}

row_(e: *entry.Entry, i: int) -> string { return e.agent_tree.rows[i].text }

agent_(e: *entry.Entry, i: int) -> *agent_tree.Agent { return e.agents[i] as *agent_tree.Agent }

changes_(path: string, added: int, removed: int, created: int, text: string) -> ptr {
    c = heap.new(diff.Change)
    c.path = path
    c.added = added
    c.removed = removed
    c.created = created
    c.diff = text
    return c as ptr
}

one_change_(path: string, added: int, removed: int, text: string) -> *turn_changes.ChangeText {
    l = list.list_new()
    list.list_add_raw(l, changes_(path, added, removed, 0, text))
    return turn_changes.change_text_new(l)
}

none_() -> *turn_changes.ChangeText { return turn_changes.change_text_empty() }

surf_win_(cols: int, rows: int) -> screen.Window {
    return screen.window(screen.surface(cols, rows))
}

cell_(w: screen.Window, x: int, y: int) -> screen.Cell {
    c, _ok = screen.win_read(w, x, y)
    return c
}

dim_(c: screen.Cell) -> bool { return screen.has_attr(c.style, screen.DIM) }

// The messages of a history, as JSON texts.
msgs_() -> ptr { return list.list_new() }
push_(l: ptr, m: string) { list.list_add(l, m) }

bg_msg_(content: string, kind: string, id: string, ok: string) -> string {
    extra = ""
    if ok != "" { extra = ",\"background_ok\":${ok}" }
    return "{\"role\":\"user\",\"content\":${jsonx.quote(content)},\"source\":\"background\",\"background_id\":${jsonx.quote(id)}${extra},\"background_kind\":${jsonx.quote(kind)}}"
}

call_(id: string, code: string) -> string {
    args = jsonx.quote("{\"code\":${jsonx.quote(code)}}")
    return "{\"id\":${jsonx.quote(id)},\"type\":\"function\",\"function\":{\"name\":\"run\",\"arguments\":${args}}}"
}

asst_calls_(calls: string, extra: string) -> string {
    return "{\"role\":\"assistant\",\"tool_calls\":[${calls}]${extra}}"
}

tool_msg_(id: string, content: string, extra: string) -> string {
    return "{\"role\":\"tool\",\"content\":${jsonx.quote(content)},\"tool_call_id\":${jsonx.quote(id)}${extra}}"
}

user_msg_(content: string) -> string { return "{\"role\":\"user\",\"content\":${jsonx.quote(content)}}" }

new_run_(calls: ptr) -> ptr { return timing.new() }

add_call_(run: ptr, name: string, ok: int, dispatched: int, run_index: int) {
    i = timing.reserve_entry(run, name)
    c = timing.entry(run, i) as *timing.Call
    c.ok = ok
    c.dispatched = dispatched
    c.run_index = run_index
    c.end_ms = 1
}

// A Viewport anchored at (entry, row), or following the bottom.
scroll_(has: int, entry_: int, row: int) -> *viewport.Viewport {
    s = viewport.new()
    s.has_top = has
    s.top_entry = entry_
    s.top_row = row
    return s
}

const BK_AGENT = 0
const BK_BASH = 1
const BK_RUN = 2

main() {
    fw = spec.init()
    spec.describe(fw, "tui.transcript") {
        spec.it("background results fold to task facts and expand to complete JSON") callback {
            t = transcript.new()
            result = "{\"ok\":true,\"text\":\"found it\\nsecond line\",\"changes\":[],\"usage\":{}}"
            transcript.background_result(t, BK_AGENT, "bg_1", true, result)
            e = e_(t, 0)
            spec.assert_true(entry.collapsible(e), "collapsible")
            spec.assert_eq(seg_count_(e), 2, "folded segments")
            streq(seg_text_(e, 1), "bg_1 agent · completed")
            transcript.toggle_all(t)
            spec.assert_eq(seg_count_(e), 4, "open segments")
            streq(seg_text_(e, 3), result)
            _a, found = transcript.last_answer(t)
            spec.assert_false(found, "no answer")
            transcript.background_result(t, BK_AGENT, "bg_2", false, "{\"ok\":false,\"text\":\"failed\"}")
            spec.assert_eq(e_(t, 1).open, 0, "second closed")
            streq(seg_text_(e_(t, 1), 0), "✗ ")
        }
        spec.it("restored background results retain their kind and complete result") callback {
            t = transcript.new()
            result = "{\"ok\":true,\"text\":\"result\"}"
            h = msgs_()
            push_(h, bg_msg_("background agent bg_1 finished\n${result}", "agent", "bg_1", ""))
            transcript.add_history(t, h)
            spec.assert_eq(e_(t, 0).kind, entry.KIND_BACKGROUND, "kind")
            streq(e_(t, 0).text, result)
            streq(e_(t, 0).label, "bg_1 agent · completed")
        }
        spec.it("background progress stays with its Run until the matching result arrives") callback {
            t = transcript.new()
            transcript.start_run(t, "tools.agent({})")
            transcript.progress(t, agent_tree.new_agent("a1", "first", run: 1, background: 1, step: 1))
            transcript.end_run(t, true, "started", 100, none_())
            transcript.start_run(t, "tools.read({})")
            transcript.progress(t, agent_tree.new_agent("a1", "first", run: 1, background: 1, step: 2))
            spec.assert_eq(e_(t, 0).agents.len, 1, "one agent")
            spec.assert_eq(agent_(e_(t, 0), 0).step, 2, "step 2")
            spec.assert_eq(e_(t, 1).agents.len, 0, "second run has none")
            spec.assert_true(string.contains(e_(t, 0).label, "a1 running") != 0, "label")
            transcript.background_result(t, BK_AGENT, "a1", true, "{\"ok\":true,\"text\":\"done\"}")
            spec.assert_eq(e_(t, 0).agent_tree.rows.len, 1, "tree rows")
            transcript.progress(t, agent_tree.new_agent("a1", "first", run: 1, background: 1, `state`: agent_tree.PS_DONE, step: 3))
            spec.assert_eq(agent_(e_(t, 0), 0).background, 0, "settled")
            streq(e_(t, 0).label, "Run")
            spec.assert_eq(e_(t, 2).kind, entry.KIND_BACKGROUND, "result entry")
        }
        spec.it("turn cleanup removes background working rows without removing delivered results") callback {
            t = transcript.new()
            transcript.start_run(t, "tools.bash({})")
            transcript.progress(t, agent_tree.new_agent("b1", "sleep 60", run: 1, kind: BK_BASH, background: 1))
            transcript.progress(t, agent_tree.new_agent("b2", "echo done", run: 1, kind: BK_BASH, background: 1))
            transcript.end_run(t, true, "started", 100, none_())
            transcript.background_result(t, BK_BASH, "b2", true, "{\"exit_code\":0,\"output\":\"done\"}")
            spec.assert_eq(e_(t, 0).agents.len, 2, "two agents")
            transcript.clear_background_progress(t)
            spec.assert_eq(e_(t, 0).agents.len, 1, "one left")
            streq(row_(e_(t, 0), 0), "  └─ b2 bash echo done · <1s · completed")
            streq(e_(t, 0).label, "Run")
            streq(e_(t, 1).label, "b2 bash · completed · exit 0")
        }
        spec.it("truncated background result still previews text and lost result is visible") callback {
            t = transcript.new()
            transcript.background_result(t, BK_AGENT, "a1", false, "{\"ok\":false,\"text\":\"partial result")
            streq(e_(t, 0).label, "a1 agent · failed")
            transcript.lost_background(t, BK_AGENT, "a2", "[background agent a2 lost: process ended]")
            streq(e_(t, 1).label, "a2 agent · lost")
            streq(e_(t, 1).text, "[background agent a2 lost: process ended]")
        }
        spec.it("background bash shows command and elapsed time until its result arrives") callback {
            t = transcript.new()
            transcript.start_run(t, "tools.bash({})")
            transcript.progress(t, agent_tree.new_agent("b1", "sleep 2\necho done", run: 1, kind: BK_BASH, background: 1, elapsed_ms: 1200))
            transcript.end_run(t, true, "started", 100, none_())
            streq(e_(t, 0).label, "Run · b1 running")
            transcript.toggle_all(t)
            streq(row_(e_(t, 0), 0), "  └─ b1 bash sleep 2 echo done · 1s · running")
            transcript.background_result(t, BK_BASH, "b1", true, "{\"exit_code\":0,\"output\":\"done\\n\"}")
            streq(e_(t, 0).label, "Run")
            streq(e_(t, 1).label, "b1 bash · completed · exit 0")
            transcript.toggle(t, 1)
            streq(seg_text_(e_(t, 1), 3), "{\"exit_code\":0,\"output\":\"done\\n\"}")
        }
        spec.it("restored background bash uses its persisted kind") callback {
            t = transcript.new()
            h = msgs_()
            push_(h, bg_msg_("[background bash b1 finished]\n{\"exit_code\":0,\"output\":\"ready\"}", "bash", "b1", ""))
            transcript.add_history(t, h)
            streq(e_(t, 0).label, "b1 bash · completed · exit 0")
            h2 = msgs_()
            push_(h2, bg_msg_("[background bash b2 finished]\n{\"exit_code\":1,\"output\":\"failed\"}", "bash", "b2", ""))
            transcript.add_history(t, h2)
            streq(e_(t, 1).label, "b2 bash · failed · exit 1")
            h3 = msgs_()
            push_(h3, bg_msg_("[background bash b3 finished]\n{\"output\":\"partial", "bash", "b3", "true"))
            transcript.add_history(t, h3)
            streq(e_(t, 2).label, "b3 bash · completed")
        }
        spec.it("runs fold to one line until expanded") callback {
            win = surf_win_(60, 24)
            t = transcript.new()
            transcript.start_run(t, "const a = await tools.bash({});\nconst b = await tools.bash({});\nawait tools.read({})")
            transcript.end_run(t, true, "line 1\nline 2", 1234, none_())
            e = e_(t, 0)
            spec.assert_eq(entry.height(e, win), 1, "folded height")
            streq(seg_text_(e, 2), "Run")
            transcript.toggle_all(t)
            spec.assert_eq(entry.height(e, win), 10, "open height")
        }
        spec.it("entry height cache reuses measurements and invalidates on width or append") callback {
            win = surf_win_(10, 24)
            e = entry.new_entry(entry.KIND_ASSISTANT)
            e.text = "1234567890"
            spec.assert_eq(entry.height(e, win), 1, "one row")
            e.cached_rows = 123
            spec.assert_eq(entry.height(e, win), 123, "cached")
            win.width = 5
            spec.assert_eq(entry.height(e, win), 2, "narrower")
            e.text = "${e.text}12345"
            spec.assert_eq(entry.height(e, win), 3, "appended")
        }
        spec.it("thinking stays hidden in streamed and restored transcripts") callback {
            t = transcript.new()
            transcript.append_delta(t, transcript.DELTA_REASONING, "think")
            spec.assert_eq(transcript.count(t), 0, "none")
            transcript.append_delta(t, transcript.DELTA_TEXT, "an")
            transcript.append_delta(t, transcript.DELTA_REASONING, "more thinking")
            transcript.append_delta(t, transcript.DELTA_TEXT, "swer")
            spec.assert_eq(transcript.count(t), 1, "one")
            a, _f = transcript.last_answer(t)
            streq(a, "answer")
            transcript.clear(t)
            h = msgs_()
            push_(h, user_msg_("hi"))
            push_(h, "{\"role\":\"assistant\",\"reasoning\":{\"provider\":\"codex\",\"data\":\"[{\\\"type\\\":\\\"reasoning\\\",\\\"summary\\\":[],\\\"encrypted_content\\\":\\\"opaque\\\"}]\"}}")
            push_(h, asst_calls_(call_("1", "tools.bash({})"), ",\"reasoning\":{\"provider\":\"chat_completions\",\"data\":\"hidden thinking\"}"))
            push_(h, tool_msg_("1", "out", ""))
            push_(h, "{\"role\":\"assistant\",\"content\":\"answer\",\"reasoning\":{\"provider\":\"codex\",\"data\":\"[{\\\"summary\\\":[{\\\"text\\\":\\\"hidden summary\\\"}]}]\"}}")
            transcript.add_history(t, h)
            spec.assert_eq(transcript.count(t), 3, "three")
            a2, _f2 = transcript.last_answer(t)
            streq(a2, "answer")
            streq(e_(t, 1).output, "out")
            spec.assert_eq(e_(t, 1).run, entry.RUN_OK, "ok")
        }
        spec.it("restored waiting replies are notices rather than answers") callback {
            t = transcript.new()
            h = msgs_()
            push_(h, "{\"role\":\"assistant\",\"content\":\"Waiting.\",\"waiting\":true}")
            transcript.add_history(t, h)
            spec.assert_eq(e_(t, 0).kind, entry.KIND_INFO, "info")
            _a, found = transcript.last_answer(t)
            spec.assert_false(found, "no answer")
        }
        spec.it("Run and background titles use the normal foreground while summaries stay dim") callback {
            surf = screen.surface(60, 8)
            win = screen.window(surf)
            t = transcript.new()
            transcript.start_run(t, "await tools.edit({})")
            transcript.end_run(t, true, "", 300, one_change_("src/a.zig", 1, 1, " keep\n-old\n+new\n"))
            e = e_(t, 0)
            entry.draw(e, win, true)
            streq(cell_(win, 2, 0).grapheme, "R")
            spec.assert_false(dim_(cell_(win, 2, 0)), "title not dim")
            spec.assert_true(dim_(cell_(win, 2, 1)), "summary dim")
            b = entry.new_entry(entry.KIND_BACKGROUND)
            b.run = entry.RUN_FAILED
            b.label = "b1 failed"
            shown = entry.segments(b)
            spec.assert_eq(screen.color_value(shown[0].style.fg), 1, "red")
            spec.assert_false(screen.has_attr(shown[1].style, screen.DIM), "label not dim")
        }
        spec.it("a Run shows changed files in its summary and a colored diff when open") callback {
            win = surf_win_(60, 24)
            t = transcript.new()
            transcript.start_run(t, "await tools.edit({})")
            cs = list.list_new()
            list.list_add_raw(cs, changes_("src/a.zig", 1, 1, 0, " keep\n-old\n+new\n"))
            list.list_add_raw(cs, changes_("b.md", 1, 0, 1, "+hi\n"))
            transcript.end_run(t, true, "", 300, turn_changes.change_text_new(cs))
            e = e_(t, 0)
            streq(e.label, "Run")
            spec.assert_eq(entry.height(e, win), 2, "folded height")
            transcript.toggle_all(t)
            shown = entry.segments(e)
            streq(shown[8].text, "-old\n")
            spec.assert_eq(screen.color_value(shown[8].style.fg), 1, "red")
            streq(shown[11].text, "+hi\n")
            spec.assert_eq(entry.height(e, win), 13, "open height")
            many = list.list_new()
            for i in 0..3 { list.list_add_raw(many, changes_("x", 2, 1, 0, "")) }
            text = turn_changes.change_text_new(many)
            streq(text.summary, "x +2 −1 · x +2 −1 · x +2 −1")
        }
        spec.it("an open Run emphasizes the changed middle of paired diff lines") callback {
            surf = screen.surface(40, 20)
            win = screen.window(surf)
            t = transcript.new()
            transcript.start_run(t, "x")
            diff_text = "-let count = 10; // total\n+let count = 11; // total\n"
            transcript.end_run(t, true, "", 300, one_change_("a.zig", 1, 1, diff_text))
            transcript.toggle_all(t)
            e = e_(t, 0)
            shown = entry.segments(e)
            streq(shown[7].text, "-let count = 1")
            streq(shown[8].text, "0")
            spec.assert_true(screen.has_attr(shown[8].style, screen.BOLD) && !screen.has_attr(shown[7].style, screen.BOLD), "bold middle")
            spec.assert_eq(screen.color_value(shown[8].style.fg), 1, "red")
            streq(shown[10].text, "+let count = 1")
            streq(shown[11].text, "1")
            spec.assert_eq(screen.color_value(shown[11].style.fg), 2, "green")
            rows = entry.draw(e, win, true)
            spec.assert_eq(entry.height(e, win), rows, "rows")
            streq(cell_(win, 14, 4).grapheme, "0")
            spec.assert_true(screen.has_attr(cell_(win, 14, 4).style, screen.BOLD), "bold cell")
            spec.assert_false(screen.has_attr(cell_(win, 13, 4).style, screen.BOLD), "plain neighbour")
        }
        spec.it("agent tree stays visible folded, expanded and after Run ends") callback {
            t = transcript.new()
            transcript.start_run(t, "await tools.agent({prompt: 'fix it'})")
            transcript.progress(t, agent_tree.new_agent("a1", "fix it", step: 3, tools: ["edit"], files: ["src/x.zig"]))
            e = e_(t, 0)
            streq(seg_text_(e, 2), "Run · running")
            streq(seg_text_(e, 1), "")
            transcript.toggle_all(t)
            streq(row_(e, 0), "  └─ a1 fix it · running · step 3 · edit src/x.zig")
            streq(e.text, seg_text_(e, 10))
            transcript.progress(t, agent_tree.new_agent("a1", "fix it", `state`: agent_tree.PS_DONE, step: 3, tools: ["edit"], files: ["src/x.zig"]))
            transcript.end_run(t, true, "done", 1234, none_())
            streq(seg_text_(e, 2), "Run")
            streq(seg_text_(e, 1), "")
            streq(seg_text_(e, 8), "done")
            streq(row_(e, 0), "  └─ a1 fix it · completed · step 3 · edit src/x.zig")
            transcript.progress(t, agent_tree.new_agent("a1", "late"))
            streq(e.label, "Run")
        }
        spec.it("multiple child progress keeps creation order, is replaced and summed without double counting cache") callback {
            t = transcript.new()
            transcript.start_run(t, "await Promise.all([tools.agent({}), tools.agent({}), tools.agent({})])")
            transcript.progress(t, agent_tree.new_agent("a3", "third", step: 1))
            transcript.progress(t, agent_tree.new_agent("a1", "first", step: 2, `state`: agent_tree.PS_DONE, tools: ["read"]))
            transcript.progress(t, agent_tree.new_agent("a2", "second", step: 3, tools: ["edit"], files: ["a.zig"]))
            e = e_(t, 0)
            streq(seg_text_(e, 2), "Run · running")
            transcript.toggle_all(t)
            spec.assert_eq(e.agent_tree.rows.len, 3, "three rows")
            streq(row_(e, 0), "  ├─ a3 third · running · step 1")
            streq(row_(e, 1), "  ├─ a1 first · completed · step 2 · read")
            streq(row_(e, 2), "  └─ a2 second · running · step 3 · edit a.zig")
            transcript.progress(t, agent_tree.new_agent("a3", "third", `state`: agent_tree.PS_TIMED_OUT, step: 1))
            spec.assert_eq(e.agents.len, 3, "still three")
            streq(e.label, "Run · a3 timed out · running")
            transcript.end_run(t, true, "out", 9000, none_())
            streq(e.label, "Run · a3 timed out")
        }
        spec.it("child prompt preview uses forty Unicode characters and one logical line") callback {
            t = transcript.new()
            transcript.start_run(t, "tools.agent({})")
            cjk = "中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中"
            prompt = "${cjk}\nnot shown"
            transcript.progress(t, agent_tree.new_agent("a1", prompt, `state`: agent_tree.PS_QUEUED))
            e = e_(t, 0)
            streq(row_(e, 0), "  └─ a1 ${cjk}  · queued · step 0")
            e.has_cached = 1
            e.cached_width = 80
            e.cached_len = string.length(e.text)
            e.cached_open = 0
            e.cached_rows = 10
            transcript.progress(t, agent_tree.new_agent("a1", prompt, `state`: agent_tree.PS_WORKING))
            spec.assert_eq(e.has_cached, 0, "cache dropped")
        }
        spec.it("user cards tint wrapped rows, retain terminal foreground and leave gaps unstyled") callback {
            surf = screen.surface(18, 8)
            win = screen.window(surf)
            t = transcript.new()
            transcript.add(t, entry.KIND_USER, "hello world message\n第二行")
            en = e_(t, 0)
            en.user_bg = screen.color_rgb(15, 20, 28)
            height = entry.height(en, win)
            spec.assert_true(height >= 3, "height >= 3")
            spec.assert_eq(entry.draw(en, win, true), height, "draw rows")
            for row in 0..height {
                streq(cell_(win, 0, row).grapheme, "▎")
                spec.assert_eq(cell_(win, 17, row).style.bg, en.user_bg, "tint row ${row}")
                body = cell_(win, 2, row)
                spec.assert_eq(body.style.fg, screen.DEFAULT, "default fg")
                spec.assert_false(screen.has_attr(body.style, screen.BOLD), "not bold")
            }
            streq(cell_(win, 2, 0).grapheme, "h")
            streq(cell_(win, 1, 0).grapheme, " ")
            spec.assert_eq(cell_(win, 0, height).style.bg, screen.DEFAULT, "gap unstyled")
            screen.clear(win)
            entry.draw(en, screen.child(win, y_off: -1, height: height), true)
            streq(cell_(win, 0, 0).grapheme, "▎")
            spec.assert_eq(cell_(win, 0, height - 1).style.bg, screen.DEFAULT, "clipped row unstyled")
        }
        spec.it("long user messages fold live and replayed, truncate the first line, and expand") callback {
            surf = screen.surface(30, 12)
            win = screen.window(surf)
            t = transcript.new()
            raw = "a very long first line that must be clipped\n2\n3\n4\n5\n6"
            transcript.add(t, entry.KIND_USER, raw)
            e = e_(t, 0)
            spec.assert_eq(entry.height(e, win), 1, "folded")
            entry.draw(e, win, true)
            streq(cell_(win, 28, 0).grapheme, "s")
            spec.assert_true(dim_(cell_(win, 28, 0)), "dim suffix")
            transcript.toggle_all(t)
            spec.assert_true(entry.height(e, win) > 5, "expanded")
            transcript.clear(t)
            h = msgs_()
            push_(h, user_msg_(raw))
            transcript.add_history(t, h)
            e2 = e_(t, 0)
            spec.assert_eq(entry.height(e2, win), 1, "replayed folded")
            transcript.toggle_all(t)
            spec.assert_true(entry.height(e2, win) > 5, "replayed expanded")
            transcript.add(t, entry.KIND_USER, raw)
            spec.assert_eq(e_(t, 1).open, 0, "new one closed")
            spec.assert_eq(entry.height(e_(t, 1), win), 1, "new one folded")
            xs800 = ""
            for i in 0..800 { xs800 = "${xs800}x" }
            transcript.add(t, entry.KIND_USER, "${xs800}x")
            spec.assert_eq(entry.height(e_(t, 2), win), 1, "801 chars folds")
            transcript.add(t, entry.KIND_USER, xs800)
            spec.assert_true(entry.height(e_(t, 3), win) > 1, "800 chars wraps")
        }
        spec.it("bills stay dim and one row when resized or expanded") callback {
            surf = screen.surface(120, 3)
            win = screen.window(surf)
            t = transcript.new()
            full = bill.format_footer(turn_summary.new("completed", 12, turn_summary.usage(), turn_summary.timing(190000, 0, 0, 0, 0, 8, 1)), 2, 120)
            transcript.add(t, entry.KIND_BILL, full)
            en = e_(t, 0)
            widths = [120, 40, 8, 1, 0, 120]
            for wi in 0..widths.len {
                width = widths[wi]
                win.width = width
                screen.clear(win)
                transcript.toggle_all(t)
                spec.assert_eq(entry.height(en, win), 1, "height at ${width}")
                spec.assert_eq(entry.draw(en, win, true), 1, "draw at ${width}")
                expected = bill.fit(full, width)
                col = 0
                off = 0
                while off < string.length(expected) {
                    n = screen.codepoint_len(expected, off)
                    cell = cell_(win, col, 0)
                    streq(cell.grapheme, string.substring(expected, off, off + n))
                    spec.assert_true(dim_(cell), "dim")
                    col = col + 1
                    off = off + n
                }
                for x in 0..120 {
                    c, _o = screen.read_cell(surf, x, 1)
                    streq(c.grapheme, " ")
                }
            }
        }
        spec.it("queued users have a dim marker until their insertion event") callback {
            t = transcript.new()
            transcript.add(t, entry.KIND_USER, "first")
            e_(t, 0).queued = 1
            transcript.add(t, entry.KIND_USER, "second")
            e_(t, 1).queued = 2
            queued = entry.segments(e_(t, 0))
            streq(queued[2].text, " · queued")
            spec.assert_true(screen.has_attr(queued[2].style, screen.DIM), "dim")
            win = surf_win_(10, 24)
            entry.height(e_(t, 0), win)
            transcript.user_inserted(t, 1)
            spec.assert_eq_long(e_(t, 0).queued, -1, "not queued")
            spec.assert_eq(e_(t, 0).has_cached, 0, "cache dropped")
            spec.assert_eq(seg_count_(e_(t, 0)), 2, "two segments")
            transcript.remove_queued(t)
            spec.assert_eq(transcript.count(t), 1, "one left")
            streq(e_(t, 0).text, "first")
        }
        spec.it("Run retains effort metadata without exposing it in the title") callback {
            t = transcript.new()
            efforts = ["low", "high", "default"]
            for i in 0..efforts.len {
                transcript.start_run_with_effort(t, "tools.edit({})", efforts[i])
                e = e_(t, transcript.count(t) - 1)
                streq(e.step_effort, efforts[i])
                spec.assert_eq(e.has_step_effort, 1, "has effort")
                streq(e.label, "Run · running")
                ct = none_()
                ct.summary = "a.zig +1 −0"
                transcript.end_run(t, true, "output", 1234, ct)
                streq(e.label, "Run")
                streq(e.changes.summary, "a.zig +1 −0")
            }
        }
        spec.it("history Run effort is copied from assistant metadata and absent in legacy history") callback {
            t = transcript.new()
            calls = call_("1", "tools.bash({})")
