            transcript.start_run(t, "for (;;) tools.read({}); tools.llm({})")
            summary = tool_summary.init(run, 0, timing.omitted(run))
            transcript.end_run_with_summary(t, true, "done", 0, none_(), summary as ptr)
            streq(e_(t, 0).label, "Run · read ×200 · +3")
            only = tool_summary.empty()
            only.omitted = 3
            streq(label.actual_tool_summary(only, 0), "+3")
        }
        spec.it("empty actual summary does not fall back to source text") callback {
