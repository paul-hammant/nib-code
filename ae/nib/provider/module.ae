// provider: one model request over the configured wire protocol, with the
// shared retry policy (upstream src/provider.zig `stream` and
// src/provider/retry.zig `complete`), and the effort a Config resolves to.
//
// complete() reports through a Retry observer: started / finished around
// every attempt, retry (attempt, delay_ms, reason) before a backoff, failed
// (attempt, err, reason) when it gives up. Backoff is 1 s << (attempt-1),
// up to MAX_ATTEMPTS attempts, slept in 100 ms slices so cancel interrupts it.

import std.list
import std.string
import std.sync
import nib.provider.types
import nib.provider.sink
import nib.provider.model_timing
import nib.provider.anthropic
import nib.provider.responses
import nib.provider.openai

exports(Retry, MAX_ATTEMPTS, retry_new, stream, complete, complete_with, transient, effective_effort,
        logged_effort)

const MAX_ATTEMPTS = 5

struct Retry {
    ctx: ptr
    on_event: fn       // |ctx: ptr, kind: string, attempt: int, delay_ms: long, reason: string|
    has_event: int     // kind: started, finished, retry, failed (reason carries err for failed: "<err>\t<reason>")
    wait: int          // 0: no backoff sleep (tests)
}

retry_new(ctx: @keep ptr) -> ptr {
    r = heap.new(Retry)
    r.ctx = ctx
    r.has_event = 0
    r.wait = 1
    return r as ptr
}

emit_(rp: ptr, kind: string, attempt: int, delay: long, reason: string) {
    if rp == null { return }
    r = rp as *Retry
    if r.has_event == 1 { call(r.on_event, r.ctx, kind, attempt, delay, reason) }
}

// The effort name a Config resolves to for display.
effective_effort(cp: ptr) -> string {
    c = cp as *types.Config
    p = types.protocol(cp)
    if p == "responses" {
        e = responses.reasoning_effort(cp)
        if e == "" { return "server default" }
        return e
    }
    if p == "anthropic_messages" {
        e2 = anthropic.effort(cp)
        if e2 == "" { return "server default" }
        return e2
    }
    if c.thinking == 0 { return "off" }
    if c.reasoning_effort != "" { return c.reasoning_effort }
    if c.thinking == 1 { return "on (server default effort)" }
    return "server default"
}

// The effort logged per Step: server defaults as "default".
logged_effort(cp: ptr) -> string {
    e = effective_effort(cp)
    if e == "server default" || e == "on (server default effort)" { return "default" }
    return e
}

// One attempt over the Config's protocol.
stream(cp: ptr, cache_key: string, messages: ptr, tools_json: string, max_tokens: int, sk: @keep ptr, cancel: ptr) -> (ptr, string, string) {
    p = types.protocol(cp)
    r = null
    err = ""
    detail = ""
    if p == "anthropic_messages" {
        r, err, detail = anthropic.stream(cp, messages, tools_json, max_tokens, sk, cancel)
    } else if p == "responses" {
        r, err, detail = responses.stream(cp, cache_key, messages, tools_json, max_tokens, sk, cancel)
    } else {
        r, err, detail = openai.stream(cp, messages, tools_json, max_tokens, sk, cancel)
    }
    if err != "" && cancel != null && sync.atomic_load(cancel) != 0 { return null, "Canceled", "" }
    return r, err, detail
}

transient(err: string) -> int {
    match err {
        "HttpStatus" -> { return 0 }
        "InvalidCredentials" -> { return 0 }
        "ProviderFailed" -> { return 0 }
        "Canceled" -> { return 0 }
        "OutOfMemory" -> { return 0 }
        "TooManyToolCalls" -> { return 0 }
        _ -> { return 1 }
    }
}

sleep_(ms: long, cancel: ptr) -> int {
    left = ms
    while left > 0 {
        if cancel != null && sync.atomic_load(cancel) != 0 { return 0 }
        step = left
        if step > 100 { step = 100 as long }
        sleep(step as int)
        left = left - step
    }
    return 1
}

// complete with retries. replay_safe: the caller buffers deltas, so an
// attempt that already streamed some may still be retried.
// (reply, "", "", attempts) or (null, err, detail, attempts).
complete(cp: ptr, cache_key: string, messages: ptr, tools_json: string, max_tokens: int, sk: @keep ptr, cancel: ptr,
         replay_safe: int, rp: ptr) -> (ptr, string, string, int) {
    return complete_with(|c2: ptr, k: string, m: ptr, t: string, mt: int, s2: @keep ptr, cl: ptr, out: ptr| {
        r, e, d = stream(c2, k, m, t, mt, s2, cl)
        o = out as *types.Reply
        o.phase = e
        o.text = d
        o.tool_calls = r
    }, cp, cache_key, messages, tools_json, max_tokens, sk, cancel, replay_safe, rp)
}

// The retry loop over `request` (|cfg, key, messages, tools, max, sink, cancel, out|
// filling out: *types.Reply with phase = err, text = detail, tool_calls = the reply).
complete_with(request: fn(ptr, string, ptr, string, int, @keep ptr, ptr, ptr), cp: ptr, cache_key: string, messages: ptr, tools_json: string, max_tokens: int, sk: @keep ptr,
              cancel: ptr, replay_safe: int, rp: ptr) -> (ptr, string, string, int) {
    attempt = 1
    while true {
        (sk as *sink.Sink).emitted = 0
        emit_(rp, "started", attempt, 0 as long, "")
        out = types.reply_new() as *types.Reply
        tm = (sk as *sink.Sink).timing
        attempt_start = 0 as long
        if tm != null {
            model_timing.reset_attempt(tm)
            attempt_start = model_timing.elapsed(tm)
        }
        call(request, cp, cache_key, messages, tools_json, max_tokens, sk, cancel, out as ptr)
        emit_(rp, "finished", attempt, 0 as long, "")
        err = out.phase
        if tm != null {
            failed_detail = out.text
            if err == "" { failed_detail = "" }
            model_timing.finish_attempt(tm, attempt_start, err, failed_detail)
        }
        if err == "" { return out.tool_calls, "", "", attempt }
        detail = out.text
        if err == "Canceled" || (cancel != null && sync.atomic_load(cancel) != 0) { return null, "Canceled", detail, attempt }
        reason = detail
        if reason == "" { reason = err }
        emitted = (sk as *sink.Sink).emitted
        if (emitted == 1 && replay_safe == 0) || attempt == MAX_ATTEMPTS || transient(err) == 0 {
            emit_(rp, "failed", attempt, 0 as long, "${err}\t${reason}")
            return null, err, detail, attempt
        }
        delay = (1000 as long) * ((1 as long) << ((attempt - 1) as long))
        emit_(rp, "retry", attempt, delay, reason)
        waits = 1
        if rp != null { waits = (rp as *Retry).wait }
        if waits == 1 {
            if sleep_(delay, cancel) == 0 { return null, "Canceled", "", attempt }
        } else if cancel != null && sync.atomic_load(cancel) != 0 {
            return null, "Canceled", "", attempt
        }
        attempt = attempt + 1
    }
}
