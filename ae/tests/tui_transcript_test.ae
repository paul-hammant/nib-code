            push_(h, tool_msg_("1", "out", ""))
            push_(h, asst_calls_(calls, ""))
            push_(h, tool_msg_("1", "out", ""))
            transcript.add_history(t, h)
            streq(e_(t, 0).step_effort, "high")
            spec.assert_eq(e_(t, 1).has_step_effort, 0, "legacy has none")
