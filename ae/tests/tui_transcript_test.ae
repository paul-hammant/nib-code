            streq(e_(t, 0).label, "Run")
            streq(e_(t, 1).label, "Run")
        }
        spec.it("agent rows have stable heights across folding resizing completion and scrolling") callback {
            surf = screen.surface(100, 12)
            win = screen.window(surf)
            t = transcript.new()
            transcript.start_run(t, "await tools.agent({})")
            transcript.progress(t, agent_tree.new_agent("a2", "second", step: 3))
            transcript.progress(t, agent_tree.new_agent("a1", "first", `state`: agent_tree.PS_DONE, step: 2))
            e = e_(t, 0)
            cols = [100, 48, 20, 1, 100]
            for ci in 0..cols.len {
                win.width = cols[ci]
                spec.assert_eq(entry.height(e, win), 3, "height")
                spec.assert_eq(entry.draw(e, win, false), 3, "draw")
            }
            entry.draw(e, win, true)
            streq(cell_(win, 2, 1).grapheme, "├")
            streq(cell_(win, 2, 2).grapheme, "└")
            streq(cell_(win, 0, 3).grapheme, " ")
            transcript.toggle_all(t)
            spec.assert_eq(entry.height(e, win), 9, "open height")
            entry.draw(e, win, true)
            streq(cell_(win, 0, 3).grapheme, "C")
            transcript.progress(t, agent_tree.new_agent("a2", "second", `state`: agent_tree.PS_FAILED, step: 4, tools: ["bash"]))
            spec.assert_eq(entry.height(e, win), 9, "after failure")
            transcript.end_run(t, true, "result", 2000, none_())
            spec.assert_eq(entry.height(e, win), 9, "after end")
            entry.draw(e, win, true)
            streq(cell_(win, 0, 5).grapheme, "R")
            streq(row_(e, 0), "  ├─ a2 second · failed · step 4 · bash")
            transcript.toggle_all(t)
            spec.assert_eq(entry.height(e, win), 3, "folded again")
            screen.clear(win)
            entry.draw(e, screen.child(win, y_off: -1), true)
            streq(cell_(win, 2, 0).grapheme, "├")
            streq(cell_(win, 2, 1).grapheme, "└")
            streq(cell_(win, 0, 2).grapheme, " ")
            transcript.start_run(t, "1 + 1")
            spec.assert_eq(entry.height(e_(t, 1), win), 1, "second run")
            spec.assert_eq(entry.height(e_(t, 0), win), 3, "first run")
        }
        spec.it("completed Run replaces source estimate with dispatched host tools") callback {
            t = transcript.new()
            transcript.start_run(t, "await tools.edit({new_text: 'tools.llm( tools.llm( tools.write('}); await tools.bash({})")
            streq(e_(t, 0).label, "Run · running")
            run = timing.new()
            add_call_(run, "edit", 1, 1, 0)
            add_call_(run, "llm", 0, 0, 0)
            add_call_(run, "bash", 0, 1, 0)
            summary = tool_summary.init(run, 0, 0)
            transcript.end_run_with_summary(t, false, "failed bash", 200, none_(), summary as ptr)
            streq(e_(t, 0).label, "Run · edit · bash")
        }
        spec.it("completed Run includes omitted calls without guessing their names") callback {
            t = transcript.new()
