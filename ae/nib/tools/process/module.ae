// tools.process: one child in its own process group, output (stdout and
// stderr, merged by the caller's command) captured whole, stopped by cancel,
// deadline or output size (upstream src/tools/process.zig). The call returns
// when the child exits; anything left in its group is killed then (nohup and
// & descendants included); daemons that left the group keep running and
// cannot hold the call open, since output goes to a file, not a pipe.

import std.os
import std.fs
import std.string
import std.list
import std.sync
import std.worker
import std.cryptography
import std.ipc
import std.io
import nib.sysenv

exports(Result, run, run_ticking, run_lines, open_stdio, kill_child, close_fd, environ, STOP_NONE, STOP_CANCELED, STOP_TIMED_OUT)

const STOP_NONE = ""
const STOP_CANCELED = "Canceled"
const STOP_TIMED_OUT = "TimedOut"

struct Result {
    exit_code: int      // the shell's status (128+n after a signal)
    stop: string        // "", "Canceled", "TimedOut"
    output: string
    error: string       // "" or "OutputLimit" or the spawn error
    start_ms_epoch: long
    end_ms_epoch: long
}

// This process's environment as "NAME=value" strings.
environ() -> ptr { return sysenv.environ() }

struct Waiter {
    token: int
    done: ptr
    code: int
}

set_(c: ptr) -> int {
    if c == null { return 0 }
    if sync.atomic_load(c) != 0 { return 1 }
    return 0
}

output_size_(path: string) -> long {
    st, kind, _e = fs.stat(path, 1)
    if kind != fs.KIND_OK { return 0 }
    return st.size
}

// argv: program first. env: "NAME=value" list or null (inherit). cancels: up
// to two std.sync cells (either set cancels; may be null). timeout_ms 0: none.
run(argv: ptr, env: ptr, cancel_a: ptr, cancel_b: ptr, timeout_ms: long, max_output: long) -> ptr {
    return run_ticking(argv, env, cancel_a, cancel_b, timeout_ms, max_output, null, |ctx: ptr, bytes: long| {}, 0)
}

// run, calling tick(tick_ctx, output_bytes_so_far) every ~20 ms while the
// child runs (the progress tracker's clock and byte count). has_tick 0: never.
run_ticking(argv: ptr, env: ptr, cancel_a: ptr, cancel_b: ptr, timeout_ms: long, max_output: long, tick_ctx: @keep ptr, tick: @keep fn, has_tick: int) -> ptr {
    r = heap.new(Result)
    r.exit_code = -1
    r.stop = ""
    r.output = ""
    r.error = ""
    r.start_ms_epoch = os.now_unix_ms()
    r.end_ms_epoch = 0
    hex, _h = cryptography.random_hex(12)
    out_path = "${os.temp_dir()}/nib-out-${hex}"
    prog, _e = list.get_string(argv, 0)
    rest = list.list_new()
    i = 1
    while i < list.list_size(argv) {
        a, _e2 = list.get_string(argv, i)
        list.list_add(rest, a)
        i = i + 1
    }
    token, serr = os.spawn_proc_to(prog, rest, env, out_path)
    if serr != "" {
        r.error = serr
        fs.unlink(out_path)
        return r as ptr
    }
    w = heap.new(Waiter)
    w.token = token
    w.done = sync.atomic_new(0)
    w.code = -1
    wp = w as ptr
    worker.run_detached(|| {
        ww = wp as *Waiter
        code, _we = os.wait(ww.token)
        ww.code = code
        sync.atomic_store(ww.done, 1)
        return null
    })
    deadline = 0 as long
    if timeout_ms > 0 { deadline = os.now_monotonic_ms() + timeout_ms }
    killed = 0
    beat = 0
    while sync.atomic_load(w.done) == 0 {
        if killed == 0 && beat % 4 == 0 {
            size = output_size_(out_path)
            if set_(cancel_a) == 1 || set_(cancel_b) == 1 {
                r.stop = STOP_CANCELED
            } else if deadline != 0 && os.now_monotonic_ms() >= deadline {
                r.stop = STOP_TIMED_OUT
            } else if size > max_output {
                r.error = "OutputLimit"
            }
            if r.stop != "" || r.error != "" {
                os.kill(0 - token, 9)
                killed = 1
            }
            if has_tick == 1 { call(tick, tick_ctx, size) }
        }
        beat = beat + 1
        sleep(5)
    }
    r.end_ms_epoch = os.now_unix_ms()
    // The shell is gone: end whatever it left in its group.
    os.kill(0 - token, 9)
    r.exit_code = w.code
    sync.atomic_free(w.done)
    if r.error == "" && output_size_(out_path) > max_output { r.error = "OutputLimit" }
    if r.error == "" && r.stop == "" {
        data, rerr = fs.read(out_path)
        if rerr == "" { r.output = data }
    }
    fs.unlink(out_path)
    return r as ptr
}

// ---- a child nib (tools.agent): stdin input, stdout lines as they come ----

struct Feeder {
    fd: int
    input: string
    done: ptr
}

// Starts argv with `input` on its stdin and stdout read as it arrives:
// line(line_ctx, text) for each complete line (newline removed) before the
// child exits, the whole output kept in Result.output. Stderr is this
// process's. Cancel or the deadline (timeout_ms 0: none) sends TERM, then
// KILL after grace_ms. After exit, output is drained for at most 500 ms
// (a descendant may hold the pipe). exit_code is the status (128+n after a
// signal); error "OutputLimit" past max_output, or the spawn error.
run_lines(argv: ptr, env: ptr, input: string, cancel: ptr, timeout_ms: long, grace_ms: long, max_output: long, line_ctx: @keep ptr, line: @keep fn) -> ptr {
    r = heap.new(Result)
    r.exit_code = -1
    r.stop = ""
    r.output = ""
    r.error = ""
    r.start_ms_epoch = os.now_unix_ms()
    r.end_ms_epoch = 0
    // The child's stderr is discarded, as upstream's (.stderr = .ignore).
    prog, rest = split_argv_(argv)
    to_fd, from_fd, pid, serr = os.run_stdio(prog, rest, env, stderr_to: os.STDERR_DISCARD)
    if serr != "" {
        r.error = serr
        return r as ptr
    }
    f = heap.new(Feeder)
    f.fd = to_fd
    f.input = input
    f.done = sync.atomic_new(0)
    fp = f as ptr
    worker.run_detached(|| {
        ff = fp as *Feeder
        // write_some reports a gone reader as an error; a plain write could raise SIGPIPE.
        off = 0
        n = string.length(ff.input)
        while off < n {
            ipc.wait_writable(ff.fd, 50)
            wrote, werr = ipc.write_some(ff.fd, ff.input, off)
            if werr != "" { break }
            off = off + wrote
        }
        io.fd_close(ff.fd)
        sync.atomic_store(ff.done, 1)
        return null
    })
    w = heap.new(Waiter)
    w.token = pid
    w.done = sync.atomic_new(0)
    w.code = -1
    wp = w as ptr
    worker.run_detached(|| {
        ww = wp as *Waiter
        code, _we = os.wait_pid(ww.token)
        ww.code = code
        sync.atomic_store(ww.done, 1)
        return null
    })
    deadline = 0 as long
    if timeout_ms > 0 { deadline = os.now_monotonic_ms() + timeout_ms }
    term_at = 0 as long
    killed = 0
    exited_at = 0 as long
    buffer = ""
    total = ""
    while true {
        now = os.now_monotonic_ms()
        if sync.atomic_load(w.done) != 0 {
            if exited_at == 0 { exited_at = now }
        } else if r.stop == "" && r.error == "" {
            if set_(cancel) == 1 {
                r.stop = STOP_CANCELED
            } else if deadline != 0 && now >= deadline {
                r.stop = STOP_TIMED_OUT
            }
            if r.stop != "" {
                os.kill(pid, 15)
                term_at = now
            }
        }
        if term_at > 0 && killed == 0 && sync.atomic_load(w.done) == 0 && now - term_at >= grace_ms {
            os.kill(pid, 9)
            killed = 1
        }
        if exited_at > 0 && now - exited_at > 500 { break }
        ready, _rerr = ipc.wait_readable(from_fd, 20)
        if ready == 1 {
            data, derr = ipc.read(from_fd, 65536)
            if derr != "" || string.length(data) == 0 { break }
            total = "${total}${data}"
            if string.length(total) > max_output {
                r.error = "OutputLimit"
                os.kill(pid, 9)
                killed = 1
                break
            }
            buffer = "${buffer}${data}"
            nl = string.index_of(buffer, "\n")
            while nl >= 0 {
                text = string.substring(buffer, 0, nl)
                call(line, line_ctx, text)
                buffer = string.substring(buffer, nl + 1, string.length(buffer))
                nl = string.index_of(buffer, "\n")
            }
        }
    }
    while sync.atomic_load(w.done) == 0 {
        now2 = os.now_monotonic_ms()
        if r.stop == "" && r.error == "" {
            if set_(cancel) == 1 {
                r.stop = STOP_CANCELED
            } else if deadline != 0 && now2 >= deadline {
                r.stop = STOP_TIMED_OUT
            }
            if r.stop != "" {
                os.kill(pid, 15)
                term_at = now2
            }
        }
        if term_at > 0 && killed == 0 && now2 - term_at >= grace_ms {
            os.kill(pid, 9)
            killed = 1
        }
        sleep(10)
    }
    io.fd_close(from_fd)
    r.end_ms_epoch = os.now_unix_ms()
    r.exit_code = w.code
    r.output = total
    return r as ptr
}

// ---- a long-lived child with stdin/stdout pipes (tools.mcp_transport) ----

// Starts argv (program first) in directory `cwd` with the pipes the caller
// keeps: (to_child_fd, from_child_fd, pid, ""), or (-1, -1, -1, reason).
// stderr is discarded (upstream's .stderr = .ignore). The caller reads and
// writes the fds with std.ipc, and ends the child with kill_child and close_fd.
open_stdio(argv: ptr, env: ptr, cwd: string) -> (int, int, int, string) {
    prog, rest = split_argv_(argv)
    return os.run_stdio(prog, rest, env, stderr_to: os.STDERR_DISCARD, cwd: cwd)
}

// argv (program first) as run_stdio takes it: the program, and a new list of
// the arguments after it.
split_argv_(argv: ptr) -> (string, ptr) {
    prog, _e = list.get_string(argv, 0)
    rest = list.list_new()
    i = 1
    while i < list.list_size(argv) {
        a, _e2 = list.get_string(argv, i)
        list.list_add(rest, a)
        i = i + 1
    }
    return prog, rest
}

close_fd(fd: int) { io.fd_close(fd) }

// KILL the child and reap it (upstream Transport.close's kill).
kill_child(pid: int) {
    os.kill(pid, 9)
    os.wait_pid(pid)
}
