                expect_parse_fails_(bads[i])
                i = i + 1
            }
            r = ok_(env.new(), "[hooks]\nafter_edit = [\"a\", \"b\"]\nturn_end = [\"c\"]")
            spec.assert_eq(list.list_size(cfg_(r).hooks_after_edit), 2, "resolved after_edit")
            spec.assert_str_eq(str_(cfg_(r).hooks_turn_end, 0), "c", "resolved turn_end")
        }
        spec.it("MCP config validates transports, names, arrays and switches with line diagnostics") callback {
            f = expect_parse_ok_("[mcp]\ngithub = true\n[mcp.github]\ncommand = \"server\"\nargs = [\"stdio\"]\nenv = [\"GITHUB_TOKEN\"]\n[mcp.docs]\nurl = \"https://example.com/mcp\"\nheader_env = \"DOCS_MCP_TOKEN\"\n")
            spec.assert_eq(list.list_size(f.mcp_servers), 2, "two servers")
            s0 = list.list_get_raw(f.mcp_servers, 0) as *types.McpServer
            s1 = list.list_get_raw(f.mcp_servers, 1) as *types.McpServer
            spec.assert_eq(s0.enabled, 1, "github on")
            spec.assert_eq(s1.enabled, 0, "docs off")
            spec.assert_str_eq(str_(s0.env, 0), "GITHUB_TOKEN", "env name")
            spec.assert_str_eq(str_(s0.args, 0), "stdio", "args")
            spec.assert_str_eq(s0.command, "server", "command")
            spec.assert_str_eq(s1.url, "https://example.com/mcp", "url")
            spec.assert_str_eq(s1.header_env, "DOCS_MCP_TOKEN", "header_env")
            spec.assert_true(s0.line == 3 && s1.line == 7, "section lines ${s0.line} ${s1.line}")
            bads = ["[mcp.x]\ncommand = \"x\"\nurl = \"http://x\"", "[mcp.x]\nargs = []", "[mcp.x]\nurl = \"file:///x\"", "[mcp.x]\nurl = \"https://user:secret@x\"",
                    "[mcp.x]\ncommand = \"x\"\nenv = [\"X=secret\"]", "[mcp.x]\ncommand = \"x\"\ncommand = \"y\"", "[mcp.x]\ncommand = \"x\"\nheader_env = \"KEY\"",
                    "[mcp_dynamic]\ncommand = \"x\"", "[mcp]\nx = \"true\"", "[mcp.bad.id]\ncommand = \"x\"", "[mcp.x]\nurl = \"https://x\"\nargs = [\"x\"]"]
            i = 0
            while i < 11 {
                fp, d = config.parse(bads[i], "test")
                spec.assert_true(fp == null, "bad ${i}")
                spec.assert_true(string.starts_with(d, "test:"), "prefix ${d}")
                i = i + 1
            }
            // The two post-checks cite the section's line.
            _fp1, d1 = config.parse("\n[mcp.x]\ncommand = \"x\"\nurl = \"http://x\"", "test")
            spec.assert_str_eq(d1, "test:2: MCP server requires exactly one of command or url", "both transports")
            _fp2, d2 = config.parse("[mcp.x]\ncommand = \"x\"\nheader_env = \"KEY\"", "test")
            spec.assert_str_eq(d2, "test:1: header_env requires url", "header_env")
            _fp3, d3 = config.parse("[mcp.x]\nurl = \"https://x\"\nargs = [\"x\"]", "test")
            spec.assert_str_eq(d3, "test:1: args and env require command", "args with url")
            r = ok_(env.new(), "[mcp]\ngithub = true\n[mcp.github]\ncommand = \"server\"\n")
            spec.assert_eq(list.list_size(cfg_(r).mcp_servers), 1, "the config keeps the servers")
            spec.assert_eq((list.list_get_raw(cfg_(r).mcp_servers, 0) as *types.McpServer).enabled, 1, "enabled")
        }
        spec.it("MCP atomic toggles preserve nested definitions and CRLF comments") callback {
            d = tmp_()
            fs.write("${d}/config.toml", "[mcp]\r\nx = false # keep\r\n[mcp.x]\r\ncommand = \"server\"\r\n")
            spec.assert_str_eq(config.save_mcp(d, "x", 1), "", "toggle")
            spec.assert_str_eq(read_("${d}/config.toml"), "[mcp]\r\nx = true # keep\r\n[mcp.x]\r\ncommand = \"server\"\r\n", "only the value changed")
            spec.assert_str_eq(config.save_mcp(d, "new", 0), "", "new switch")
            servers, err = config.load_mcp(d)
            spec.assert_str_eq(err, "", "load")
            spec.assert_eq((list.list_get_raw(servers, 0) as *types.McpServer).enabled, 1, "x enabled")
            spec.assert_true(contains_(read_("${d}/config.toml"), "new = false\r\n[mcp.x]") == 1, "switch added at the end of [mcp]")
            fs.remove_tree(d)
        }
        spec.it("simple persistence preserves surrounding configuration and rejects invalid values") callback {
            d = tmp_()
            fs.write("${d}/config.toml", "# keep\n[openai]\n")
            e = env.new()
            vals = [1, 0, 1]
            i = 0
            while i < 3 {
                spec.assert_str_eq(config.save_simple(d, vals[i]), "", "save ${i}")
                text = read_("${d}/config.toml")
                spec.assert_true(string.ends_with(text, "# keep\n[openai]\n"), "tail kept ${text}")
                spec.assert_eq(cfg_(ok_(e, text)).simple, vals[i], "simple ${i}")
                i = i + 1
            }
            expect_parse_fails_("ui = true")
            expect_parse_fails_("ui = \"bad\"")
            expect_parse_fails_("ui = \"normal\"\nui = \"simple\"")
            fs.remove_tree(d)
        }
        spec.it("open command template is an optional non-empty top-level string") callback {
            e = env.new()
            spec.assert_eq(cfg_(ok_(e, "")).open == "", 1, "none by default")
            spec.assert_str_eq(cfg_(ok_(e, "open = \"zed {path}:{line}\"\n[openai]\n")).open, "zed {path}:{line}", "template")
            bads = ["open = \"\"", "open = \"  \"", "open = 3", "open = \"a\"\nopen = \"b\""]
            i = 0
            while i < 4 {
                expect_parse_fails_(bads[i])
                i = i + 1
            }
        }
    }
    spec.describe(fw, "config (port additions)") {
        spec.it("the Codex provider is gone but a [codex] section still loads") callback {
            e = env.new()
            env.set(e, "NIB_CODEX_TRANSPORT", "bogus")
            env.set(e, "NIB_CODEX_RUN_TOOL", "bogus")
            spec.assert_str_eq(err_(e, ""), "", "codex variables are ignored")
            spec.assert_eq(types.known_id("codex"), 0, "codex is not an id")
            expect_parse_error_("[codex]\ntransport = \"tcp\"\n", 2, "transport must be websocket or sse")
            expect_parse_error_("[codex]\nrun_tool = \"x\"\n", 2, "run_tool must be custom or function")
            expect_parse_error_("[codex]\nprotocol = \"responses\"\n", 2, "unknown provider key 'protocol'")
            e2 = env.new()
            env.set(e2, "NIB_PROVIDER", "openai")
            env.set(e2, "OPENAI_API_KEY", "k")
            cfg, rerr, rdetail = config.resolve(e2, "[codex]\nmodel = \"gpt-6.1-sol\"\ntransport = \"sse\"\nreasoning_summary = \"auto\"\nrun_tool = \"function\"\n", "/c.toml")
            spec.assert_str_eq(rerr, "", "a [codex] section loads: ${rdetail}")
            spec.assert_str_eq(types.name(cfg), "openai", "and is ignored")
        }
        spec.it("home joins HOME and .nib and rejects nothing else") callback {
            e = env.new()
            env.set(e, "HOME", "/h/")
            h, err = config.home(e)
            spec.assert_true(err == "" && h == "/h/.nib", "trailing slash joins once: ${h}")
        }
        spec.it("env.pairs gives a child's environment as NAME=value strings") callback {
            e = env.new()
            env.set(e, "PATH", "/a:/b")
            env.set(e, "EMPTY", "")
            env.set(e, "EQ", "x=y")
            ps = env.pairs(e)
            spec.assert_eq(list.list_size(ps), 3, "three")
            p0, _g0 = list.get_string(ps, 0)
            p1, _g1 = list.get_string(ps, 1)
            p2, _g2 = list.get_string(ps, 2)
            spec.assert_str_eq(p0, "PATH=/a:/b", "path")
            spec.assert_str_eq(p1, "EMPTY=", "empty kept")
            spec.assert_str_eq(p2, "EQ=x=y", "value with =")
        }
        spec.it("environment variables beat the file for every setting they cover") callback {
            e = env.new()
            env.set(e, "NIB_PROVIDER", "openai")
            env.set(e, "OPENAI_API_KEY", "k1")
            text = "provider = \"anthropic\"\n[openai]\nmodel = \"gpt-6.1-terra\"\nbase_url = \"http://file\"\ncontext_window = 77\n"
            cp = ok_(e, text)
            spec.assert_str_eq(cfg_(cp).provider, "openai", "env provider")
            spec.assert_str_eq(cfg_(cp).model, "gpt-6.1-terra", "file model under env provider")
            spec.assert_str_eq(cfg_(cp).base_url, "http://file", "file url")
            spec.assert_eq(cfg_(cp).context_window as int, 77, "file window")
            env.set(e, "NIB_MODEL", "gpt-6.1-sol")
            env.set(e, "NIB_BASE_URL", "http://env")
            env.set(e, "NIB_CONTEXT_WINDOW", "88")
            cp = ok_(e, text)
            spec.assert_true(cfg_(cp).model == "gpt-6.1-sol" && cfg_(cp).base_url == "http://env" && cfg_(cp).context_window == (88 as long), "env wins")
            spec.assert_str_eq(cfg_(cp).api_key, "k1", "key")
            spec.assert_str_eq(cfg_(cp).api_key_env, "OPENAI_API_KEY", "key variable")
            spec.assert_eq(types.missing_key(cp), 0, "has a key")
        }
    }
    return spec.run_summary(fw)
}
