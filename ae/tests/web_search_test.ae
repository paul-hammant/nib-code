// Ports the inline tests of upstream src/tools/web_search.zig under their
// names, then drives search() over real HTTP against ae/tests/mock_search_http.py
// (python3 on PATH; the fixtures of tests/mock_providers.py's serve_search) so
// request bodies, headers, URL paths, status and failure texts are checked as
// tests/test_web_search.py's mock expects them. Never a real provider.
//
// Left out: none of upstream's inline tests (none is Codex-only). Not ported:
// the Codex route (policy), so test_web_search.py's test_codex has no
// counterpart; `codex` is no provider here.
import std.spec
import std.string
import std.list
import std.fs
import std.os
import std.sync
import std.time
import nib.jsonx
import nib.provider.types
import nib.tools.web_search

expect_json_(expected: string, o: ptr, label: string) {
    spec.assert_str_eq(web_search.outcome_json(o, 0), expected, label)
}

failure_of_(o: ptr) -> string { return (o as *web_search.Outcome).failure }

n_results_(o: ptr) -> int { return list.list_size((o as *web_search.Outcome).results) }

cfg_(provider_id: string, base: string, key: string) -> ptr {
    return types.new_config(provider_id, base, key, "m")
}

tmp_() -> string {
    d, _e = fs.make_temp_dir("", "nib-ws")
    real, _k, _m = fs.realpath(d)
    return real
}

wait_file_(path: string) -> string {
    i = 0
    while i < 300 {
        if fs.exists(path) == 1 {
            text, e = fs.read(path)
            if e == "" && string.length(text) > 0 { return text }
        }
        sleep(50)
        i = i + 1
    }
    return ""
}

// Starts the mock; (url, recfile, token for os.kill).
start_(dir: string) -> (string, string, int) {
    urlfile = "${dir}/url"
    rec = "${dir}/requests.jsonl"
    argv = list.list_new()
    list.list_add(argv, "${os.getcwd()}/ae/tests/mock_search_http.py")
    list.list_add(argv, urlfile)
    list.list_add(argv, rec)
    token, err = os.spawn_proc_to("python3", argv, null, "${dir}/http.out")
    if err != "" { return "", rec, -1 }
    return wait_file_(urlfile), rec, token
}

stop_(token: int) {
    os.kill(0 - token, 9)
    os.wait(token)
}

// The recorded request n (0-based): its parsed document.
request_(rec: string, n: int) -> ptr {
    text, _e = fs.read(rec)
    rest = text
    i = 0
    while i < n {
        nl = string.index_of(rest, "\n")
        rest = string.substring(rest, nl + 1, string.length(rest))
        i = i + 1
    }
    nl2 = string.index_of(rest, "\n")
    return jsonx.parse(string.substring(rest, 0, nl2))
}

hdr_(req: ptr, name: string) -> string { return jsonx.str_or(jsonx.field(req, "headers"), name, "<none>") }

main() {
    fw = spec.init()
    spec.describe(fw, "tools.web_search") {
        spec.it("responses stream: cited results first, deduped, capped, sources kept") callback {
            body = "data: {\"type\":\"response.created\"}\n\ndata: {\"type\":\"response.output_item.done\",\"item\":{\"type\":\"web_search_call\",\"action\":{\"type\":\"search\",\"sources\":[{\"type\":\"url\",\"url\":\"https://a.dev/1\"},{\"type\":\"url\",\"url\":\"https://b.dev/2\"},{\"type\":\"url\",\"url\":\"https://c.dev/3\"}]}}}\n\ndata: {\"type\":\"response.output_item.done\",\"item\":{\"type\":\"message\",\"content\":[{\"type\":\"output_text\",\"text\":\"Answer.\",\"annotations\":[{\"type\":\"url_citation\",\"url\":\"https://b.dev/2\",\"title\":\"B\"},{\"type\":\"file_citation\"}]}]}}\n\ndata: [DONE]\n\n"
            expect_json_("{\"answer\":\"Answer.\",\"results\":[{\"title\":\"B\",\"url\":\"https://b.dev/2\",\"summary\":\"\"},{\"title\":\"https://a.dev/1\",\"url\":\"https://a.dev/1\",\"summary\":\"\"}]}", web_search.parse_responses(body, 2), "capped at two, cited first")
            spec.assert_eq(n_results_(web_search.parse_responses(body, 10)), 3, "all three")
        }
        spec.it("responses stream without web_search_call is a failure") callback {
            body = "data: {\"type\":\"response.output_item.done\",\"item\":{\"type\":\"message\",\"content\":[{\"type\":\"output_text\",\"text\":\"guess\"}]}}\n\n"
            spec.assert_str_eq(failure_of_(web_search.parse_responses(body, 10)), "model answered without searching", "no search")
        }
        spec.it("responses stream failure carries the upstream message") callback {
            o = web_search.parse_responses("data: {\"type\":\"response.failed\",\"response\":{\"error\":{\"message\":\"quota\"}}}\n\n", 10)
            spec.assert_str_eq(failure_of_(o), "quota", "message")
        }
        spec.it("anthropic message: results, citations, dates") callback {
            body = "{\"content\":[{\"type\":\"server_tool_use\",\"name\":\"web_search\",\"input\":{\"query\":\"q\"}},\n{\"type\":\"web_search_tool_result\",\"content\":[{\"type\":\"web_search_result\",\"url\":\"https://a.dev\",\"title\":\"A\",\"page_age\":\"May 1, 2026\"},{\"type\":\"web_search_result\",\"url\":\"https://b.dev\",\"title\":\"B\",\"page_age\":null}]},\n{\"type\":\"text\",\"text\":\"Found.\",\"citations\":[{\"type\":\"web_search_result_location\",\"url\":\"https://b.dev\",\"title\":\"B\",\"cited_text\":\"quote\"}]}]}"
            expect_json_("{\"answer\":\"Found.\",\"results\":[{\"title\":\"B\",\"url\":\"https://b.dev\",\"summary\":\"quote\"},{\"title\":\"A\",\"url\":\"https://a.dev\",\"date\":\"May 1, 2026\",\"summary\":\"\"}]}", web_search.parse_anthropic(body, 10), "anthropic")
        }
        spec.it("anthropic without a search or with a tool error fails") callback {
            spec.assert_str_eq(failure_of_(web_search.parse_anthropic("{\"content\":[{\"type\":\"text\",\"text\":\"x\"}]}", 10)), "model answered without searching", "no search")
            failed = web_search.parse_anthropic("{\"content\":[{\"type\":\"web_search_tool_result\",\"content\":{\"type\":\"web_search_tool_result_error\",\"error_code\":\"max_uses_exceeded\"}}]}", 10)
            spec.assert_str_eq(failure_of_(failed), "web search failed: max_uses_exceeded", "tool error")
        }
        spec.it("deepseek results use summary, fall back to snippet and tolerate null date") callback {
            body = "{\"results\":[{\"title\":\"A\",\"url\":\"https://a.dev\",\"snippet\":\"s\",\"summary\":\"sum\",\"date\":\"2026-01-02\"},{\"title\":\"B\",\"url\":\"https://b.dev\",\"snippet\":\"only snippet\",\"summary\":null,\"date\":null},{\"title\":\"C\",\"url\":\"https://c.dev\",\"summary\":\"x\"}]}"
            expect_json_("{\"results\":[{\"title\":\"A\",\"url\":\"https://a.dev\",\"date\":\"2026-01-02\",\"summary\":\"sum\"},{\"title\":\"B\",\"url\":\"https://b.dev\",\"summary\":\"only snippet\"}]}", web_search.parse_deepseek(body, 2), "deepseek")
        }
        spec.it("search validates arguments and provider before any request") callback {
            cfg = cfg_("chat_completions", "http://127.0.0.1:1", "k")
            bad = list.list_new()
            list.list_add(bad, "{}")
            list.list_add(bad, "{\"query\":\"\"}")
            list.list_add(bad, "{\"query\":\"x\",\"count\":0}")
            list.list_add(bad, "{\"query\":\"x\",\"count\":51}")
            list.list_add(bad, "{\"query\":1}")
            i = 0
            while i < list.list_size(bad) {
                a, _e = list.get_string(bad, i)
                ok, _t = web_search.search(cfg, a, null)
                spec.assert_eq(ok, 0, "rejected ${a}")
                i = i + 1
            }
            ok2, t2 = web_search.search(cfg, "{\"query\":\"x\"}", null)
            spec.assert_eq(ok2, 1, "unsupported is data")
            spec.assert_str_eq(t2, "{\"ok\":false,\"error\":\"web search is not available for provider chat_completions\"}", "unsupported")
            (cfg as *types.Config).provider = "deepseek"
            q = ""
            j = 0
            while j < 129 {
                q = "${q}中"
                j = j + 1
            }
            ok3, t3 = web_search.search(cfg, "{\"query\":\"${q}\"}", null)
            spec.assert_eq(ok3, 0, "129 characters rejected")
            spec.assert_str_eq(t3, "query is 129 characters; DeepSeek search accepts at most 128", "text counts code points")
            q2 = string.substring(q, 0, 128 * 3)
            spec.assert_eq(web_search.codepoints(q2), 128, "128 code points")
            spec.assert_eq(web_search.codepoints("\xff"), -1, "invalid UTF-8")
        }
    }
    spec.describe(fw, "tools.web_search over a local mock") {
        spec.it("openai: Responses request, SSE reply, nosearch and bad arguments") callback {
            dir = tmp_()
            url, rec, tok = start_(dir)
            spec.assert_true(string.length(url) > 0, "mock started")
            cfg = cfg_("openai", "${url}/", "sk-mock")
            ok, t = web_search.search(cfg, "{\"query\":\"zig\",\"count\":2}", null)
            spec.assert_eq(ok, 1, "ok")
            spec.assert_str_eq(t, "{\"ok\":true,\"answer\":\"answer for zig\",\"results\":[{\"title\":\"B page\",\"url\":\"https://b.dev/2\",\"summary\":\"\"},{\"title\":\"https://a.dev/1\",\"url\":\"https://a.dev/1\",\"summary\":\"\"}]}", "result")
            ok2, t2 = web_search.search(cfg, "{\"query\":\"nosearch\"}", null)
            spec.assert_str_eq(t2, "{\"ok\":false,\"error\":\"model answered without searching\"}", "unsearched")
            r = request_(rec, 0)
            spec.assert_str_eq(jsonx.str_or(r, "path", ""), "/responses", "path")
            spec.assert_str_eq(hdr_(r, "authorization"), "Bearer sk-mock", "authorization")
            spec.assert_str_eq(hdr_(r, "accept"), "text/event-stream", "accept")
            spec.assert_str_eq(hdr_(r, "content-type"), "application/json", "content type")
            b = jsonx.field(r, "body")
            spec.assert_str_eq(jsonx.str_or(b, "model", ""), "gpt-6-luna", "model")
            spec.assert_str_eq(jsonx.encode(jsonx.field(b, "tools")), "[{\"type\":\"web_search\",\"search_context_size\":\"high\"}]", "tools")
            spec.assert_str_eq(jsonx.str_or(b, "tool_choice", ""), "required", "tool_choice")
            spec.assert_eq(jsonx.bool_or(b, "store", 1), 0, "store false")
            spec.assert_eq(jsonx.bool_or(b, "stream", 0), 1, "stream true")
            spec.assert_str_eq(jsonx.encode(jsonx.field(b, "include")), "[\"web_search_call.action.sources\"]", "include")
            spec.assert_str_eq(jsonx.encode(jsonx.field(b, "input")), "[{\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":\"zig\"}]}]", "input")
            stop_(tok)
        }
        spec.it("anthropic: Messages request and JSON reply") callback {
            dir = tmp_()
            url, rec, tok = start_(dir)
            cfg = cfg_("anthropic", url, "ak-mock")
            ok, t = web_search.search(cfg, "{\"query\":\"zig\",\"count\":2}", null)
            spec.assert_str_eq(t, "{\"ok\":true,\"answer\":\"answer for zig\",\"results\":[{\"title\":\"B page\",\"url\":\"https://b.dev/2\",\"summary\":\"quote\"},{\"title\":\"A page\",\"url\":\"https://a.dev/1\",\"date\":\"May 1, 2026\",\"summary\":\"\"}]}", "result")
            r = request_(rec, 0)
            spec.assert_str_eq(jsonx.str_or(r, "path", ""), "/v1/messages", "path")
            spec.assert_str_eq(hdr_(r, "x-api-key"), "ak-mock", "x-api-key")
            spec.assert_str_eq(hdr_(r, "anthropic-version"), "2023-06-01", "version")
            spec.assert_str_eq(hdr_(r, "authorization"), "<none>", "no authorization")
            b = jsonx.field(r, "body")
            spec.assert_str_eq(jsonx.str_or(b, "model", ""), "claude-haiku-5-5", "model")
            spec.assert_str_eq(jsonx.encode(jsonx.field(b, "messages")), "[{\"role\":\"user\",\"content\":\"zig\"}]", "messages")
            spec.assert_str_eq(jsonx.encode(jsonx.field(b, "tools")), "[{\"type\":\"web_search_20250305\",\"name\":\"web_search\",\"max_uses\":5}]", "tools")
            spec.assert_eq(jsonx.int_or(b, "max_tokens", 0), 4096, "max_tokens")
            stop_(tok)
        }
        spec.it("deepseek: search request, JSON reply, count passed") callback {
            dir = tmp_()
            url, rec, tok = start_(dir)
            cfg = cfg_("deepseek", url, "dk-mock")
            ok, t = web_search.search(cfg, "{\"query\":\"zig\",\"count\":2}", null)
            spec.assert_str_eq(t, "{\"ok\":true,\"results\":[{\"title\":\"A page\",\"url\":\"https://a.dev/1\",\"summary\":\"sum\"},{\"title\":\"B page\",\"url\":\"https://b.dev/2\",\"date\":\"2026-01-02\",\"summary\":\"only snippet\"}]}", "result")
            r = request_(rec, 0)
            spec.assert_str_eq(jsonx.str_or(r, "path", ""), "/v1/tools/search", "path")
            spec.assert_str_eq(hdr_(r, "authorization"), "Bearer dk-mock", "authorization")
            spec.assert_str_eq(jsonx.encode(jsonx.field(r, "body")), "{\"query\":\"zig\",\"count\":2}", "body")
            stop_(tok)
        }
        spec.it("a non-2xx status is a failure with the clipped body") callback {
            dir = tmp_()
            url, rec, tok = start_(dir)
            ok, t = web_search.search(cfg_("deepseek", url, "k"), "{\"query\":\"http500\"}", null)
            spec.assert_eq(ok, 1, "data")
            spec.assert_str_eq(t, "{\"ok\":false,\"error\":\"HTTP 500: {\\\"error\\\":\\\"boom\\\"}\"}", "HTTP 500")
            stop_(tok)
        }
        spec.it("timeout and cancel stop a slow request") callback {
            dir = tmp_()
            url, rec, tok = start_(dir)
            cfg = cfg_("deepseek", url, "k")
            ok, t = web_search.search_with(cfg, "{\"query\":\"slow\"}", null, 300)
            spec.assert_eq(ok, 1, "timeout is data")
            spec.assert_str_eq(t, "{\"ok\":false,\"error\":\"timed out after 300 ms\"}", "timeout text")
            cancel = sync.atomic_new(1)
            t0 = time.now_ms()
            ok2, t2 = web_search.search(cfg, "{\"query\":\"slow\"}", cancel)
            spec.assert_eq(ok2, 0, "cancel rejects")
            spec.assert_str_eq(t2, "canceled", "canceled")
            spec.assert_true(time.now_ms() - t0 < 1500 as long, "cancel is prompt")
            stop_(tok)
        }
        spec.it("a refused connection is a failure, not a rejection") callback {
            ok, t = web_search.search(cfg_("deepseek", "http://127.0.0.1:1", "k"), "{\"query\":\"x\"}", null)
            spec.assert_eq(ok, 1, "data")
            spec.assert_true(string.starts_with(t, "{\"ok\":false,\"error\":\"") == 1, "ok:false: ${t}")
        }
    }
    return spec.run_summary(fw)
}
